        [{"text": "Доска", "callback_data": "c:board"}, {"text": "Черновики", "callback_data": "c:drafts"}],
        [{"text": "Автоном ▶", "callback_data": "c:go"}, {"text": "Пауза", "callback_data": "c:pause"}],
    ]


