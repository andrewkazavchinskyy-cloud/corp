def tg_needs_confirm(name: str) -> bool:
    return name in {"council", "abort", "go"}


def tg_confirm_text(kind: str, ref: str = "") -> str:
    if kind == "council":
        return tg_screen(
            "Цикл",
            [
                "Команда QA, PM и Дизайн заведёт карточки.",
                "После проверки может влить в main.",
            ],
            "подтверди запуск или отмени.",
        )
    if kind == "go":
        return tg_screen("Автоном", ["Очередь снова возьмёт карточки."], "подтверди или отмени.")
    if kind == "abort":
        return tg_screen(
            "Откатить",
            [ref, "Карточка вернётся в Готово. Агент этой карточки остановится."],
            "подтверди или отмени.",
        )
    if kind == "cycle_stop":
        return tg_screen("Цикл", ["Команда QA, PM и Дизайн прекратит работу."], "подтверди или отмени.")
    return tg_screen("Точно?", [], "подтверди или отмени.")


def tg_web_app_url() -> str:
    base = workshop_public_url()
    if not base:
        return ""
    host = base.split("://", 1)[-1]
    if ".ts.net" not in host:
        return ""
    return f"{base}/tg"


def tg_menu_button_payload(url: str = "") -> dict:
    dest = (url or "").strip()
    if dest.startswith("https://") and ".ts.net" in dest:
        return {"type": "web_app", "text": "Меню", "web_app": {"url": dest}}
    return {"type": "commands"}


_TG_LOG_T = {"t": 0.0}


def _tg_degrade(reason: str) -> None:
    now = time.time()
    if now - _TG_LOG_T["t"] < 300:
        return
    _TG_LOG_T["t"] = now
    append_log(f"telegram: {reason}\n")
    try:
        record_event("tg_fail", "bot", tg_clip(redact_secrets(reason), 160))
    except Exception:
        pass


def telegram_tick(long_poll: bool = False) -> None:
    token, chat = tg_creds()
    if not token or not chat:
        return
    import urllib.request

    offset = int(load_workshop().get("tg_offset") or 0)
    wait = TG_LONG_POLL if long_poll else 0
    url = f"https://api.telegram.org/bot{token}/getUpdates?timeout={wait}&offset={offset}"
    try:
        raw = urllib.request.urlopen(url, timeout=wait + 10).read()
    except Exception as exc:
        _tg_degrade(f"getUpdates failed: {exc}")
        return
    try:
        payload = json.loads(raw.decode() or "{}")
    except ValueError as exc:
        _tg_degrade(f"getUpdates bad payload: {exc}")
        return
    if payload.get("ok") is False:
        _tg_degrade(f"getUpdates nok: {str(payload.get('description') or '')[:140]}")
        return
    new_offset = offset
    for upd in payload.get("result") or []:
        new_offset = int(upd.get("update_id") or 0) + 1
        cb = upd.get("callback_query") or {}
        msg = upd.get("message") or upd.get("edited_message") or {}
        try:
            if cb:
                if cb.get("id"):
                    try:
                        tg_post("answerCallbackQuery", {"callback_query_id": cb["id"]})
                    except (CorpError, SystemExit):
                        pass
                msg_chat = str(((cb.get("message") or {}).get("chat") or {}).get("id") or "")
                if msg_chat == str(chat):
                    try:
                        handle_tg_callback(cb.get("data") or "")
                    except CorpError as exc:
                        tg_send(tg_err(exc))
                continue
            msg_chat = str((msg.get("chat") or {}).get("id") or "")
            if msg_chat != str(chat):
                continue
            text = (msg.get("text") or "").strip()
            if not text:
                continue
            try:
                pending = tg_pending_reply()
                name, _arg = tg_parse_command(text)
                if pending.get("kind") and not name:
                    handle_tg_reply(pending, text)
                else:
                    if pending.get("kind") and name:
                        tg_set_pending(None)
                    handle_tg_text(text)
            except CorpError as exc:
                tg_send(tg_err(exc))
        except Exception as exc:
            append_log(
                f"telegram update {upd.get('update_id')}: {type(exc).__name__}: "
                f"{redact_secrets(str(exc))[:200]}\n"
            )
    if new_offset != offset:
        try:
            set_tg_offset(new_offset)
        except OSError as exc:
            append_log(f"telegram offset save failed: {exc}\n")


def telegram_loop() -> None:
    try:
        tg_post("deleteWebhook", {})
    except (CorpError, SystemExit):
        pass
    while True:
        try:
            telegram_tick(long_poll=True)
        except Exception as exc:
            append_log(f"telegram: {exc}\n")
            time.sleep(1)


def tg_menu_buttons() -> list:
    return tg_home_buttons()


def tg_reply_keyboard() -> list:
    return [
        [{"text": "Сейчас"}, {"text": "Доска"}],
        [{"text": "Цикл"}, {"text": "Ещё"}],
    ]


def tg_install_commands() -> None:
    cmds = tg_command_menu()
    try:
        tg_post("setMyCommands", {"commands": json.dumps(cmds)})
    except (CorpError, SystemExit):
        pass
    tg_install_menu_button()


def tg_install_menu_button() -> str:
    payload = tg_menu_button_payload(tg_web_app_url())
    try:
        tg_post("setChatMenuButton", {"menu_button": json.dumps(payload)})
        return payload.get("type") or "commands"
    except (CorpError, SystemExit):
        if payload.get("type") == "web_app":
            try:
                tg_post("setChatMenuButton", {"menu_button": json.dumps({"type": "commands"})})
            except (CorpError, SystemExit):
                pass
        return "commands"


def tg_norm_slash(name: str) -> str:
    raw = (name or "").lower()
    aliases = {
        "start": "start",
        "menu": "start",
        "сейчас": "now",
        "status": "now",
        "queue": "now",
        "running": "now",
        "agents": "now",
        "doctor": "now",
        "доска": "board",
        "board": "board",
        "цикл": "council",
        "improve": "council",
        "council": "council",
        "пауза": "pause",
        "pause": "pause",
        "помощь": "help",
        "help": "help",
        "ещё": "more",
        "еще": "more",
        "go": "go",
        "abort": "abort",
        "retry": "retry",
        "drafts": "more",
    }
    return aliases.get(raw, raw)


def tg_parse_command(text: str) -> tuple[str, str]:
    line = (text or "").strip()
    if not line:
        return "", ""
    if line.startswith("/"):
        parts = line[1:].split(maxsplit=1)
        name = tg_norm_slash(parts[0].split("@")[0] or "")
        return name, parts[1] if len(parts) > 1 else ""
    aliases = {
        "меню": "start",
        "сейчас": "now",
        "статус": "now",
        "очередь": "now",
        "бежит": "now",
        "агенты": "now",
        "сервер": "now",
        "доктор": "now",
        "доска": "board",
        "черновики": "more",
        "ещё": "more",
        "еще": "more",
        "старт": "go",
        "автоном": "go",
        "автоном ▶": "go",
        "пауза": "pause",
        "помощь": "help",
        "цикл": "council",
        "improve": "council",
        "команда": "council",
    }
    low = line.lower()
    if low in aliases:
        return aliases[low], ""
    for prefix, name in (
        ("retry ", "retry"),
        ("/retry ", "retry"),
        ("перезапуск ", "retry"),
        ("abort ", "abort"),
        ("откатить ", "abort"),
    ):
        if low.startswith(prefix):
            return name, line[len(prefix):].strip()
    return "", ""


def tg_parse_issue_arg(raw: str) -> tuple[str, int]:
    text = (raw or "").strip()
    if not text:
        die("укажи #n или owner/repo#n")
    if text.startswith("#") and text[1:].isdigit():
        return f"{org_name(load_registry())}/corp", int(text[1:])
    if text.isdigit():
        return f"{org_name(load_registry())}/corp", int(text)
    if "#" in text and "/" not in text:
        name, number = text.split("#", 1)
        if number.isdigit():
            project = project_by_name(load_registry(), name)
            if project.get("repo"):
                return project["repo"], int(number)
    return parse_issue_ref(text)


def tg_live_names(reg: dict) -> list[str]:
    live = []
    for project in pinned_projects(reg):
        if tmux_alive(project["name"]):
            live.append(project["name"])
        if orch_alive(project["name"]):
            live.append(f"orch:{project['name']}")
    return live


def tg_last_queue_error(data: dict | None = None) -> str:
    queue = (data or load_workshop()).get("queue") or []
    for item in queue:
        err = (item.get("last_error") or "").strip()
        if err and item.get("status") in {"failed", "waiting", "running"}:
            return err
    return ""


def tg_retryable_item(data: dict | None = None) -> dict | None:
    queue = (data or load_workshop()).get("queue") or []
    for item in queue:
        err = (item.get("last_error") or "").strip()
        if item.get("status") == "failed" or (item.get("status") == "waiting" and err):
            return item
    return None


def tg_council_line(data: dict | None = None) -> str:
    row = (data or load_workshop()).get("council") or {}
    if council_busy(data or load_workshop()):
        return tg_council_phase_ru(row.get("status") or "analyze")
    status = row.get("status") or ""
    if status in {"main", "fail", "aborted"}:
        return tg_council_phase_ru(status)
    return "не идёт"


def tg_now_buttons(data: dict | None = None) -> list:
    data = data or load_workshop()
    rows = []
    shop = tg_shop_url()
    row = []
    if shop:
        row.append({"text": "Мастерская", "url": shop})
    item = tg_retryable_item(data)
    if item:
        key = issue_ref(item["repo"], item["issue"])
        row.append({"text": "Повторить", "callback_data": f"q:{key}"})
    if row:
        rows.append(row[:4])
    return rows


def tg_cmd_start(arg: str = "") -> None:
    dest = (arg or "").strip().lower()
    routes = {
        "now": tg_cmd_now,
        "сейчас": tg_cmd_now,
        "status": tg_cmd_now,
        "board": tg_cmd_board,
        "доска": tg_cmd_board,
        "cycle": tg_cmd_council,
        "цикл": tg_cmd_council,
        "council": tg_cmd_council,
        "more": tg_cmd_more,
        "ещё": tg_cmd_more,
        "еще": tg_cmd_more,
        "help": tg_cmd_help,
    }
    handler = routes.get(dest)
    if handler:
        handler("")
        return
    text, keyboard = tg_home_payload()
    tg_send(text, keyboard=keyboard)


def tg_cmd_help(_arg: str = "") -> None:
    tg_send(tg_help_text())


def tg_cmd_now(_arg: str = "") -> None:
    tg_upsert_status(keep_card=True)


def tg_cmd_status(arg: str = "") -> None:
    tg_cmd_now(arg)


def tg_cmd_queue(arg: str = "") -> None:
    tg_cmd_now(arg)


def tg_cmd_running(arg: str = "") -> None:
    tg_cmd_now(arg)


def tg_host_lines() -> list[str]:
    data = load_workshop()
    return tg_server_text(
        load=os.getloadavg()[0],
        disk_free_gb=shutil.disk_usage("/").free / 1024**3,
        workshop_up=tg_workshop_up(),
        queue_on=bool(data.get("queue_running")),
    ).splitlines()


def tg_cmd_doctor(arg: str = "") -> None:
    tg_cmd_now(arg)


def tg_cmd_board(_arg: str = "") -> None:
    tg_upsert_board(project="", page=1, reset_open=True)


def tg_cmd_drafts(_arg: str = "") -> None:
    tg_cmd_more("")


def tg_cmd_more(_arg: str = "") -> None:
    tg_upsert_more()


def tg_cmd_go(_arg: str = "") -> None:
    tg_upsert_html("tg_more", tg_confirm_text("go"), tg_confirm_buttons("!g"))


def tg_cmd_go_yes(_arg: str = "") -> None:
    queue_set_running(True)
    tg_send(tg_screen("Автоном", ["Очередь снова берёт карточки."], "открой доску или Сейчас."))


def tg_cmd_pause(_arg: str = "") -> None:
    queue_set_running(False)


def tg_cmd_retry(arg: str) -> None:
    repo, number = tg_parse_issue_arg(arg)
    queue_retry(repo, number)
    tg_notify_event("retry", tg_short_ref(repo, number), "снова в очереди", action_ref=issue_ref(repo, number))


def tg_cmd_abort(arg: str) -> None:
    if not (arg or "").strip():
        if council_busy():
            tg_show_cycle(tg_confirm_text("cycle_stop"), tg_confirm_buttons("!c"))
            return
        item = tg_retryable_item() or next(
            (row for row in (load_workshop().get("queue") or []) if row.get("status") in {"waiting", "running", "failed"}),
            None,
        )
        if not item:
            tg_send(tg_screen("Откатить", ["Нечего откатывать."], "открой доску."))
            return
        arg = issue_ref(item["repo"], item["issue"])
    repo, number = tg_parse_issue_arg(arg)
    ref = tg_short_ref(repo, number)
    tg_upsert_html("tg_more", tg_confirm_text("abort", ref), tg_confirm_buttons(f"!k:{issue_ref(repo, number)}"))


def tg_do_abort(repo: str, number: int) -> None:
    result = queue_abort(repo, number)
    ref = tg_short_ref(repo, number)
    if not result.get("aborted"):
        tg_send(tg_screen("Откатить", [f"{ref} не в очереди."], "открой доску."))
        return
    tg_send(tg_screen("Откатить", [f"{ref} вернул в Готово."], "открой доску или Сейчас."))


def tg_cmd_council(arg: str = "") -> None:
    data = load_workshop()
    if council_busy(data):
        tg_show_cycle(tg_council_text(data.get("council") or {}), tg_cycle_buttons(data))
        return
    tg_show_cycle(tg_confirm_text("council"), tg_confirm_buttons("!y"))


def tg_cmd_council_yes(arg: str = "") -> None:
    council_start(load_registry(), arg)


def tg_ask_qa_note(repo: str, number: int) -> None:
    tg_set_pending({"kind": "qaf", "repo": repo, "number": number})
    tg_send(
        tg_screen(
            "QA не принял",
            [tg_short_ref(repo, number), "Напиши, что поправить. Это уйдёт в карточку."],
            "ответь на это сообщение.",
        ),
        force_reply=True,
    )


def handle_tg_reply(pending: dict, text: str) -> None:
    kind = pending.get("kind") or ""
    repo = pending.get("repo") or ""
    number = int(pending.get("number") or 0)
    tg_set_pending(None)
    if kind == "qaf" and repo and number:
        note = redact_secrets((text or "").strip())
        if not note:
            tg_ask_qa_note(repo, number)
            return
        board_click(load_registry(), "qa_fail", repo, number, "", note)
        tg_send(tg_screen("QA", [f"{tg_short_ref(repo, number)} вернул в Готово с правками."], "открой доску."))
        return
    handle_tg_text(text)


def local_board_card(repo: str, number: int) -> dict | None:
    data = load_workshop()
    snap = data.get("board_snap") or {}
    raw = _find_snap_card(snap.get("cards") or [], repo, number)
    if raw is None:
        return None
    return _paint_card(raw, (data.get("board_ov") or {}).get(board_key(repo, number)) or {})


def tg_issue_in_qa(repo: str, number: int) -> bool:
    card = local_board_card(repo, number)
    return bool(card and _card_waiting_qa(card))


TG_HANDLERS = {
    "start": tg_cmd_start,
    "help": tg_cmd_help,
    "menu": tg_cmd_start,
    "now": tg_cmd_now,
    "status": tg_cmd_now,
    "queue": tg_cmd_now,
    "running": tg_cmd_now,
    "agents": tg_cmd_now,
    "doctor": tg_cmd_now,
    "board": tg_cmd_board,
    "more": tg_cmd_more,
    "drafts": tg_cmd_more,
    "go": tg_cmd_go,
    "pause": tg_cmd_pause,
    "retry": tg_cmd_retry,
    "abort": tg_cmd_abort,
    "council": tg_cmd_council,
    "цикл": tg_cmd_council,
    "improve": tg_cmd_council,
}


def handle_tg_text(text: str) -> None:
    name, arg = tg_parse_command(text)
    handler = TG_HANDLERS.get(name)
    if handler is None:
        tg_send(tg_screen("Не понял", ["Это не команда."], "нажми одно внизу."), buttons=tg_home_buttons())
        return
    handler(arg)


def handle_tg_callback(code: str) -> None:
    raw = (code or "").strip()
    if raw in {"h:0", "h:home"}:
        tg_cmd_start("")
        return
    if raw == "h:n":
        tg_cmd_now("")
        return
    if raw == "h:b":
        tg_cmd_board("")
        return
    if raw == "h:y":
        tg_cmd_council("")
        return
    if raw == "h:e":
        tg_cmd_more("")
        return
    if raw == "h:p":
        tg_cmd_help("")
        return
    if raw.startswith("b:f:"):
        tg_upsert_board(project=raw[4:], page=1, reset_open=True)
        return
    if raw.startswith("b:p:"):
        try:
            page = int(raw[4:])
        except ValueError:
            page = 1
        tg_upsert_board(page=page, reset_open=True)
        return
    if raw.startswith("b:o:"):
        tg_upsert_board(open_ref=raw[4:])
        return
    if raw == "b:b":
        tg_upsert_board(reset_open=True)
        return
    if raw == "?g":
        tg_cmd_go("")
        return
    if raw == "!g":
        tg_cmd_go_yes("")
        return
    if raw == "?y":
        tg_show_cycle(tg_confirm_text("council"), tg_confirm_buttons("!y"))
        return
    if raw == "!y":
        tg_cmd_council_yes("")
        return
    if raw == "?c":
        tg_show_cycle(tg_confirm_text("cycle_stop"), tg_confirm_buttons("!c"))
        return
    if raw == "!c":
        council_abort()
        tg_show_cycle(tg_screen("Цикл", ["Остановлен."], "открой доску или Сейчас."))
        return
    if raw.startswith("?k:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        tg_upsert_html(
            "tg_more",
            tg_confirm_text("abort", tg_short_ref(repo, number)),
            tg_confirm_buttons(f"!k:{issue_ref(repo, number)}"),
        )
        return
    if raw.startswith("!k:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        tg_do_abort(repo, number)
        return
    if raw.startswith("c:"):
        handle_tg_text("/" + raw[2:])
        return
    if raw.startswith("a:"):
        approve_draft(raw[2:])
        tg_send(tg_screen("Ещё", ["Черновик принят. Он станет карточкой на доске."], "открой доску."))
        return
    if raw.startswith("s:"):
        skip_draft(raw[2:])
        tg_upsert_more()
        return
    if raw.startswith("t:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        board_click(load_registry(), "take", repo, number)
        tg_send(tg_screen("Доска", [f"{tg_short_ref(repo, number)} взял себе."], "работай или верни карточку."))
        return
    if raw.startswith("d:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        board_click(load_registry(), "drop", repo, number)
        tg_send(tg_screen("Доска", [f"{tg_short_ref(repo, number)} снял с себя."], "открой доску."))
        return
    if raw.startswith("u:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        board_click(load_registry(), "queue", repo, number)
        tg_send(tg_screen("Доска", [f"{tg_short_ref(repo, number)} в очереди."], "продолжи автоном, если он на паузе."))
        return
    if raw.startswith("m:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        board_click(load_registry(), "move", repo, number, "qa")
        tg_send(tg_screen("QA", [f"{tg_short_ref(repo, number)} на QA."], "QA прошёл или QA не принял."))
        return
    if raw.startswith("qap:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        if not tg_issue_in_qa(repo, number):
            tg_send(
                tg_screen("QA", [f"{tg_short_ref(repo, number)} не в колонке QA."], "поставь её на QA, не закрывай."),
                buttons=[[{"text": "На QA", "callback_data": f"m:{issue_ref(repo, number)}"}]],
            )
            return
        board_click(load_registry(), "qa_pass", repo, number)
        tg_send(tg_screen("QA", [f"{tg_short_ref(repo, number)} закрыта. QA прошёл."], "открой доску."))
        return
    if raw.startswith("qaf:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        if not tg_issue_in_qa(repo, number):
            tg_send(tg_screen("QA", [f"{tg_short_ref(repo, number)} не в колонке QA."], "сначала поставь её на QA."))
            return
        tg_ask_qa_note(repo, number)
        return
    if raw.startswith("qa:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        key = issue_ref(repo, number)
        tg_send(
            tg_screen("QA", [f"{tg_short_ref(repo, number)} на QA."], "QA прошёл или QA не принял."),
            buttons=[[
                {"text": "QA прошёл", "callback_data": f"qap:{key}"},
                {"text": "QA не принял", "callback_data": f"qaf:{key}"},
            ]],
        )
        return
    if raw.startswith("q:") or raw.startswith("qx:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        queue_retry(repo, number)
        tg_notify_event("retry", tg_short_ref(repo, number), "снова в очереди", action_ref=issue_ref(repo, number))
        return
    if raw.startswith("x:"):
        repo, number = parse_issue_ref(raw[2:])
        queue_rm(repo, number)
        tg_notify_event("drop", tg_short_ref(repo, number), "снял")
        return
    if raw.startswith("k:") or raw.startswith("qb:"):
        repo, number = parse_issue_ref(raw.split(":", 1)[1])
        tg_upsert_html(
            "tg_more",
            tg_confirm_text("abort", tg_short_ref(repo, number)),
            tg_confirm_buttons(f"!k:{issue_ref(repo, number)}"),
        )


def parse_issue_ref(raw: str) -> tuple[str, int]:
    text = (raw or "").strip()
    if "#" not in text:
        die("use --issue owner/repo#n")
    repo, number = text.rsplit("#", 1)
    if not repo or not number.isdigit():
        die("use --issue owner/repo#n")
    return repo, int(number)


def issue_ref(repo: str, number: int) -> str:
    return f"{repo}#{number}"


def get_issue(repo: str, number: int) -> dict:
    proc = run(
        [
            "gh",
            "issue",
            "view",
            str(number),
            "-R",
            repo,
            "--json",
            "number,title,url,labels,state,updatedAt,closedAt",
        ],
        check=False,
    )
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or f"missing {repo}#{number}").strip())
    try:
        return json.loads(strip_ansi(proc.stdout or ""))
    except json.JSONDecodeError as exc:
        die(f"github view parse failed {repo}#{number}: {exc}")


def ensure_label(repo: str, name: str) -> None:
    proc = run(["gh", "label", "create", name, "-R", repo], check=False)
    if proc.returncode != 0 and "already exists" not in (proc.stderr or "").lower():
        # older gh prints different text; ignore if label is usable
        view = run(["gh", "label", "list", "-R", repo, "--json", "name"], check=False)
        names = {item.get("name") for item in json.loads(view.stdout or "[]")}
        if name not in names:
            print(f"label {name} on {repo}: {(proc.stderr or '').strip()}", file=sys.stderr)


def _gh_ok(proc: subprocess.CompletedProcess, what: str) -> None:
    if proc.returncode != 0:
        die(f"{what} failed: {(proc.stderr or proc.stdout or 'github error').strip()}")


def add_labels(repo: str, number: int, labels: list[str]) -> None:
    if not labels:
        return
    for name in labels:
        ensure_label(repo, name)
    _gh_ok(
        run(["gh", "issue", "edit", str(number), "-R", repo, "--add-label", ",".join(labels)], check=False),
        f"add labels {repo}#{number}",
    )


def remove_labels(repo: str, number: int, labels: list[str]) -> None:
    if not labels:
        return
    proc = run(["gh", "issue", "edit", str(number), "-R", repo, "--remove-label", ",".join(labels)], check=False)
    err = (proc.stderr or proc.stdout or "").lower()
    if proc.returncode != 0 and "not found" not in err and "does not exist" not in err:
        die(f"remove labels {repo}#{number} failed: {(proc.stderr or proc.stdout or '').strip()}")


def comment(repo: str, number: int, body: str) -> None:
    _gh_ok(
        run(["gh", "issue", "comment", str(number), "-R", repo, "--body", body], check=False),
        f"comment {repo}#{number}",
    )


def assign_me(repo: str, number: int) -> None:
    _gh_ok(
        run(["gh", "issue", "edit", str(number), "-R", repo, "--add-assignee", "@me"], check=False),
        f"assign {repo}#{number}",
    )


def issue_eligibility(
    reg: dict,
    repo: str,
    number: int,
    issue: dict | None = None,
    cards: list | None = None,
    allow_in_qa: bool = False,
) -> str:
    issue = issue or get_issue(repo, number)
    if (issue.get("state") or "").upper() == "CLOSED":
        return f"{repo}#{number} закрыта"
    names = label_names(issue)
    if "blocked" in names:
        return f"{repo}#{number} blocked"
    if "self" in names:
        return f"{repo}#{number} claimed as self"
    if "in-qa" in names and "qa-fail" not in names and not allow_in_qa:
        return f"{repo}#{number} на QA"
    runner = runner_of(issue)
    if column_of(issue) in {"in-progress", "qa"} and runner not in {"", "queued"}:
        return f"{repo}#{number} already claimed ({runner})"
    project = project_by_repo(reg, repo)
    if cards is not None:
        blocked = write_block_reason(cards, project["name"], number)
    else:
        blocked = pin_write_block(reg, project["name"], except_issue=number)
    if blocked:
        return blocked
    return ""


def require_eligible(
    reg: dict,
    repo: str,
    number: int,
    issue: dict | None = None,
    allow_in_qa: bool = False,
) -> dict:
    issue = issue or get_issue(repo, number)
    reason = issue_eligibility(reg, repo, number, issue, allow_in_qa=allow_in_qa)
    if reason:
        die(reason)
    return issue


def runner_of(issue: dict) -> str:
    names = label_names(issue)
    if "self" in names:
        return "self"
    for kind, label in VIA.items():
        if label in names:
            return kind
    if "queued" in names:
        return "queued"
    return ""


def column_of(issue: dict) -> str:
    state = (issue.get("state") or "OPEN").upper()
    if state == "CLOSED":
        return "done"
    names = label_names(issue)
    if "in-qa" in names and "qa-fail" not in names:
        return "qa"
    if "in-progress" in names:
        return "in-progress"
    if "ready" in names:
        return "ready"
    return "backlog"


_board_memo = {"t": 0.0, "key": "", "data": None}
_research_memo = {"t": 0.0, "key": "", "data": None}
_board_fetch_t = 0.0


def invalidate_board() -> None:
    _board_memo["t"] = 0
    _board_memo["data"] = None


def cached_research(reg: dict, cards: list | None = None) -> list[dict]:
    key = ",".join(p["name"] for p in pinned_projects(reg))
    now = time.time()
    if _research_memo["data"] is not None and _research_memo["key"] == key and now - _research_memo["t"] < 60:
        return _research_memo["data"]
    data = research_report(reg, cards)
    _research_memo.update({"t": now, "key": key, "data": data})
    return data


def _pin_issue_job(job: tuple) -> tuple:
    project, state, limit = job
    try:
        return project, state, issues_for(project["repo"], state, limit), ""
    except CorpError as exc:
        return project, state, [], str(exc)


def board_key(repo: str, number: int | str) -> str:
    return f"{repo}#{number}"


def _slim_card(card: dict) -> dict:
    return {
        "repo": card.get("repo"),
        "number": card.get("number"),
        "title": card.get("title") or "",
        "url": card.get("url") or "",
        "project": card.get("project") or "",
        "column": card.get("column") or "backlog",
        "runner": card.get("runner") or "",
        "queued": bool(card.get("queued")),
        "blocked": bool(card.get("blocked")),
        "role": card.get("role") or "build",
        "state": card.get("state") or "OPEN",
        "labels": card.get("labels") or [],
        "can_run": bool(card.get("can_run")),
        "block_reason": card.get("block_reason") or "",
    }


def _paint_card(card: dict, overlay: dict) -> dict:
    row = dict(card)
    if not overlay:
        return row
    for key in ("column", "runner", "queued", "state"):
        if key in overlay and overlay[key] is not None:
            row[key] = overlay[key]
    if overlay.get("pending"):
        row["pending"] = overlay["pending"]
    if overlay.get("error"):
        row["sync_error"] = overlay["error"]
    if row.get("runner") == "self" or row.get("column") in {"in-progress", "qa"}:
        row["can_run"] = False
    return row


def _assemble_board(reg: dict, cards: list, warning: str = "") -> dict:
    painted = []
    overlays = (load_workshop().get("board_ov") or {})
    for card in cards:
        painted.append(_paint_card(card, overlays.get(board_key(card.get("repo") or "", card.get("number") or ""))))
    for row in painted:
        if row.get("runner") == "self" or row.get("column") in {"in-progress", "qa"} or (row.get("state") or "").upper() == "CLOSED":
            row["can_run"] = False
            continue
        reason = issue_eligibility(reg, row["repo"], row["number"], row, cards=painted)
        row["block_reason"] = reason
        row["can_run"] = not reason
    painted.sort(key=lambda item: (item.get("column") or "", rank(item)))
    pins = [{"name": p["name"], "repo": p.get("repo")} for p in pinned_projects(reg)]
    key = ",".join(p["name"] for p in pins)
    projects = _research_memo["data"] if _research_memo["key"] == key and _research_memo["data"] is not None else []
    return {
        "cards": painted,
        "projects": projects,
        "pins": pins,
        "drafts": draft_summaries(reg),
        "github_warning": warning,
    }


def _github_cards(reg: dict) -> tuple[list, str]:
    cards = []
    warnings = []
    pins_on = [p for p in pinned_projects(reg) if issues_enabled(p)]
    jobs = [(p, "open", 80) for p in pins_on] + [(p, "closed", 20) for p in pins_on]
    if len(jobs) <= 1:
        fetched = [_pin_issue_job(job) for job in jobs]
    else:
        with ThreadPoolExecutor(max_workers=min(8, len(jobs))) as pool:
            fetched = list(pool.map(_pin_issue_job, jobs))
    by_pin: dict[str, dict] = {}
    for project, state, issues, err in fetched:
        row = by_pin.setdefault(project["name"], {"project": project, "open": [], "closed": [], "err": ""})
        row[state] = issues
        if err:
            row["err"] = err
    for _name, row in by_pin.items():
        project = row["project"]
        if row["err"]:
            msg = row["err"]
            if github_transient(msg):
                warnings.append(project["name"])
                continue
            raise CorpError(msg)
        seen = set()
        for issue in (row["open"] or []) + (row["closed"] or []):
            number = issue.get("number")
            if number in seen:
                continue
            seen.add(number)
            role, _slot = slot_for_issue(project["name"], issue)
            cards.append(
                _slim_card(
                    {
                        **issue,
                        "project": project["name"],
                        "repo": project["repo"],
                        "column": column_of(issue),
                        "runner": runner_of(issue),
                        "queued": "queued" in label_names(issue),
                        "blocked": "blocked" in label_names(issue),
                        "role": role,
                        "can_run": True,
                        "block_reason": "",
                    }
                )
            )
    warning = "GitHub временно не отвечает. Показываю последнее." if warnings else ""
    return cards, warning


def fetch_github_board(reg: dict) -> dict:
    global _board_fetch_t
    cache_key = ",".join(p["name"] for p in pinned_projects(reg))
    cards, warning = _github_cards(reg)
    with workshop_lock():
        data = load_workshop()
        pending = {
            key
            for key, ov in (data.get("board_ov") or {}).items()
            if (ov or {}).get("pending")
        }
        merged = []
        for card in cards:
            key = board_key(card.get("repo") or "", card.get("number") or "")
            if key in pending:
                old = next(
                    (
                        item
                        for item in (data.get("board_snap") or {}).get("cards") or []
                        if board_key(item.get("repo") or "", item.get("number") or "") == key
                    ),
                    card,
                )
                merged.append(old)
            else:
                merged.append(card)
        data["board_snap"] = {"t": time.time(), "key": cache_key, "cards": merged, "warning": warning}
        save_workshop(data)
    _board_fetch_t = time.time()
    invalidate_board()
    return board_payload(reg)


def board_payload(reg: dict) -> dict:
    cache_key = ",".join(p["name"] for p in pinned_projects(reg))
    maybe_refresh_board(reg)
    data = load_workshop()
    snap = data.get("board_snap") or {}
    if snap.get("cards") is not None and snap.get("key") == cache_key:
        payload = _assemble_board(reg, list(snap.get("cards") or []), snap.get("warning") or "")
        _board_memo.update({"t": time.time(), "key": cache_key, "data": payload})
        return payload
    if _board_memo["data"] is not None and _board_memo["key"] == cache_key:
        return _board_memo["data"]
    return fetch_github_board(reg)


def _card_waiting_qa(card: dict) -> bool:
    names = label_names(card)
    return card.get("column") == "qa" or ("in-qa" in names and "qa-fail" not in names)


def _find_snap_card(cards: list, repo: str, number: int) -> dict | None:
    for card in cards or []:
        if card.get("repo") == repo and card.get("number") == number:
            return card
    return None


def board_click(
    reg: dict,
    action: str,
    repo: str,
    number: int,
    column: str = "",
    note: str = "",
    profile: str = "",
    model: str = "",
    effort: str = "",
    fast: bool | None = None,
    kind: str = "",
) -> dict:
    payload = board_payload(reg)
    card = _find_snap_card(payload["cards"], repo, number)
    if card is None:
        die(f"{repo}#{number} нет на доске")
    fields: dict = {"pending": action, "error": ""}
    if action == "move":
        if column not in {"backlog", "ready", "in-progress", "qa", "done"}:
            die("column must be backlog|ready|in-progress|qa|done")
        if column == "ready" and _card_waiting_qa(card):
            if not (note or "").strip():
                die("нужен комментарий с правками")
            action = "qa_fail"
            fields.update({"column": "ready", "runner": "", "queued": False, "pending": "qa_fail", "note": note.strip()})
        elif column in {"done", "qa"}:
            if _card_waiting_qa(card) and column == "done":
                action = "qa_pass"
                fields.update({"column": "done", "state": "CLOSED", "runner": "", "queued": False, "pending": "qa_pass"})
            else:
                action = "to_qa"
                fields.update({"column": "qa", "runner": "", "queued": False, "pending": "to_qa"})
        else:
            fields.update({"column": column, "runner": "" if column != "in-progress" else card.get("runner") or ""})
    elif action == "take":
        if card.get("column") in {"in-progress", "qa", "done"} or (card.get("runner") or "") not in {"", "queued"}:
            die(f"{repo}#{number} already claimed ({card.get('runner') or card.get('column')})")
        reason = issue_eligibility(reg, repo, number, card, cards=payload["cards"])
        if reason:
            die(reason)
        fields.update({"column": "in-progress", "runner": "self", "queued": False})
    elif action == "drop":
        fields.update({"runner": "", "column": "ready" if card.get("column") == "in-progress" else card.get("column")})
    elif action == "qa_pass":
        if not _card_waiting_qa(card) and card.get("column") != "qa":
            die(f"{repo}#{number} не на QA")
        fields.update({"column": "done", "state": "CLOSED", "runner": "", "queued": False})
    elif action == "qa_fail":
        if not (note or "").strip():
            die("нужен комментарий с правками")
        fields.update({"column": "ready", "runner": "", "queued": False, "note": note.strip()})
    elif action == "queue":
        names = label_names(card)
        if is_sandbox_card(card):
            if "P0" in names:
                die(f"{repo}#{number} sandbox не берёт P0")
            if "self" in names:
                die(f"{repo}#{number} claimed as self")
            if "blocked" in names:
                die(f"{repo}#{number} blocked")
        reason = issue_eligibility(reg, repo, number, card, cards=payload["cards"])
        if reason and "self" in reason:
            die(reason)
        if card.get("column") in {"in-progress", "qa", "done"}:
            die(f"{repo}#{number} {card.get('column')}")
        fields.update({"queued": True, "column": "ready"})
    else:
        die(f"unknown board action: {action}")
    job = {
        "action": fields.get("pending") or action,
        "repo": repo,
        "number": number,
        "column": fields.get("column") or column,
        "note": fields.get("note") or note,
        "profile": profile,
        "model": model,
        "effort": effort,
        "fast": fast,
        "kind": kind,
    }
    with workshop_lock():
        data = load_workshop()
        snap = data.setdefault("board_snap", {"t": time.time(), "key": "", "cards": []})
        hit = _find_snap_card(snap.get("cards") or [], repo, number)
        if hit:
            hit.update({k: fields[k] for k in ("column", "runner", "queued", "state") if k in fields})
        ov = data.setdefault("board_ov", {})
        key = board_key(repo, number)
        row = dict(ov.get(key) or {})
        row.update(fields)
        row["updated"] = time.time()
        ov[key] = row
        if action == "queue":
            qkey = issue_ref(repo, number)
            existing = None
            for item in data.get("queue") or []:
                if issue_ref(item.get("repo") or "", item.get("issue")) == qkey:
                    existing = item
                    break
            if existing and existing.get("status") in {"waiting", "running"}:
                die(f"{qkey} is already queued")
            qrow = {
                "repo": repo,
                "issue": number,
                "project": card.get("project") or "",
                "title": card.get("title") or "",
                "url": card.get("url") or "",
                "profile": profile,
                "kind": kind,
                "model": model,
                "effort": effort,
                "fast": fast,
                "status": "waiting",
                "attempts": int((existing or {}).get("attempts") or 0),
                "last_error": "",
                "retry_after": 0,
            }
            if existing:
                existing.update(qrow)
            else:
                data.setdefault("queue", []).append(qrow)
        data.setdefault("board_sync", []).append(job)
        save_workshop(data)
    invalidate_board()
    painted = board_payload(reg)
    now = _find_snap_card(painted["cards"], repo, number) or card
    result = {
        "ok": True,
        "repo": repo,
        "issue": number,
        "column": now.get("column"),
        "runner": now.get("runner") or "",
        "queued": bool(now.get("queued")),
        "queue": load_workshop().get("queue") or [],
    }
    return result


def run_one_board_sync(reg: dict) -> bool:
    with workshop_lock():
        data = load_workshop()
        jobs = data.get("board_sync") or []
        if not jobs:
            return False
        job = jobs.pop(0)
        data["board_sync"] = jobs
        save_workshop(data)
    repo = job.get("repo") or ""
    number = int(job.get("number") or 0)
    action = job.get("action") or ""
    key = board_key(repo, number)
    try:
        if action == "move":
            move_issue(reg, repo, number, job.get("column") or "backlog")
        elif action == "take":
            take_issue(reg, repo, number)
        elif action == "drop":
            drop_self(repo, number)
        elif action == "qa_pass":
            close_issue(reg, repo, number, force=False, fail=False)
        elif action == "qa_fail":
            reject_qa(reg, repo, number, job.get("note") or "")
        elif action == "to_qa":
            send_to_qa(reg, repo, number, enqueue=False)
        elif action == "queue":
            add_labels(repo, number, ["ready", "queued"])
            comment(repo, number, "corp-claim: queue")
        with workshop_lock():
            data = load_workshop()
            ov = data.setdefault("board_ov", {})
            row = ov.get(key) or {}
            if row.get("pending") in {"", action}:
                ov.pop(key, None)
            elif key in ov:
                ov[key]["error"] = ""
            save_workshop(data)
    except Exception as exc:
        attempts = int(job.get("attempts") or 0) + 1
        job["attempts"] = attempts
        if github_transient(str(exc)) and attempts < 3:
            with workshop_lock():
                data = load_workshop()
                data.setdefault("board_sync", []).insert(0, job)
                save_workshop(data)
            append_log(f"board sync {key} {action}: transient ({exc}), retry {attempts}/2\n")
            invalidate_board()
            return True
        with workshop_lock():
            data = load_workshop()
            ov = data.setdefault("board_ov", {})
            row = dict(ov.get(key) or {})
            row["error"] = tg_clip(str(exc), 120)
            # The click never reached GitHub: stop painting it as pending truth.
            row.pop("pending", None)
            ov[key] = row
            save_workshop(data)
        append_log(f"board sync {key} {action}: {exc}\n")
    invalidate_board()
    return True


def clear_board_overlay(repo: str, number: int) -> dict:
    with workshop_lock():
        data = load_workshop()
        ov = data.setdefault("board_ov", {})
        ov.pop(board_key(repo, number), None)
        save_workshop(data)
    invalidate_board()
    return {"ok": True, "repo": repo, "issue": number}


def maybe_refresh_board(reg: dict, stale: float = 20) -> None:
    global _board_fetch_t
    data = load_workshop()
    snap_t = float((data.get("board_snap") or {}).get("t") or 0)
    if time.time() - max(_board_fetch_t, snap_t) < stale:
        return
    try:
        fetch_github_board(reg)
        cached_research(reg, (load_workshop().get("board_snap") or {}).get("cards"))
    except Exception as exc:
        append_log(f"board fetch: {exc}\n")


def draft_summaries(reg: dict) -> list[dict]:
    prune_drafts()
    pins = {p["repo"]: p["name"] for p in pinned_projects(reg)}
    out = []
    for item in load_workshop().get("drafts") or []:
        repo = item.get("repo") or ""
        out.append({
            "id": item.get("id") or "",
            "repo": repo,
            "title": item.get("title") or "",
            "project": pins.get(repo) or repo.rsplit("/", 1)[-1],
        })
    return out


def next_move(cards: list, drafts: list, project: str | None = None) -> dict | None:
    vis = [c for c in cards if not project or c.get("project") == project]
    if any(c.get("column") == "ready" for c in vis):
        return None
    vis_d = [d for d in drafts if not project or d.get("project") == project]
    if vis_d:
        return {"kind": "drafts", "count": len(vis_d), "project": vis_d[0].get("project") or ""}
    backlog = [c for c in vis if c.get("column") == "backlog" and not c.get("blocked")]
    if backlog:
        card = backlog[0]
        return {
            "kind": "backlog",
            "issue": f"{card.get('repo')}#{card.get('number')}",
            "title": card.get("title") or "",
            "project": card.get("project") or "",
        }
    return {"kind": "orch", "project": project or ""}


def write_block_reason(cards: list, project_name: str, except_issue: int | None = None) -> str:
    for card in cards:
        if card.get("project") != project_name:
            continue
        if (card.get("state") or "OPEN").upper() == "CLOSED":
            continue
        if except_issue is not None and card.get("number") == except_issue:
            continue
        if card.get("runner") == "self":
            return f"{project_name} is claimed as self"
        col = card.get("column")
        if col in {"in-progress", "qa"} and card.get("runner") not in {"", "self"}:
            return f"VPS is writing {project_name}"
        if col == "qa":
            return f"{project_name} is in QA"
    return ""


def pin_write_block(reg: dict, project_name: str, except_issue: int | None = None) -> str:
    return write_block_reason(board_payload(reg)["cards"], project_name, except_issue)


def vps_owns_project(reg: dict, project_name: str, except_issue: int | None = None) -> bool:
    return pin_write_block(reg, project_name, except_issue).startswith("VPS")


def tmux_session(project: str) -> str:
    return f"corp-run-{project}"


def tmux_has(session: str) -> bool:
    if not have("tmux"):
        return False
    return run(["tmux", "has-session", "-t", session], check=False).returncode == 0


def tmux_alive(project: str) -> bool:
    return tmux_has(tmux_session(project))


def tmux_kill(project: str) -> None:
    if not have("tmux") or not tmux_alive(project):
        return
    run(["tmux", "kill-session", "-t", tmux_session(project)], check=False)


def orch_alive(project: str) -> bool:
    return tmux_has(orch_session(project))


def capture_pane(session: str, lines: int = 80) -> str:
    if not tmux_has(session):
        return ""
    proc = subprocess.run(
        ["tmux", "capture-pane", "-pt", session, "-S", f"-{int(lines)}"],
        text=True,
        capture_output=True,
    )
    return proc.stdout or ""


def set_orch_state(name: str, status: str, **extra) -> dict:
    data = load_workshop()
    row = dict((data.get("orch") or {}).get(name) or {})
    row.update(extra)
    row["status"] = status
    row["updated"] = time.time()
    data.setdefault("orch", {})[name] = row
    save_workshop(data)
    return row


def orch_status(name: str) -> dict:
    row = dict((load_workshop().get("orch") or {}).get(name) or {})
    alive = orch_alive(name)
    row["running"] = alive or row.get("status") == "running"
    if alive:
        row["status"] = "running"
        row["pane"] = capture_pane(orch_session(name), 60)
    else:
        row["pane"] = ""
    row["log"] = last_log_lines(12, prefix=f"orch {name}")
    if row["log"] == "тишина" and RUN_LOG.is_file() and row["running"]:
        row["log"] = last_log_lines(8)
    return row


CLAIM_RUN_RE = re.compile(r"corp-claim:.*\brun:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})")


def new_run_id() -> str:
    return str(uuid.uuid4())


def run_from_claim_body(text: str) -> str:
    match = CLAIM_RUN_RE.search(text or "")
    return match.group(1) if match else ""


def latest_claim_info(repo: str, number: int) -> tuple[str, float]:
    proc = run(
        [
            "gh",
            "api",
            "--paginate",
            f"repos/{repo}/issues/{number}/comments",
            "--jq",
            '.[] | select(.body | startswith("corp-claim:") and contains("run:")) | [.created_at, .body] | @tsv',
        ],
        check=False,
        timeout=30,
    )
    if proc.returncode != 0:
        raise CorpError(f"cannot read claim comments for {repo}#{number}: {(proc.stderr or proc.stdout or '').strip()[:160]}")
    rows = [line for line in (proc.stdout or "").splitlines() if line.strip()]
    if not rows:
        return "", 0.0
    last = rows[-1].split("\t", 1)
    created_iso = last[0] if last else ""
    body = last[1] if len(last) > 1 else ""
    try:
        from datetime import datetime, timezone

        created = datetime.strptime(created_iso, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        created = 0.0
    return run_from_claim_body(body), created


def latest_claim_run(repo: str, number: int) -> str:
    return latest_claim_info(repo, number)[0]


def claim_sticks(repo: str, number: int, run_id: str, attempts: int = 3) -> bool:
    for index in range(attempts):
        try:
            found = latest_claim_run(repo, number)
        except CorpError:
            if index == attempts - 1:
                return False
            time.sleep(2)
            continue
        if found == run_id:
            return True
        if found and found != run_id:
            return False
        time.sleep(2)
    return False


def issue_detail(repo: str, number: int, comments_limit: int = 10) -> dict:
    issue = get_issue(repo, number)
    proc = run(
        [
            "gh",
            "api",
            "--paginate",
            f"repos/{repo}/issues/{number}/comments",
            "--jq",
            ".[] | {author: .user.login, at: .created_at, body: .body} | @json",
        ],
        check=False,
        timeout=30,
    )
    comments = []
    if proc.returncode == 0:
        rows = [line for line in (proc.stdout or "").splitlines() if line.strip()]
        try:
            parsed = [json.loads(row) for row in rows]
        except json.JSONDecodeError:
            parsed = []
        for row in parsed[-max(1, int(comments_limit)):]:
            comments.append(
                {
                    "author": str(row.get("author") or ""),
                    "at": str(row.get("at") or ""),
                    "body": redact_secrets(str(row.get("body") or "")),
                }
            )
    return {
        "repo": repo,
        "number": number,
        "title": issue.get("title") or "",
        "state": (issue.get("state") or "").upper(),
        "url": issue.get("url") or "",
        "updatedAt": issue.get("updatedAt") or "",
        "body": redact_secrets(str(issue.get("body") or "")),
        "comments": comments,
    }


def claim(repo: str, number: int, kind: str, note: str) -> None:
    via_all = list(VIA.values())
    remove_labels(repo, number, ["ready", "queued", "self", *via_all])
    add_labels(repo, number, ["in-progress", "self"] if kind == "self" else ["in-progress", VIA[kind]])
    assign_me(repo, number)
    comment(repo, number, note)
    invalidate_board()


def take_issue(reg: dict, repo: str, number: int) -> dict:
    require_eligible(reg, repo, number)
    run_id = new_run_id()
    claim(repo, number, "self", f"corp-claim: self run:{run_id}")
    latest = get_issue(repo, number)
    if "in-progress" not in label_names(latest) or "self" not in label_names(latest):
        die(f"{repo}#{number} claim did not stick on GitHub")
    if not claim_sticks(repo, number, run_id):
        die(f"{repo}#{number} клейм перехвачен другим процессом (наш run {run_id[:8]}) — карта не задвоена")
    invalidate_board()
    record_event("take", tg_short_ref(repo, number), "взял")
    return {"ok": True, "repo": repo, "issue": number, "runner": "self", "run_id": run_id}


def drop_self(repo: str, number: int) -> dict:
    issue = get_issue(repo, number)
    names = label_names(issue)
    column = column_of(issue)
    if "self" not in names:
        return {"ok": True, "dropped": False, "repo": repo, "issue": number, "column": column}
    remove_labels(repo, number, ["self"])
    invalidate_board()
    try:
        latest = get_issue(repo, number)
    except Exception:
        labels = [
            item
            for item in (issue.get("labels") or [])
            if (item.get("name") if isinstance(item, dict) else item) != "self"
        ]
        latest = {**issue, "labels": labels}
    return {
        "ok": True,
        "dropped": True,
        "repo": repo,
        "issue": number,
        "column": column_of(latest),
        "labels": sorted(label_names(latest)),
    }


def refresh_graph(dest: Path, repo: str, number: int) -> str:
    if not dest.is_dir():
        return "no checkout"
    if not have("graphify"):
        return "no graphify"
    run(["git", "pull", "--ff-only"], cwd=dest, check=False)
    proc = run(["graphify", "update", "."], cwd=dest, check=False)
    if proc.returncode != 0:
        run(["graphify", "."], cwd=dest, check=False)
    status = run(["git", "status", "--porcelain", "--", "graphify-out"], cwd=dest, check=False)
    if not (status.stdout or "").strip():
        return "graph unchanged"
    run(["git", "add", "--", "graphify-out"], cwd=dest, check=False)
    run(["git", "reset", "-q", "--", "graphify-out/cache"], cwd=dest, check=False)
    commit = run(
        ["git", "commit", "-m", f"graphify: refresh after {repo}#{number}"],
        cwd=dest,
        check=False,
    )
    if commit.returncode != 0:
        return "graph commit skipped"
    push = run(["git", "push"], cwd=dest, check=False)
    return "graph pushed" if push.returncode == 0 else "graph committed, push failed"


def close_action(issue: dict, force: bool = False, fail: bool = False) -> str:
    names = label_names(issue)
    in_qa = "in-qa" in names and "qa-fail" not in names
    if fail:
        return "reject" if in_qa else "not-qa"
    if in_qa or force:
        return "close"
    return "send-to-qa"


def reject_qa(reg: dict, repo: str, number: int, note: str = "") -> dict:
    issue = get_issue(repo, number)
    if (issue.get("state") or "").upper() == "CLOSED":
        die(f"{repo}#{number} закрыта")
    remove_labels(repo, number, ["in-qa", "in-progress", "queued", "self", *VIA.values()])
    add_labels(repo, number, ["ready", "qa-fail"])
    comment(repo, number, (note or "").strip() or "QA не принял.")
    invalidate_board()
    return {"ok": True, "repo": repo, "issue": number, "column": "ready", "qa_fail": True}


def close_issue(
    reg: dict,
    repo: str,
    number: int,
    force: bool = False,
    fail: bool = False,
    note: str = "",
) -> dict:
    issue = get_issue(repo, number)
    action = close_action(issue, force=force, fail=fail)
    if action == "not-qa":
        die(f"{repo}#{number} не на QA")
    if action == "reject":
        record_event("qa_fail", tg_short_ref(repo, number), "QA не принял")
        return reject_qa(reg, repo, number, note)
    if action == "send-to-qa":
        return send_to_qa(reg, repo, number, enqueue=False)
    project = project_by_repo(reg, repo)
    dest = project_dir(project)
    proc = run(["gh", "issue", "close", str(number), "-R", repo], check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout).strip())
    graph = refresh_graph(dest, repo, number) if dest else "no checkout"
    graphify_ok = graph in {"graph pushed", "graph unchanged"}
    note_graph = f"graphify: {graph}"
    try:
        comment(repo, number, note_graph)
    except CorpError:
        pass
    if not graphify_ok:
        need_human(f"{repo}#{number} {note_graph}")
        tg_notify_event("need_human", tg_short_ref(repo, number), note_graph, url=issue.get("url") or "")
    invalidate_board()
    maybe_orchestrate(reg, project["name"])
    record_event("qa_pass", tg_short_ref(repo, number), "QA прошёл")
    return {
        "ok": True,
        "repo": repo,
        "issue": number,
        "graph": graph,
        "graphify_ok": graphify_ok,
        "graphify_note": note_graph,
        "closed": True,
    }


def send_to_qa(
    reg: dict,
    repo: str,
    number: int,
    enqueue: bool = False,
    cards: list | None = None,
) -> dict:
    issue = get_issue(repo, number)
    if (issue.get("state") or "").upper() == "CLOSED":
        die(f"{repo}#{number} is closed")
    project = project_by_repo(reg, repo)
    if cards is not None:
        blocked = write_block_reason(cards, project["name"], number)
    else:
        blocked = pin_write_block(reg, project["name"], except_issue=number)
    if blocked:
        die(blocked)
    remove_labels(repo, number, ["ready", "qa-fail", "in-progress", "self", *VIA.values()])
    add_labels(repo, number, ["in-qa"])
    invalidate_board()
    queued = False
    if enqueue:
        profile = ((load_workshop().get("profiles") or DEFAULT_PROFILES)[0] or {}).get("id") or "claude"
        try:
            queue_add(reg, repo, number, profile)
            queued = True
        except CorpError:
            try:
                queue_retry(repo, number)
                queued = True
            except CorpError:
                pass
    tg_notify_event("to_qa", tg_short_ref(repo, number), "на QA", url=issue.get("url") or "", action_ref=issue_ref(repo, number))
    return {"ok": True, "repo": repo, "issue": number, "column": "qa", "queued": queued}


def move_issue(reg: dict, repo: str, number: int, column: str) -> dict:
    if column not in {"backlog", "ready", "in-progress", "qa", "done"}:
        die("column must be backlog|ready|in-progress|qa|done")
    if column in {"done", "qa"}:
        return send_to_qa(reg, repo, number, enqueue=False)
    issue = get_issue(repo, number)
    if (issue.get("state") or "").upper() == "CLOSED":
        run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
    via_all = list(VIA.values())
    if column == "backlog":
        remove_labels(repo, number, ["ready", "in-qa", "qa-fail", "in-progress", "self", "queued", *via_all])
    elif column == "ready":
        remove_labels(repo, number, ["in-qa", "in-progress", "self", "queued", *via_all])
        add_labels(repo, number, ["ready"])
    else:
        add_labels(repo, number, ["in-progress"])
        remove_labels(repo, number, ["ready"])
    invalidate_board()
    return {"ok": True, "repo": repo, "issue": number, "column": column}


def pick_agent() -> str:
    load_env()
    preferred = os.environ.get("CORP_AGENT", "").strip()
    if preferred:
        kind = preferred if preferred in KIND_BIN else next((k for k, b in KIND_BIN.items() if b == preferred), "")
        binary = KIND_BIN.get(kind, preferred)
        if kind:
            if not kind_cli_ok(kind):
                die(f"CORP_AGENT={preferred} is not installed")
        elif not have(binary):
            die(f"CORP_AGENT={preferred} is not installed")
        return kind or preferred
    for kind, binary in KIND_BIN.items():
        if kind_cli_ok(kind):
            return kind
    die("no agent CLI found. Install claude, codex, grok, or cursor agent")


def agent_prompt(repo: str, number: int, title: str, url: str, dest: Path, project: str = "") -> str:
    workshop = ""
    if project == "corp" or dest.resolve() == ROOT.resolve():
        workshop = (
            " This is the live workshop. Within this issue, expand useful function "
            "and push workshop/static UI/UX on phone and desktop as far as it will go. "
            "workshop/preview.html is a reference, not a wholesale port. "
            "Keep Passkey, Tailscale, pins, and GitHub as planner. No new product repo."
        )
    return (
        f"Follow {ROOT}/AGENTS.md and {ROOT}/HARNESS.md "
        f"(on the VPS that is /opt/corp/AGENTS.md and /opt/corp/HARNESS.md). "
        f"Do only this GitHub Issue and nothing else: {repo}#{number} {title} {url}. "
        f"Work in {dest}. Control plane is {ROOT}. "
        f"{workshop} "
        f"If graphify-out/GRAPH_REPORT.md exists, read it, then run "
        f'`graphify query` for this issue before broad file reads. '
        f"Commit and push in this product repo. Do not close the issue — "
        f"QA reviews next and only QA closes it. After close, graphify update "
        f"will run — do not rebuild the whole graph yourself unless missing. "
        f"Never rewrite git history."
    )


def agent_argv(kind: str, prompt: str, dest: Path, model: str = "", effort: str = "", fast: bool = False, readonly: bool = False, last_message: Path | None = None) -> list[str]:
    workspace_root = workspace()
    if readonly:
        if kind == "claude":
            cmd = [
                "claude",
                "-p",
                prompt,
                "--allowedTools",
                "Read,Glob,Grep,WebFetch",
                "--add-dir",
                str(dest),
                "--add-dir",
                str(workspace_root),
                "--add-dir",
                str(ROOT),
            ]
            if model:
                cmd += ["--model", model]
            if effort:
                cmd += ["--effort", "low" if fast and not effort else effort]
            elif fast:
                cmd += ["--effort", "low"]
            return cmd
        if kind == "codex":
            cmd = [
                "codex",
                "exec",
                "--sandbox",
                "read-only",
                "--skip-git-repo-check",
                "--color",
                "never",
                "-C",
                str(dest),
            ]
            if last_message:
                cmd += ["-o", str(last_message)]
            if model:
                cmd += ["--model", model]
            if effort:
                cmd += ["-c", f"model_reasoning_effort={effort}"]
            if fast:
                cmd += ["-c", "service_tier=fast"]
            cmd.append(prompt)
            return cmd
        die(f"{kind} has no read-only sandbox for orchestrator")
    if kind == "claude":
        cmd = [
            "claude",
            "-p",
            prompt,
            "--dangerously-skip-permissions",
            "--add-dir",
            str(dest),
            "--add-dir",
            str(workspace_root),
            "--add-dir",
            str(ROOT),
        ]
        if model:
            cmd += ["--model", model]
        if effort:
            cmd += ["--effort", "low" if fast and not effort else effort]
        elif fast:
            cmd += ["--effort", "low"]
        return cmd
    if kind == "codex":
        cmd = ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox"]
        if model:
            cmd += ["--model", model]
        if effort:
            cmd += ["-c", f"model_reasoning_effort={effort}"]
        if fast:
            cmd += ["-c", "service_tier=fast"]
        cmd.append(prompt)
        return cmd
    if kind == "grok":
        cmd = ["grok", "-p", prompt, "--permission-mode", "auto"]
        if model:
            cmd += ["--model", model]
        if effort:
            cmd += ["--effort", "low" if fast else effort]
        elif fast:
            cmd += ["--effort", "low"]
        return cmd
    if kind == "cursor":
        if not kind_cli_ok("cursor"):
            die("cursor CLI is not installed (agent is Grok or missing)")
        cmd = ["agent", "-p", prompt, "--force", "--trust", "--workspace", str(dest)]
        if model:
            cmd += ["--model", model]
        return cmd
    die(f"unknown agent {kind}")


def append_log(text: str) -> None:
    config_dir()
    with RUN_LOG.open("a") as handle:
        handle.write(text)
        if not text.endswith("\n"):
            handle.write("\n")


def agent_user_name() -> str:
    return os.environ.get("CORP_AGENT_USER", "").strip()


def isolation_probe_user() -> str:
    return agent_user_name() or AGENT_USER_DEFAULT


def agent_home_dir(user: str | None = None) -> Path:
    custom = os.environ.get("CORP_AGENT_HOME", "").strip()
    if custom:
        return Path(custom)
    return Path(f"/home/{user or isolation_probe_user()}")


def agent_wrapper_path() -> Path:
    return Path(os.environ.get("CORP_AGENT_WRAPPER", "").strip() or AGENT_WRAPPER_DEFAULT)


def isolation_secret_paths(config: Path | None = None) -> list[Path]:
    base = config if config is not None else Path.home() / ".config" / "corp"
    return [base / name for name in ISOLATION_SECRET_NAMES]


def isolation_wrapper_argv(user: str | None = None) -> list[str]:
    return ["sudo", "-n", "-u", user or isolation_probe_user(), str(agent_wrapper_path()), "--probe"]


def _path_is_file(path: Path) -> bool:
    try:
        return path.is_file()
    except OSError:
        return False


def _path_exists(path: Path) -> bool:
    try:
        return path.exists()
    except OSError:
        return False


def _path_mode(path: Path) -> int | None:
    try:
        return path.stat().st_mode
    except OSError:
        return None


def workspace_isolation_ok(dest_workspace: Path | None = None, config: Path | None = None) -> tuple[bool, list[str]]:
    ws = dest_workspace if dest_workspace is not None else workspace()
    cfg = config if config is not None else Path.home() / ".config" / "corp"
    blockers: list[str] = []
    try:
        if not ws.is_dir():
            return False, ["workspace missing"]
        mode = _path_mode(ws)
        if mode is not None and mode & 0o004:
            blockers.append("workspace is world-readable")
        parent = ws.parent
        parent_mode = _path_mode(parent) if parent.is_dir() else None
        if parent_mode is not None and not (parent_mode & 0o001):
            blockers.append("workspace parent is not traversable by other users")
        cfg_mode = _path_mode(cfg) if cfg.is_dir() else None
        if cfg_mode is not None and cfg_mode & 0o007:
            blockers.append("control-plane config is open to other users")
        dot_config = cfg.parent
        dot_mode = _path_mode(dot_config) if dot_config.is_dir() else None
        if dot_mode is not None and dot_config.name == ".config" and dot_mode & 0o007:
            blockers.append("~/.config is open to other users")
    except OSError as exc:
        return False, [f"workspace probe denied: {exc}"]
    return not blockers, blockers


def probe_isolation(
    run_cmd=None,
    dest_workspace: Path | None = None,
    config: Path | None = None,
) -> dict:
    """Fail-closed isolation report. Uses the wrapper only — never `sudo -n -u $user true`."""
    try:
        return _probe_isolation_inner(run_cmd, dest_workspace, config)
    except OSError as exc:
        return {
            "mode": "transitional",
            "armed": bool(agent_user_name()),
            "isolated": False,
            "ready_to_arm": False,
            "wrapper_ok": False,
            "workspace_ok": False,
            "secrets_denied": False,
            "clis": {name: False for name in ISOLATION_CLIS},
            "user": isolation_probe_user(),
            "blockers": [f"isolation probe denied: {exc}", "CLIs not installed under that UID"],
        }


def _probe_isolation_inner(
    run_cmd=None,
    dest_workspace: Path | None = None,
    config: Path | None = None,
) -> dict:
    run_cmd = run_cmd or (lambda cmd: run(cmd, check=False))
    user = isolation_probe_user()
    wrapper = agent_wrapper_path()
    armed = bool(agent_user_name())
    blockers: list[str] = []
    wrapper_ok = False
    try:
        wrapper_present = wrapper.is_file()
    except OSError:
        wrapper_present = False
        blockers.append("wrapper not readable")
    if wrapper_present:
        argv = isolation_wrapper_argv(user)
        if argv[-1] != "--probe" or "true" in argv:
            blockers.append("probe argv is not wrapper-only")
        else:
            wrapper_ok = run_cmd(argv).returncode == 0
            if not wrapper_ok:
                blockers.append("wrapper probe failed")
    else:
        if "wrapper not readable" not in blockers:
            blockers.append("wrapper not installed")
    ws_ok, ws_blockers = workspace_isolation_ok(dest_workspace, config)
    blockers.extend(ws_blockers)
    secrets_denied = True
    for path in isolation_secret_paths(config):
        try:
            if _path_exists(path):
                mode = _path_mode(path)
                if mode is not None and mode & 0o077:
                    secrets_denied = False
                    blockers.append(f"{path.name} is group/world accessible")
        except OSError:
            secrets_denied = False
            blockers.append(f"{path.name} not readable")
    home = agent_home_dir(user)
    clis = {}
    for name in ISOLATION_CLIS:
        path = home / ".local" / "bin" / name
        try:
            clis[name] = path.is_file() and os.access(path, os.X_OK)
        except OSError:
            clis[name] = False
    if not (clis.get("claude") or clis.get("agent")):
        blockers.append("CLIs not installed under that UID")
    if not armed:
        blockers.append("CORP_AGENT_USER unset")
    ready_to_arm = wrapper_ok and ws_ok and secrets_denied and bool(clis.get("claude") or clis.get("agent"))
    isolated = ready_to_arm and armed
    if isolated:
        mode = "isolated"
    elif ready_to_arm:
        mode = "ready-to-arm"
    else:
        mode = "transitional"
    return {
        "mode": mode,
        "armed": armed,
        "isolated": isolated,
        "ready_to_arm": ready_to_arm,
        "wrapper_ok": wrapper_ok,
        "workspace_ok": ws_ok,
        "secrets_denied": secrets_denied,
        "clis": clis,
        "user": user,
        "blockers": blockers,
    }


def agent_identity_ready() -> bool:
    return bool(probe_isolation().get("isolated"))


def transitional_env() -> dict[str, str]:
    return {k: v for k, v in os.environ.items() if k not in CONTROL_PLANE_SECRET_KEYS}


def wrap_isolated(cmd: list[str], dest: Path) -> list[str]:
    # Isolated path is opt-in via CORP_AGENT_USER. Do not probe with `sudo true`.
    if agent_user_name() and agent_wrapper_path().is_file():
        user = agent_user_name()
        home = agent_home_dir(user)
        binary = str(home / ".local" / "bin" / cmd[0])
        return ["sudo", "-n", "-u", user, str(agent_wrapper_path()), str(dest.resolve()), binary, *cmd[1:]]
    env = transitional_env()
    return ["env", "-i"] + [f"{k}={v}" for k, v in sorted(env.items())] + cmd


def parse_exit_code(text: str, prefix: str = "") -> int | None:
    lines = [line.rstrip() for line in (text or "").splitlines() if line.strip()]
    if prefix:
        tagged = [line for line in lines if line.startswith(prefix)]
        if tagged:
            lines = tagged
    for line in reversed(lines):
        match = re.search(r"EXIT:(\d+)\s*$", line)
        if match:
            return int(match.group(1))
    return None


def read_tmux_exit(log_text: str, pane_text: str = "", prefix: str = "") -> int:
    code = parse_exit_code(log_text, prefix)
    if code is not None:
        return code
    code = parse_exit_code(pane_text, prefix)
    if code is not None:
        return code
    return 1


def tmux_agent_script(dest: Path, pipe: str, prefix: str = "") -> str:
    log = shlex.quote(str(RUN_LOG))
    tag = shlex.quote(prefix) if prefix else ""
    return (
        f"set -o pipefail; cd {shlex.quote(str(dest))} && {pipe} | tee -a {log}; "
        f"echo {tag} EXIT:$? | tee -a {log}"
    )


def can_promote_to_qa(code: int, issue: dict) -> bool:
    if int(code) != 0:
        return False
    return (issue.get("state") or "OPEN").upper() != "CLOSED"


def wait_tmux(project: str, prefix: str = "", hung_sec: int | None = None) -> int:
    session = tmux_session(project)
    pane = ""
    limit = QUEUE_HUNG_SEC if hung_sec is None else hung_sec
    last_activity = time.time()
    last_snapshot = ""
    while run(["tmux", "has-session", "-t", session], check=False).returncode == 0:
        pane = capture_pane(session)
        log_text = RUN_LOG.read_text() if RUN_LOG.is_file() else ""
        tail_lines = (log_text.splitlines() or [])[-200:]
        tail_lines = [line for line in tail_lines if " heartbeat · " not in line]
        if prefix:
            tail_lines = [line for line in tail_lines if log_line_matches_issue(line, prefix)]
        snapshot = f"{pane}\n" + "\n".join(tail_lines)
        if snapshot != last_snapshot:
            if last_snapshot:
                last_activity = time.time()
            last_snapshot = snapshot
        if limit >= 0 and time.time() - last_activity >= limit:
            tmux_kill(project)
            return 124
        time.sleep(3)
    log_text = RUN_LOG.read_text() if RUN_LOG.is_file() else ""
    return read_tmux_exit(log_text, pane, prefix)


def launch_agent(kind: str, cmd: list[str], dest: Path, project: str, prefix: str = "", repo: str = "", number: int = 0) -> int:
    tag = prefix or project
    append_log(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} {tag} via {kind} ===\n")
    cmd = wrap_isolated(cmd, dest)
    stop_pulse = threading.Event()
    pulse = None
    if repo and number:
        pulse = threading.Thread(
            target=pulse_loop,
            args=(repo, number, kind, time.time(), stop_pulse),
            daemon=True,
        )
        pulse.start()
    try:
        return _launch_agent_inner(kind, cmd, dest, project, prefix, hung_tag=tag)
    finally:
        stop_pulse.set()


def _launch_agent_inner(kind: str, cmd: list[str], dest: Path, project: str, prefix: str = "", hung_tag: str = "") -> int:
    if have("tmux"):
        session = tmux_session(project)
        if tmux_alive(project):
            die(f"already running: tmux {session}")
        pipe = f"{shlex.join(cmd)} 2>&1"
        if prefix:
            pipe += (
                f" | while IFS= read -r line || [ -n \"$line\" ]; do "
                f"printf '%s %s\\n' {shlex.quote(prefix)} \"$line\"; done"
            )
        script = tmux_agent_script(dest, pipe, prefix)
        proc = subprocess.run(["tmux", "new-session", "-d", "-s", session, "bash", "-lc", script])
        if proc.returncode != 0:
            return proc.returncode
        return wait_tmux(project, prefix)
    proc = subprocess.run(cmd, cwd=dest)
    return proc.returncode


def _role_prompt(role: str, project: str, names: set[str]) -> str:
    rework = " Label qa-fail is set: read the latest QA comments and fix those items first." if "qa-fail" in names else ""
    if role == "design":
        if project == "corp":
            return (
                " This is a workshop design issue: change workshop/static for phone and desktop. "
                "workshop/preview.html is a reference, not a dump. Do not close the issue. QA reviews next."
                + rework
            )
        return (
            " This is a design issue: change only preview/docs, not production code. "
            "Do not close the issue. QA reviews next."
            + rework
        )
    if role == "qa":
        return (
            " This is mandatory QA. Review the pushed work against the issue. "
            "If it passes: comment briefly and close the issue. "
            "If it fails: leave it open and comment concrete fixes. Do not close."
        )
    return (
        " Implement, commit, and push. Do not close the issue — QA closes it after review."
        + rework
    )


def run_issue(
    reg: dict,
    repo: str,
    number: int,
    kind: str,
    model: str = "",
    effort: str = "",
    fast: bool = False,
    _qa_round: int = 0,
) -> dict:
    load_env()
    project = project_by_repo(reg, repo)
    dest = project_dir(project)
    if dest is None or not dest.is_dir():
        die(f"project not cloned: {project['name']}. Run ./bin/corp bootstrap")
    sync_writer_tree(dest, project["name"])
    issue = get_issue(repo, number)
    names = label_names(issue)
    issue = require_eligible(
        reg,
        repo,
        number,
        issue,
        allow_in_qa="in-qa" in names and "qa-fail" not in names,
    )
    names = label_names(issue)
    if tmux_alive(project["name"]):
        die(f"VPS already running {project['name']}")
    role, slot = slot_for_issue(project["name"], issue)
    kind = kind or slot.get("kind") or kind
    model = model or slot.get("model") or ""
    effort = effort or slot.get("effort") or ""
    fast = fast or bool(slot.get("fast"))
    if kind not in KIND_BIN:
        die(f"unknown agent {kind}")
    if not kind_cli_ok(kind):
        die(f"{kind} CLI is not installed ({KIND_BIN[kind]})")
    extra = _role_prompt(role, project["name"], names)
    run_id = new_run_id()
    claim(repo, number, kind, f"corp-claim: vps {kind} · {role} run:{run_id}")
    if not claim_sticks(repo, number, run_id):
        die(f"{repo}#{number} карту забрал другой раннер (наш run {run_id[:8]}) — спавн отменён")
    prompt = agent_prompt(repo, number, issue.get("title") or "", issue.get("url") or "", dest, project["name"]) + extra
    tg_notify_event("start", tg_short_ref(repo, number), "старт", kind, url=issue.get("url") or "", action_ref=issue_ref(repo, number))
    cmd = agent_argv(kind, prompt, dest, model=model, effort=effort, fast=fast)
    print(f"running: {cmd[0]} {repo}#{number} {role}", file=sys.stderr)
    code = launch_agent(kind, cmd, dest, project["name"], prefix=issue_ref(repo, number), repo=repo, number=number)
    latest = get_issue(repo, number)
    closed = (latest.get("state") or "").upper() == "CLOSED"
    if code == 124:
        release_runner(repo, number, run_id=run_id)
        reason = "завис (таймаут)"
        tg_notify_event("hung", tg_short_ref(repo, number), reason, "стоп", url=latest.get("url") or "", action_ref=issue_ref(repo, number))
        return {
            "ok": False,
            "code": code,
            "repo": repo,
            "issue": number,
            "kind": kind,
            "graph": "",
            "closed": False,
            "hung": True,
            "error": reason,
        }
    if role in {"build", "design"}:
        if closed:
            run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
        if not can_promote_to_qa(code, latest):
            reason = f"{role} упал · exit {code}" if code != 0 else f"{role} закрыл ишью — не на QA"
            release_runner(repo, number, run_id=run_id)
            tg_notify_event("fail", tg_short_ref(repo, number), tg_clip(reason, 40), "Очередь+", url=latest.get("url") or "", action_ref=issue_ref(repo, number))
            return {
                "ok": False,
                "code": code,
                "repo": repo,
                "issue": number,
                "kind": kind,
                "graph": "",
                "closed": False,
                "error": reason,
            }
        remove_labels(repo, number, ["ready", "qa-fail", "in-progress", "self", *VIA.values()])
        add_labels(repo, number, ["in-qa"])
        invalidate_board()
        tg_notify_event("to_qa", tg_short_ref(repo, number), "на QA", url=latest.get("url") or "", action_ref=issue_ref(repo, number))
        if council_should_auto_qa(names) or council_should_auto_qa(label_names(latest)):
            return council_after_writer(reg, repo, number, dest)
        qa_slot = slots_for(project["name"])["qa"]
        return run_issue(
            reg,
            repo,
            number,
            qa_slot.get("kind") or "claude",
            model=qa_slot.get("model") or "",
            effort=qa_slot.get("effort") or "",
            fast=bool(qa_slot.get("fast")),
            _qa_round=_qa_round,
        )
    if role == "qa":
        if closed and code == 0:
            graph = refresh_graph(dest, repo, number)
            tg_notify_event("closed", tg_short_ref(repo, number), "закрыл", url=latest.get("url") or "", action_ref=issue_ref(repo, number))
            maybe_orchestrate(reg, project["name"])
            return {
                "ok": True,
                "code": code,
                "repo": repo,
                "issue": number,
                "kind": kind,
                "graph": graph,
                "closed": True,
            }
        if closed:
            run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
        notes = last_log_lines(8, prefix=issue_ref(repo, number))
        remove_labels(repo, number, ["in-qa", "in-progress", *VIA.values()])
        add_labels(repo, number, ["ready", "qa-fail"])
        comment(
            repo,
            number,
            "QA не принял. Доработки:\n\n"
            f"{notes}\n\n"
            "Исправь по комментариям и не закрывай — карточка снова пойдёт на QA.",
        )
        tg_notify_event("qa_fail", tg_short_ref(repo, number), "QA не принял", "ещё круг", url=latest.get("url") or "", action_ref=issue_ref(repo, number))
        if _qa_round + 1 < QA_ROUNDS:
            latest = get_issue(repo, number)
            rework_role, rework = slot_for_issue(project["name"], latest)
            return run_issue(
                reg,
                repo,
                number,
                rework.get("kind") or kind,
                model=rework.get("model") or "",
                effort=rework.get("effort") or "",
                fast=bool(rework.get("fast")),
                _qa_round=_qa_round + 1,
            )
        release_runner(repo, number, run_id=run_id)
        return {
            "ok": False,
            "code": code,
            "repo": repo,
            "issue": number,
            "kind": kind,
            "graph": "",
            "closed": False,
            "qa_fail": True,
            "error": "QA не принял",
        }
    release_runner(repo, number, run_id=run_id)
    reason = f"упал · exit {code}" if code != 0 else "не закрыл ишью"
    tg_notify_event(
        "incomplete" if code == 0 else "fail",
        tg_short_ref(repo, number),
        tg_clip(reason, 40),
        "Очередь+",
        url=latest.get("url") or "",
        action_ref=issue_ref(repo, number),
    )
    return {
        "ok": False,
        "code": code,
        "repo": repo,
        "issue": number,
        "kind": kind,
        "graph": "",
        "closed": False,
        "incomplete": code == 0,
        "error": reason,
    }


def run_next(reg: dict, args: argparse.Namespace) -> None:
    if args.issue:
        repo, number = parse_issue_ref(args.issue)
        kind = args.agent or ""
        model, effort, fast = args.model or "", args.effort or "", bool(args.fast)
        if args.profile:
            profile = profile_by_id(args.profile)
            kind = kind or profile.get("kind") or ""
            model = model or profile.get("model") or ""
            effort = effort or profile.get("effort") or ""
            fast = fast or bool(profile.get("fast"))
        if not kind:
            kind = pick_agent()
        if kind not in KIND_BIN:
            die(f"unknown agent {kind}")
        result = run_issue(reg, repo, number, kind, model=model, effort=effort, fast=fast)
        print(json.dumps(result, indent=2) if args.json else f"{result['repo']}#{result['issue']} {result['kind']} exit {result['code']}")
        raise SystemExit(0 if result["ok"] else result["code"] or 1)

    payload = cycle_payload(reg)
    print(render(payload), end="")
    if payload["mode"] != "execute":
        try:
            notify_safe("Готовых нет")
        except (SystemExit, CorpError):
            pass
        return
    nxt = payload["next"]
    result = run_issue(reg, nxt["repo"], nxt["issue"], pick_agent())
    raise SystemExit(0 if result["ok"] else result["code"] or 1)


def queue_action_buttons(repo: str, number: int) -> list:
    key = issue_ref(repo, number)
    return [[
        {"text": "Очередь+", "callback_data": f"q:{key}"},
        {"text": "Пауза", "callback_data": "c:pause"},
    ]]


def release_labels(names: set[str] | list[str]) -> tuple[list[str], list[str]]:
    names = set(names)
    remove = ["in-progress", "queued", "self", *VIA.values()]
    add: list[str] = []
    if not ("in-qa" in names and "qa-fail" not in names):
        add.append("ready")
    return remove, add


def release_runner(repo: str, number: int, issue: dict | None = None, run_id: str = "") -> None:
    issue = issue if issue is not None else get_issue(repo, number)
    if run_id:
        latest_run = ""
        try:
            latest_run = latest_claim_run(repo, number)
        except CorpError:
            pass
        if latest_run and latest_run != run_id:
            invalidate_board()
            return
    remove, add = release_labels(label_names(issue))
    remove_labels(repo, number, remove)
    if add:
        add_labels(repo, number, add)
    invalidate_board()


def queue_decision(
    item: dict,
    *,
    now: float,
    tmux_on: bool,
    issue: dict | None,
    max_attempts: int = QUEUE_MAX_ATTEMPTS,
    stale_sec: int = QUEUE_STALE_SEC,
    hung_sec: int = QUEUE_HUNG_SEC,
) -> str:
    status = item.get("status") or ""
    attempts = int(item.get("attempts") or 0)
    started = float(item.get("started_at") or 0)
    names = label_names(issue) if issue else set()
    open_issue = bool(issue) and (issue.get("state") or "OPEN").upper() != "CLOSED"
    claimed = bool(names & ({"in-progress", "queued"} | set(VIA.values())))
    if status == "done" and open_issue:
        if claimed or "in-qa" in names or "qa-fail" in names:
            return "retry" if attempts < max_attempts else "fail"
        return "fail"
    if status != "running":
        return "keep"
    if tmux_on:
        if started and hung_sec >= 0 and now - started >= hung_sec:
            return "hung"
        return "keep"
    if issue and not open_issue:
        return "closed"
    if started and now - started < min(25, stale_sec):
        return "keep"
    return "retry" if attempts < max_attempts else "fail"


def queue_job_outcome(ok: bool, attempts: int, retries: int, queue_running: bool, hung: bool = False) -> dict:
    if ok:
        return {"status": "done", "stop": False, "page": False, "event": "closed"}
    if hung:
        return {"status": "failed", "stop": True, "page": True, "event": "hung"}
    if not queue_running:
        return {"status": "failed", "stop": False, "page": False, "event": "fail"}
    if attempts < retries:
        return {"status": "waiting", "stop": False, "page": False, "event": "retry"}
    return {"status": "failed", "stop": True, "page": True, "event": "stop"}


def reap_queue(
    data: dict,
    now: float | None = None,
    tmux=None,
    fetch_issue=None,
    release=None,
    kill=None,
) -> list[dict]:
    now = time.time() if now is None else now
    tmux = tmux or tmux_alive
    fetch_issue = fetch_issue or (lambda repo, number: get_issue(repo, number))
    release = release or release_runner
    kill = kill or tmux_kill
    max_attempts = int(data.get("queue_retries") or QUEUE_MAX_ATTEMPTS)
    hung_sec = int(data.get("queue_hung_sec") or QUEUE_HUNG_SEC)
    events = []
    for item in data.get("queue") or []:
        status = item.get("status") or ""
        issue = None
        if status in {"running", "done"}:
            try:
                issue = fetch_issue(item["repo"], item["issue"])
            except Exception:
                issue = None
        action = queue_decision(
            item,
            now=now,
            tmux_on=bool(tmux(item.get("project") or "")),
            issue=issue,
            max_attempts=max_attempts,
            hung_sec=hung_sec,
        )
        if action == "keep":
            continue
        if action == "closed":
            item["status"] = "done"
            item["last_error"] = ""
            events.append({"kind": "closed", "item": item})
            continue
        if action == "hung":
            try:
                kill(item.get("project") or "")
            except Exception:
                pass
            try:
                release(item["repo"], item["issue"])
            except Exception:
                pass
            item["status"] = "failed"
            item["last_error"] = "завис (таймаут)"
            data["queue_running"] = False
            events.append({"kind": "hung", "item": item, "stop": True})
            continue
        try:
            release(item["repo"], item["issue"])
        except Exception:
            pass
        item["last_error"] = "раннер умер, ишью не закрыта" if status == "done" else "завис без сессии"
        if action == "fail":
            item["status"] = "failed"
            data["queue_running"] = False
            events.append({"kind": "stop", "item": item, "stop": True})
            continue
        item["status"] = "waiting"
        events.append({"kind": "retry", "item": item})
    return events


def heartbeat_age_from_log(log_text: str, ref: str, now: float | None = None) -> float | None:
    prefix = f" {ref} heartbeat "
    best = None
    for line in (log_text or "").splitlines():
        if prefix not in line:
            continue
        head = line.strip().split(" ", 1)[0]
        try:
            stamp = float(head)
        except ValueError:
            continue
        best = max(best or 0.0, stamp)
    if best is None:
        return None
    return (time.time() if now is None else now) - best


def reap_orphan_claims(
    reg: dict,
    *,
    now: float | None = None,
    list_in_progress=None,
    claim_age=None,
    heartbeat_age_fn=None,
    updated_age_fn=None,
    queue_refs=None,
    tmux_on=None,
    release=None,
    comment_fn=None,
    via_sec: int | None = None,
    self_sec: int | None = None,
) -> list[dict]:
    now = time.time() if now is None else now
    list_in_progress = list_in_progress or _list_in_progress_cards
    claim_age = claim_age or _claim_age_for
    heartbeat_age_fn = heartbeat_age_fn or _heartbeat_age_for
    updated_age_fn = updated_age_fn or _updated_age_for
    queue_refs = queue_refs if queue_refs is not None else {
        issue_ref(item.get("repo") or "", item.get("issue"))
        for item in load_workshop().get("queue") or []
        if item.get("status") == "running"
    }
    tmux_on = tmux_on or tmux_alive
    release = release or release_runner
    comment_fn = comment_fn or comment
    via_limit = CLAIM_REAP_VIA_SEC if via_sec is None else int(via_sec)
    self_limit = CLAIM_REAP_SELF_SEC if self_sec is None else int(self_sec)
    out = []
    for project in pinned_projects(reg):
        repo = project.get("repo") or ""
        name = project.get("name") or ""
        if not repo:
            continue
        session_alive = bool(tmux_on(name))
        for issue in list_in_progress(repo) or []:
            number = issue.get("number")
            if not number:
                continue
            names = label_names(issue)
            ref = issue_ref(repo, number)
            if ref in queue_refs or session_alive:
                continue
            hb = heartbeat_age_fn(repo, number)
            if hb is not None and hb < HEARTBEAT_LIVE_SEC:
                continue
            upd = updated_age_fn(repo, number, issue)
            if upd is not None and upd < HEARTBEAT_LIVE_SEC:
                continue
            age = claim_age(repo, number)
            is_self = "self" in names and not any(str(n).startswith("via:") for n in names)
            limit = self_limit if is_self else via_limit
            kind_of_card = "self" if is_self else next((n for n in names if n.startswith("via:")), "via:*")
            if age is None or age < limit:
                continue
            try:
                release(repo, number)
            except Exception as exc:
                append_log(f"reaper release failed {ref}: {exc}\n")
                continue
            try:
                comment_fn(repo, number, f"Reaper: клейм {kind_of_card} висит без живого процесса дольше {limit // 60} мин — вернул карту в ready.")
            except CorpError:
                pass
            record_event("reap", tg_short_ref(repo, number), f"{kind_of_card} без процесса {limit // 60} мин")
            out.append({"repo": repo, "number": number, "kind": kind_of_card, "age_min": int(age // 60)})
    return out


def _list_in_progress_cards(repo: str) -> list[dict]:
    proc = run(
        ["gh", "issue", "list", "-R", repo, "--state", "open", "--label", "in-progress",
         "--json", "number,title,labels,url", "--limit", "100"],
        check=False,
        timeout=30,
    )
    if proc.returncode != 0:
        return []
    try:
        return json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return []


def _claim_age_for(repo: str, number: int) -> float | None:
    try:
        _run_id, created = latest_claim_info(repo, number)
    except CorpError:
        return None
    if created <= 0:
        return None
    return time.time() - created


def _heartbeat_age_for(repo: str, number: int) -> float | None:
    if not RUN_LOG.is_file():
        return None
    try:
        text = RUN_LOG.read_text()
    except OSError:
        return None
    return heartbeat_age_from_log(text, issue_ref(repo, number))


def _updated_age_for(repo: str, number: int, issue: dict) -> float | None:
    raw = (issue.get("updatedAt") or "").strip()
    if not raw:
        return None
    try:
        from datetime import datetime, timezone

        stamp = datetime.strptime(raw.replace("Z", ""), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None
    return time.time() - stamp


def propose_draft(reg: dict, project_name: str, title: str, body: str, label: str = "ready") -> dict:
    project = project_by_name(reg, project_name)
    repo = project.get("repo") or ""
    if not repo or not is_pinned(project) or not pin_owns_repo(repo, reg):
        die("выберите corp или clarity")
    if not (title or "").strip():
        die("нужен заголовок")
    return new_draft(
        project["repo"],
        title.strip(),
        (body or "").strip() or title.strip(),
        label if label in {"ready", "blocked"} else "ready",
        "build",
        why="предложение из мастерской",
    )


def queue_add(
    reg: dict,
    repo: str,
    number: int,
    profile_id: str,
    model: str = "",
    effort: str = "",
    fast: bool | None = None,
    kind: str = "",
) -> dict:
    issue = get_issue(repo, number)
    names = label_names(issue)
    if is_sandbox_card(issue):
        if "P0" in names:
            die(f"{repo}#{number} sandbox не берёт P0")
        if "self" in names:
            die(f"{repo}#{number} claimed as self")
        if "blocked" in names:
            die(f"{repo}#{number} blocked")
    reason = issue_eligibility(reg, repo, number, issue)
    if reason and "self" in reason:
        die(reason)
    if (issue.get("state") or "").upper() == "CLOSED":
        die(reason or f"{repo}#{number} закрыта")
    if "blocked" in names:
        die(f"{repo}#{number} blocked")
    if "in-qa" in names and "qa-fail" not in names:
        die(f"{repo}#{number} на QA")
    if "in-progress" in names:
        die(f"{repo}#{number} in-progress")
    if column_of(issue) in {"in-progress", "qa", "done"}:
        die(f"{repo}#{number} {column_of(issue)}")
    runner = runner_of(issue)
    if runner not in {"", "queued"}:
        die(f"{repo}#{number} already claimed ({runner})")
    project = project_by_repo(reg, repo)
    profile = profile_by_id(profile_id) if profile_id else {}
    kind = (kind or profile.get("kind") or "").strip()
    model = model or profile.get("model") or ""
    key = issue_ref(repo, number)
    add_labels(repo, number, ["ready", "queued"])
    comment(repo, number, "corp-claim: queue")
    with workshop_lock():
        data = load_workshop()
        existing = None
        for item in data["queue"]:
            if issue_ref(item["repo"], item["issue"]) == key:
                existing = item
                break
        if existing and existing.get("status") in {"waiting", "running"}:
            die(f"{key} is already queued")
        row = {
            "repo": repo,
            "issue": number,
            "project": project["name"],
            "title": issue.get("title") or "",
            "url": issue.get("url") or "",
            "profile": profile_id,
            "kind": kind,
            "model": model,
            "effort": effort or profile.get("effort") or "",
            "fast": bool(fast) if fast is not None else None,
            "status": "waiting",
            "attempts": int((existing or {}).get("attempts") or 0),
            "last_error": "",
            "retry_after": 0,
        }
        if existing:
            existing.update(row)
        else:
            data["queue"].append(row)
        save_workshop(data)
    record_event("enqueue", tg_short_ref(repo, number), "в очереди")
    return {"ok": True, "queue": data["queue"]}


def queue_rm(repo: str, number: int) -> dict:
    with workshop_lock():
        data = load_workshop()
        kept = []
        removed = None
        for item in data["queue"]:
            if item["repo"] == repo and item["issue"] == number:
                if item.get("status") == "running" and tmux_alive(item.get("project") or ""):
                    die(f"{repo}#{number} ещё идёт")
                removed = item
                continue
            kept.append(item)
        if removed is None:
            die(f"not in queue: {repo}#{number}")
        data["queue"] = kept
        save_workshop(data)
    try:
        release_runner(repo, number)
    except Exception:
        remove_labels(repo, number, ["queued"])
    return {"ok": True, "queue": kept}


def queue_item(data: dict, repo: str, number: int) -> dict | None:
    for item in data.get("queue") or []:
        if item.get("repo") == repo and item.get("issue") == number:
            return item
    return None


def pin_owns_repo(repo: str, reg: dict | None = None) -> bool:
    try:
        registry = reg if reg is not None else load_registry()
    except Exception:
        return False
    return any(project.get("repo") == repo for project in pinned_projects(registry))


def queue_abort(repo: str, number: int, kill=None, release=None, notify=None) -> dict:
    kill = kill or tmux_kill
    release = release or release_runner
    notify = notify or notify_safe
    with workshop_lock():
        data = load_workshop()
        found = queue_item(data, repo, number)
        if found is None:
            return {"ok": True, "queue": data["queue"], "aborted": False}
        project = found.get("project") or ""
        others_running = any(
            item is not found
            and (item.get("project") or "") == project
            and item.get("status") == "running"
            for item in data["queue"]
        )
        data["queue"] = [item for item in data["queue"] if item is not found]
        save_workshop(data)
    if not others_running:
        kill(project)
    release(repo, number)
    record_event("abort", tg_short_ref(repo, number), "откатил")
    notify(tg_card(tg_short_ref(repo, number), "откатил"))
    return {"ok": True, "queue": data["queue"], "aborted": True}


@contextmanager
def workshop_json_override(path: Path):
    global WORKSHOP_JSON
    old = WORKSHOP_JSON
    WORKSHOP_JSON = path
    try:
        yield path
    finally:
        WORKSHOP_JSON = old


def run_autopilot_e2e() -> dict:
    """propose → approve → queue → reap → rollback. No gh, tmux, or paid agent."""
    tmp = Path(tempfile.mkdtemp(prefix="corp-e2e-")) / "workshop.json"
    released: list[tuple[str, int]] = []
    killed: list[str] = []
    reg = {
        "org": "andrewkazavchinskyy-cloud",
        "projects": [
            {
                "name": "corp",
                "repo": "andrewkazavchinskyy-cloud/corp",
                "workshop": True,
                "status": "active",
            }
        ],
    }
    fake_issue = {
        "state": "OPEN",
        "labels": [{"name": "in-progress"}, {"name": "via:claude"}],
        "title": "e2e sandbox",
        "url": "",
    }
    now = time.time()
    with workshop_json_override(tmp):
        save_workshop(default_workshop())
        draft = propose_draft(reg, "corp", "e2e sandbox card", "fixture only, do not file")
        drop_draft(draft["id"])
        data = load_workshop()
        data["queue_running"] = False
        data["queue"].append(
            {
                "repo": "andrewkazavchinskyy-cloud/corp",
                "issue": 0,
                "project": "corp",
                "title": draft["title"],
                "url": "",
                "profile": "claude",
                "kind": "claude",
                "model": "",
                "status": "running",
                "attempts": 1,
                "last_error": "",
                "retry_after": 0,
                "started_at": now - 120,
            }
        )
        save_workshop(data)
        events = reap_queue(
            data,
            now=now,
            tmux=lambda _name: False,
            fetch_issue=lambda _repo, _number: fake_issue,
            release=lambda repo, number: released.append((repo, number)),
        )
        save_workshop(data)
        after_reap = [dict(item) for item in data.get("queue") or []]
        queue_abort(
            "andrewkazavchinskyy-cloud/corp",
            0,
            kill=lambda name: killed.append(name),
            release=lambda repo, number: released.append((repo, number)),
            notify=lambda *_args, **_kwargs: None,
        )
        leftover = load_workshop().get("queue") or []
        drafts_left = load_workshop().get("drafts") or []
    return {
        "ok": True,
        "workshop": str(tmp),
        "draft_id": draft["id"],
        "drafts_after_approve": len(drafts_left),
        "reap_events": [
            {
                "kind": event["kind"],
                "status": event["item"].get("status"),
                "error": event["item"].get("last_error"),
            }
            for event in events
        ],
        "queue_after_reap": after_reap,
        "released": released,
        "killed": killed,
        "queue_after_rollback": leftover,
        "queue_running": False,
    }


def queue_retry(repo: str, number: int) -> dict:
    with workshop_lock():
        data = load_workshop()
        found = None
        for item in data["queue"]:
            if item["repo"] == repo and item["issue"] == number:
                found = item
                break
        if found is None:
            die(f"not in queue: {repo}#{number}")
        if found.get("status") == "running" and tmux_alive(found.get("project") or ""):
            die(f"{repo}#{number} ещё идёт")
        try:
            release_runner(repo, number)
        except Exception:
            pass
        latest = get_issue(repo, number)
        names = label_names(latest)
        if "in-qa" in names and "qa-fail" not in names:
            die(f"{repo}#{number} на QA")
        add_labels(repo, number, ["ready", "queued"])
        found["status"] = "waiting"
        found["last_error"] = ""
        found["retry_after"] = 0
        save_workshop(data)
    return {"ok": True, "queue": data["queue"]}


def queue_set_running(running: bool) -> dict:
    with workshop_lock():
        data = load_workshop()
        data["queue_running"] = running
        save_workshop(data)
    if not running:
        waiting = sum(1 for item in data.get("queue") or [] if item.get("status") == "waiting")
        extra = f" Ждут {waiting}." if waiting else ""
        tg_send(tg_screen("Пауза", [f"Очередь остановлена.{extra}"], "Ещё → Автоном, когда можно."))
    return {"ok": True, "queue_running": running, "queue": data["queue"]}


def queue_status() -> dict:
    data = load_workshop()
    try:
        registry = load_registry()
    except Exception:
        return data
    for item in data.get("queue") or []:
        if item.get("status") == "waiting":
            item["blocked_reason"] = pin_write_block(
                registry, item.get("project") or "", except_issue=item.get("issue")
            )
        else:
            item["blocked_reason"] = ""
    return data


def setup_token_ok(
    token: str,
    path: Path | None = None,
    now: float | None = None,
    ttl: int | None = None,
) -> bool:
    given = (token or "").strip()
    store = path or TOKEN_PATH
    expected = store.read_text().strip() if store.is_file() else ""
    if not expected or not given or len(given) != len(expected):
        return False
    if not secrets.compare_digest(given, expected):
        return False
    try:
        created = store.stat().st_mtime
    except OSError:
        return False
    stamp = time.time() if now is None else now
    limit = SETUP_TOKEN_TTL_SEC if ttl is None else ttl
    return 0 <= (stamp - created) <= limit


def workshop_token() -> str:
    config_dir()
    token = secrets.token_urlsafe(24)
    TOKEN_PATH.write_text(token + "\n")
    os.chmod(TOKEN_PATH, 0o600)
    print(token)
    print(
        "First register or recover (30 min): https://<tailscale-host>/?token=" + token,
        file=sys.stderr,
    )
    return token


def cmd_queue(reg: dict, args: argparse.Namespace) -> None:
    action = args.message or "status"
    if action == "status":
        print(json.dumps(queue_status(), indent=2))
        return
    if action == "start":
        print(json.dumps(queue_set_running(True), indent=2))
        return
    if action == "pause":
        print(json.dumps(queue_set_running(False), indent=2))
        return
    if action in {"add", "rm", "retry", "abort", "restart", "rollback"}:
        if not args.issue:
            die(f"usage: corp queue {action} --issue owner/repo#n")
        repo, number = parse_issue_ref(args.issue)
        if action == "add":
            if not args.profile:
                die("usage: corp queue add --issue owner/repo#n --profile id")
            print(json.dumps(queue_add(reg, repo, number, args.profile), indent=2))
            return
        if action in {"retry", "restart"}:
            print(json.dumps(queue_retry(repo, number), indent=2))
            return
        if action in {"abort", "rollback"}:
            print(json.dumps(queue_abort(repo, number), indent=2))
            return
        print(json.dumps(queue_rm(repo, number), indent=2))
        return
    if action == "e2e":
        print(json.dumps(run_autopilot_e2e(), indent=2, ensure_ascii=False))
        return
    die("usage: corp queue add|rm|retry|abort|restart|rollback|start|pause|status|e2e")


def main() -> None:
    parser = argparse.ArgumentParser(prog="corp", description="Corporation harness")
    parser.add_argument(
        "command",
        nargs="?",
        default="cycle",
        choices=[
            "bootstrap",
            "cycle",
            "pull",
            "status",
            "doctor",
            "notify",
            "run",
            "take",
            "close",
            "board",
            "move",
            "queue",
            "workshop-token",
            "catalog",
            "pin",
            "hide",
            "archive",
            "add-project",
            "create-project",
            "orchestrate",
            "draft",
            "stage",
            "council",
        ],
    )
    parser.add_argument("--project", help="project name")
    parser.add_argument("--repo", help="owner/repo")
    parser.add_argument("--draft", help="draft id")
    parser.add_argument("--action", choices=["approve", "skip"])
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--write", action="store_true", help="write memory/next.local.md")
    parser.add_argument("--all", action="store_true", help="bootstrap paused projects too")
    parser.add_argument("--issue", help="owner/repo#n")
    parser.add_argument("--agent", choices=list(KIND_BIN))
    parser.add_argument("--profile", help="workshop profile id")
    parser.add_argument("--column", choices=["backlog", "ready", "in-progress", "done"])
    parser.add_argument("--model")
    parser.add_argument("--effort")
    parser.add_argument("--fast", action="store_true")
    parser.add_argument("--force", action="store_true", help="close even if the card is not in QA")
    parser.add_argument("--fail", action="store_true", help="QA reject: ready + qa-fail")
    parser.add_argument("message", nargs="?", help="text for notify, or queue action")
    args = parser.parse_args()
    load_env()
    reg = load_registry()

    if args.command == "bootstrap":
        bootstrap(reg, include_paused=args.all)
        return
    if args.command == "pull":
        pull_projects(reg)
        return
    if args.command == "status":
        status(reg)
        return
    if args.command == "doctor":
        if args.json:
            print(json.dumps(doctor_payload(), indent=2))
        else:
            doctor()
        return
    if args.command == "notify":
        if not args.message:
            die("usage: corp notify 'text'")
        notify(args.message)
        return
    if args.command == "run":
        run_next(reg, args)
        return
    if args.command == "take":
        if not args.issue:
            die("usage: corp take --issue owner/repo#n")
        repo, number = parse_issue_ref(args.issue)
        result = take_issue(reg, repo, number)
        print(json.dumps(result, indent=2) if args.json else f"took {repo}#{number} as self")
        return
    if args.command == "close":
        if not args.issue:
            die("usage: corp close --issue owner/repo#n [--force|--fail]")
        repo, number = parse_issue_ref(args.issue)
        result = close_issue(reg, repo, number, force=args.force, fail=args.fail)
        if args.json:
            print(json.dumps(result, indent=2))
        elif result.get("qa_fail"):
            print(f"{repo}#{number} QA не принял")
        elif result.get("column") == "qa":
            print(f"{repo}#{number} -> qa (нужен --force чтобы закрыть без QA)")
        else:
            print(f"closed {repo}#{number} {result.get('graph') or ''}")
        return
    if args.command == "board":
        print(json.dumps(board_payload(reg), indent=2))
        return
    if args.command == "move":
        if not args.issue or not args.column:
            die("usage: corp move --issue owner/repo#n --column backlog|ready|in-progress|done")
        repo, number = parse_issue_ref(args.issue)
        result = move_issue(reg, repo, number, args.column)
        print(json.dumps(result, indent=2) if args.json else f"{repo}#{number} -> {args.column}")
        return
    if args.command == "queue":
        cmd_queue(reg, args)
        return
    if args.command == "workshop-token":
        workshop_token()
        return
    if args.command == "catalog":
        print(json.dumps(probe_catalog(), indent=2))
        return
    if args.command == "pin":
        if not args.project:
            die("usage: corp pin --project name")
        print(json.dumps(set_pin(reg, args.project, True), indent=2))
        return
    if args.command == "hide":
        if not args.project:
            die("usage: corp hide --project name")
        print(json.dumps(hide_project(reg, args.project), indent=2))
        return
    if args.command == "archive":
        if not args.project:
            die("usage: corp archive --project name")
        print(json.dumps(archive_project(reg, args.project), indent=2))
        return
    if args.command == "add-project":
        if not args.repo and not args.project:
            die("usage: corp add-project --repo org/name")
        print(json.dumps(add_existing(reg, args.repo or args.project), indent=2))
        return
    if args.command == "create-project":
        if not args.project:
            die("usage: corp create-project --project name")
        created = create_project(reg, args.project)
        print(json.dumps(created, indent=2))
        if created.get("next"):
            print(created["next"], file=sys.stderr)
        return
    if args.command == "orchestrate":
        repo = args.repo
        if not repo and args.project:
            repo = project_by_name(reg, args.project).get("repo")
        if not repo:
            die("usage: corp orchestrate --repo owner/name")
        print(json.dumps(orchestrate(reg, repo), indent=2))
        return
    if args.command == "draft":
        if not args.draft or not args.action:
            die("usage: corp draft --draft id --action approve|skip")
        fn = approve_draft if args.action == "approve" else skip_draft
        print(json.dumps(fn(args.draft), indent=2))
        return
    if args.command == "stage":
        if not args.project:
            die("usage: corp stage --project name")
        print(json.dumps(project_stage(reg, args.project), indent=2))
        return
    if args.command == "council":
        print(json.dumps(council_start(reg, args.project or args.message or ""), indent=2, ensure_ascii=False))
        return

    if args.command == "cycle":
        try:
            for row in reap_orphan_claims(reg):
                append_log(f"reaper: {json.dumps(row, ensure_ascii=False)}\n")
                tg_notify_event("need_human", tg_short_ref(row["repo"], row["number"]), "Reaper вернул карту в ready", action_ref=issue_ref(row["repo"], row["number"]))
        except Exception as exc:
            append_log(f"reaper failed: {exc}\n")
    payload = cycle_payload(reg)
    text = json.dumps(payload, indent=2) if args.json else render(payload)
    print(text, end="" if text.endswith("\n") else "\n")
    if args.write:
        path = write_next(text if not args.json else render(payload))
        print(f"wrote {path}", file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except CorpError as exc:
        print(exc, file=sys.stderr)
        raise SystemExit(exc.code)
