#!/usr/bin/env python3
"""Corporation harness. Needs git, gh, and Python 3. No extra packages."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REGISTRY_PATH = ROOT / "registry.json"
PRIORITY = ("P0", "P1", "P2")
ENV_PATHS = (
    Path(os.environ["CORP_ENV"]).expanduser() if os.environ.get("CORP_ENV") else None,
    Path.home() / ".config" / "corp" / "env",
    Path("/root/.config/corp/env"),
)
KIND_BIN = {"claude": "claude", "codex": "codex", "grok": "grok", "cursor": "agent"}
VIA = {kind: f"via:{kind}" for kind in KIND_BIN}
STATE_LABELS = ("ready", "blocked", "in-progress", "self", "queued", *VIA.values())
SEED_LABELS = (*STATE_LABELS, "P0", "P1", "P2", "design", "qa", "qa-fail")
SLOT_ROLES = ("orchestrator", "build", "design", "qa")
PULSE_SEC = 15 * 60
CONFIG_DIR = Path.home() / ".config" / "corp"
WORKSHOP_JSON = Path(os.environ["CORP_WORKSHOP_JSON"]) if os.environ.get("CORP_WORKSHOP_JSON") else CONFIG_DIR / "workshop.json"
WORKSHOP_LOCK = WORKSHOP_JSON.parent / (WORKSHOP_JSON.name + ".lock")
TOKEN_PATH = CONFIG_DIR / "workshop-setup-token"
RUN_LOG = CONFIG_DIR / "run.log"
RUNS_JSON = CONFIG_DIR / "runs.json"
RUNS_KEEP = 200
DEFAULT_PROFILES = [
    {"id": "claude", "kind": "claude", "label": "Claude", "model": "sonnet", "effort": "high", "fast": False},
    {"id": "codex", "kind": "codex", "label": "Codex", "model": "", "effort": "high", "fast": False},
    {"id": "grok", "kind": "grok", "label": "Grok", "model": "", "effort": "high", "fast": False},
    {"id": "cursor", "kind": "cursor", "label": "Cursor", "model": "", "effort": "", "fast": False},
]


class CorpError(Exception):
    def __init__(self, msg: str, code: int = 1) -> None:
        super().__init__(msg)
        self.code = code


def die(msg: str, code: int = 1) -> None:
    raise CorpError(msg, code)


def ensure_path() -> None:
    extras = [str(Path.home() / ".local" / "bin"), "/usr/local/bin"]
    parts = [p for p in os.environ.get("PATH", "").split(":") if p]
    os.environ["PATH"] = ":".join([p for p in extras if p not in parts] + parts)


def load_env() -> None:
    ensure_path()
    for path in ENV_PATHS:
        if path is None or not path.is_file():
            continue
        for raw in path.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))
        return


def _registry_overlay() -> dict:
    if not WORKSHOP_JSON.is_file():
        return {}
    try:
        return json.loads(WORKSHOP_JSON.read_text()).get("registry") or {}
    except (OSError, json.JSONDecodeError):
        return {}


def load_registry() -> dict:
    raw = json.loads(REGISTRY_PATH.read_text())
    extra = _registry_overlay()
    if not extra:
        return raw
    by_name = {p.get("name"): dict(p) for p in raw.get("projects") or [] if p.get("name")}
    for project in extra.get("projects") or []:
        name = project.get("name")
        if name:
            by_name[name] = {**by_name.get(name, {}), **project}
    pins = extra.get("pins") or {}
    projects = []
    seen = set()
    for project in list(raw.get("projects") or []) + list(extra.get("projects") or []):
        name = project.get("name")
        if not name or name in seen:
            continue
        row = by_name[name]
        if name in pins:
            row["workshop"] = bool(pins[name])
        projects.append(row)
        seen.add(name)
    out = dict(raw)
    out["projects"] = projects
    return out


def workspace() -> Path:
    env = os.environ.get("CORP_WORKSPACE")
    if env:
        return Path(env).expanduser()
    parent = ROOT.parent
    if parent.name in {"Github", "Developer", "repos", "src", "code"}:
        return parent
    return ROOT / "projects"


def expand(raw: str) -> Path:
    return Path(os.path.expanduser(raw))


def project_dir(project: dict) -> Path | None:
    for raw in project.get("roots") or []:
        path = expand(raw)
        if path.is_dir() and (path / ".git").exists():
            return path
    candidate = workspace() / project["name"]
    if candidate.is_dir() and (candidate / ".git").exists():
        return candidate
    return None


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, timeout: float | None = None) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, cwd=cwd, check=check, text=True, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else (exc.stdout or b"").decode()
        err = exc.stderr if isinstance(exc.stderr, str) else (exc.stderr or b"timeout").decode()
        return subprocess.CompletedProcess(cmd, 124, out or "", err or "timeout")


def have(cmd: str) -> bool:
    ensure_path()
    return shutil.which(cmd) is not None


def gh_ready() -> bool:
    if not have("gh"):
        return False
    return run(["gh", "auth", "status"], check=False).returncode == 0


def active_projects(reg: dict, include_paused: bool = False) -> list[dict]:
    out = []
    for project in reg.get("projects", []):
        if project.get("status") == "active" or include_paused:
            out.append(project)
    return out


def is_pinned(project: dict) -> bool:
    return bool(project.get("workshop"))


def pinned_projects(reg: dict) -> list[dict]:
    return [project for project in reg.get("projects", []) if is_pinned(project)]


def save_registry(reg: dict) -> None:
    invalidate_board()
    text = json.dumps(reg, indent=2) + "\n"
    try:
        REGISTRY_PATH.write_text(text)
        return
    except OSError:
        pass

    def mutate(data: dict) -> None:
        data["registry"] = {
            "pins": {p.get("name"): bool(p.get("workshop")) for p in reg.get("projects") or [] if p.get("name")},
            "projects": [dict(p) for p in reg.get("projects") or [] if p.get("name")],
        }

    update_workshop(mutate)


def org_name(reg: dict) -> str:
    return str(reg.get("org") or "andrewkazavchinskyy-cloud")


def bootstrap(reg: dict, include_paused: bool = False) -> None:
    if not have("git"):
        die("missing git")
    if not gh_ready():
        die("gh is missing or not logged in. Run: gh auth login")

    ws = workspace()
    ws.mkdir(parents=True, exist_ok=True)
    print(f"workspace: {ws}")

    if not have("graphify"):
        if have("uv"):
            print("installing graphify via uv")
            proc = run(["uv", "tool", "install", "graphifyy"], check=False)
            if proc.returncode != 0:
                print((proc.stderr or proc.stdout).strip())
        else:
            print("graphify not installed. Later: uv tool install graphifyy && graphify install")

    for project in active_projects(reg, include_paused=include_paused):
        dest = project_dir(project)
        if dest is None:
            dest = ws / project["name"]
            if dest.exists():
                print(f"skip clone {project['name']}: {dest} exists without .git")
                continue
            print(f"clone {project['repo']} -> {dest}")
            proc = run(["gh", "repo", "clone", project["repo"], str(dest)], check=False)
            if proc.returncode != 0:
                print((proc.stderr or proc.stdout).strip())
                continue
        else:
            print(f"pull {project['name']} ({dest})")
            proc = run(["git", "pull", "--ff-only"], cwd=dest, check=False)
            if proc.returncode != 0:
                print((proc.stderr or "git pull failed").strip())

        graph = dest / "graphify-out" / "GRAPH_REPORT.md"
        if not graph.exists():
            print(f"  no graphify-out yet. Later: cd {dest} && graphify .")

    print("bootstrap done. Next: ./bin/corp cycle")


def pull_projects(reg: dict) -> None:
    for project in active_projects(reg):
        dest = project_dir(project)
        if dest is None:
            print(f"missing {project['name']}")
            continue
        proc = run(["git", "pull", "--ff-only"], cwd=dest, check=False)
        status = "ok" if proc.returncode == 0 else (proc.stderr or "fail").strip()
        print(f"{project['name']}: {status}")


def issues_enabled(project: dict) -> bool:
    return project.get("issues", True)


def issues_for(repo: str, state: str = "open", limit: int = 50) -> list[dict]:
    proc = run(
        [
            "gh",
            "issue",
            "list",
            "-R",
            repo,
            "--state",
            state,
            "--limit",
            str(limit),
            "--json",
            "number,title,url,labels,updatedAt,state,closedAt",
        ],
        check=False,
    )
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout).strip()
        if "disabled issues" in err.lower():
            return []
        print(f"{repo}: {err}", file=sys.stderr)
        return []
    return json.loads(proc.stdout or "[]")


def label_names(issue: dict) -> set[str]:
    return {item.get("name", "") for item in issue.get("labels") or []}


def rank(issue: dict) -> tuple:
    names = label_names(issue)
    pri = 9
    for i, name in enumerate(PRIORITY):
        if name in names:
            pri = i
            break
    return (pri, issue.get("updatedAt") or "")


def project_by_name(reg: dict, name: str) -> dict:
    for project in reg.get("projects", []):
        if project["name"] == name:
            return project
    return {"name": name, "roots": []}


def project_by_repo(reg: dict, repo: str) -> dict:
    for project in reg.get("projects", []):
        if project.get("repo") == repo:
            return project
    die(f"repo not in registry: {repo}")


def collect_issues(reg: dict, skip_blocked: bool = True) -> list[dict]:
    blocked_label = reg.get("labels", {}).get("blocked", "blocked")
    found = []
    for project in pinned_projects(reg):
        if not issues_enabled(project):
            continue
        for issue in issues_for(project["repo"]):
            if skip_blocked and blocked_label in label_names(issue):
                continue
            found.append({**issue, "project": project["name"], "repo": project["repo"]})
    found.sort(key=rank)
    return found


def is_free_ready(issue: dict, reg: dict) -> bool:
    names = label_names(issue)
    ready = reg.get("labels", {}).get("ready", "ready")
    if ready not in names:
        return False
    if "in-progress" in names or "self" in names or "queued" in names:
        return False
    return True


def split_ready(reg: dict, issues: list[dict]) -> tuple[list[dict], list[dict]]:
    ready = [issue for issue in issues if is_free_ready(issue, reg)]
    other = [issue for issue in issues if issue not in ready]
    return ready, other


def research_report(reg: dict) -> list[dict]:
    files = reg.get("research_files") or []
    rows = []
    for project in pinned_projects(reg) or active_projects(reg):
        dest = project_dir(project)
        present = []
        if dest is not None:
            for rel in files:
                if (dest / rel).is_file():
                    present.append(rel)
        graph = bool(dest and (dest / "graphify-out" / "GRAPH_REPORT.md").is_file())
        rows.append(
            {
                "name": project["name"],
                "repo": project["repo"],
                "cwd": str(dest) if dest else None,
                "docs": present,
                "graphify": graph,
            }
        )
    return rows


def parse_graph_report(text: str) -> dict:
    out = {
        "nodes": 0,
        "edges": 0,
        "communities": 0,
        "hubs": [],
        "gods": [],
        "groups": [],
        "bridges": [],
        "fresh": "",
    }
    stats = re.search(r"(\d+)\s+nodes\s+·\s+(\d+)\s+edges\s+·\s+(\d+)\s+communities", text)
    if stats:
        out["nodes"] = int(stats.group(1))
        out["edges"] = int(stats.group(2))
        out["communities"] = int(stats.group(3))
    commit = re.search(r"Built from commit:\s+`([^`]+)`", text)
    if commit:
        out["fresh"] = commit.group(1)
    hubs = re.search(r"## Community Hubs.*?\n(?:- .+\n)+", text)
    if hubs:
        out["hubs"] = [line[2:].strip() for line in hubs.group(0).splitlines() if line.startswith("- ")][:12]
    for line in text.splitlines():
        god = re.search(r"^\d+\.\s+`([^`]+)`\s+-\s+(\d+)\s+edges", line)
        if god:
            out["gods"].append({"name": god.group(1), "edges": int(god.group(2))})
    for block in re.finditer(
        r'### Community \d+ - "([^"]+)"\s*\nCohesion:\s*([0-9.]+)\s*\nNodes \((\d+)\):\s*(.*)',
        text,
    ):
        raw = re.sub(r"\s*\(\+\d+ more\)\s*$", "", (block.group(4) or "").strip())
        names = [part.strip() for part in raw.split(",") if part.strip()][:16]
        out["groups"].append(
            {
                "name": block.group(1),
                "cohesion": float(block.group(2)),
                "size": int(block.group(3)),
                "nodes": names,
            }
        )
    out["bridges"] = [
        {"a": a, "rel": rel, "b": b}
        for a, rel, b in re.findall(r"- `([^`]+)` --(\w+)--> `([^`]+)`", text)
    ][:6]
    out["gods"] = out["gods"][:10]
    return out


def graphs_index(reg: dict) -> list[dict]:
    rows = []
    for project in active_projects(reg):
        dest = project_dir(project)
        report = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
        parsed = parse_graph_report(report.read_text()) if report and report.is_file() else parse_graph_report("")
        age = ""
        if report and report.is_file():
            age = time.strftime("%Y-%m-%d", time.localtime(report.stat().st_mtime))
        rows.append(
            {
                "name": project["name"],
                "repo": project.get("repo"),
                "pinned": is_pinned(project),
                "cwd": str(dest) if dest else None,
                "has_graph": bool(report and report.is_file()),
                "age": age,
                **parsed,
            }
        )
    rows.sort(key=lambda row: (not row["pinned"], not row["has_graph"], row["name"] or ""))
    return rows


def graph_detail(reg: dict, name: str) -> dict:
    project = project_by_name(reg, name)
    dest = project_dir(project)
    report = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
    if report is None or not report.is_file():
        return {
            "name": project["name"],
            "repo": project.get("repo"),
            "pinned": is_pinned(project),
            "cwd": str(dest) if dest else None,
            "has_graph": False,
            "age": "",
            **parse_graph_report(""),
        }
    parsed = parse_graph_report(report.read_text())
    parsed.update(
        {
            "name": project["name"],
            "repo": project.get("repo"),
            "pinned": is_pinned(project),
            "cwd": str(dest) if dest else None,
            "has_graph": True,
            "age": time.strftime("%Y-%m-%d", time.localtime(report.stat().st_mtime)),
        }
    )
    return parsed


def cycle_payload(reg: dict) -> dict:
    if not gh_ready():
        die("gh is missing or not logged in. Run: gh auth login")

    issues = collect_issues(reg)
    ready, other = split_ready(reg, issues)
    if ready:
        nxt = ready[0]
        dest = project_dir(project_by_name(reg, nxt["project"]))
        return {
            "mode": "execute",
            "next": {
                "repo": nxt["repo"],
                "issue": nxt["number"],
                "title": nxt["title"],
                "url": nxt["url"],
                "project": nxt["project"],
                "cwd": str(dest) if dest else None,
            },
            "ready": ready,
        }

    return {
        "mode": "research",
        "next": None,
        "open_unblocked": other[:20],
        "research": research_report(reg),
        "instruction": (
            "No ready Issues. Follow HARNESS.md research loop. "
            "File concrete ready Issues. Do not start greenfield work."
        ),
    }


def render(payload: dict) -> str:
    lines = ["=== CORP CYCLE ===", f"mode: {payload['mode']}"]
    nxt = payload.get("next")
    if nxt:
        lines += [
            "",
            "NEXT",
            f"repo: {nxt['repo']}",
            f"issue: #{nxt['issue']}",
            f"title: {nxt['title']}",
            f"url: {nxt['url']}",
            f"cwd: {nxt.get('cwd') or '(clone via ./bin/corp bootstrap)'}",
            "",
            "Take this Issue only after corp take (self) or a VPS launch.",
            "Do not invent other work. Skip NEXT if you already claimed another Issue.",
        ]
        extras = payload.get("ready") or []
        if len(extras) > 1:
            lines += ["", "QUEUE"]
            for item in extras[1:6]:
                lines.append(f"- {item['repo']}#{item['number']} {item['title']}")
        return "\n".join(lines) + "\n"

    lines += ["", "NEXT: research", "", payload.get("instruction", "")]
    open_items = payload.get("open_unblocked") or []
    if open_items:
        lines += ["", "OPEN (not labeled ready)"]
        for item in open_items[:10]:
            lines.append(f"- {item['repo']}#{item['number']} {item['title']}")
    lines += ["", "PROJECTS"]
    for row in payload.get("research") or []:
        docs = ", ".join(row["docs"]) if row["docs"] else "no planning docs"
        graph = "graphify yes" if row["graphify"] else "graphify no"
        cwd = row["cwd"] or "not cloned"
        lines.append(f"- {row['name']}: {cwd} | {graph} | {docs}")
    return "\n".join(lines) + "\n"


def write_next(text: str) -> Path:
    path = ROOT / "memory" / "next.local.md"
    path.write_text(text)
    return path


def status(reg: dict) -> None:
    print(f"workspace: {workspace()}")
    print(f"planner: {reg.get('planner')}")
    for project in reg.get("projects", []):
        dest = project_dir(project)
        mark = dest or "missing"
        print(f"{project['status']:7} {project['name']:28} {mark}")


def doctor_payload() -> dict:
    load_env()
    checks = [
        ("git", have("git")),
        ("gh", have("gh")),
        ("gh auth", gh_ready()),
        ("python3", have("python3")),
        ("uv", have("uv")),
        ("graphify", have("graphify")),
        ("claude", have("claude")),
        ("codex", have("codex")),
        ("grok", have("grok")),
        ("cursor", have("agent")),
        ("tmux", have("tmux")),
        ("telegram token", bool(os.environ.get("TELEGRAM_BOT_TOKEN"))),
        ("telegram chat", bool(os.environ.get("TELEGRAM_CHAT_ID"))),
    ]
    return {
        "corp": str(ROOT),
        "workspace": str(workspace()),
        "checks": [{"name": name, "ok": ok} for name, ok in checks],
    }


def doctor() -> None:
    payload = doctor_payload()
    print(f"corp: {payload['corp']}")
    print(f"workspace: {payload['workspace']}")
    for row in payload["checks"]:
        print(f"{'ok' if row['ok'] else 'NO':2}  {row['name']}")


def tg_creds() -> tuple[str, str]:
    load_env()
    return os.environ.get("TELEGRAM_BOT_TOKEN") or "", os.environ.get("TELEGRAM_CHAT_ID") or ""


def tg_post(method: str, payload: dict) -> dict:
    import urllib.parse
    import urllib.request

    token, _ = tg_creds()
    if not token:
        die("telegram not configured. Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in ~/.config/corp/env")
    url = f"https://api.telegram.org/bot{token}/{method}"
    body = urllib.parse.urlencode(payload).encode()
    try:
        raw = urllib.request.urlopen(url, data=body, timeout=20).read()
    except Exception as exc:
        die(f"telegram {method} failed: {exc}")
    return json.loads(raw.decode() or "{}")


def notify(text: str, buttons: list | None = None) -> None:
    _, chat = tg_creds()
    if not chat:
        die("telegram not configured. Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in ~/.config/corp/env")
    payload = {"chat_id": chat, "text": text, "disable_web_page_preview": "true"}
    if buttons:
        payload["reply_markup"] = json.dumps({"inline_keyboard": buttons})
    tg_post("sendMessage", payload)
    print("notified")


def notify_safe(text: str, buttons: list | None = None) -> None:
    try:
        notify(text, buttons=buttons)
    except (SystemExit, CorpError):
        print("telegram skipped", file=sys.stderr)


def config_dir() -> Path:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    return CONFIG_DIR


def default_slot() -> dict:
    return {"kind": "claude", "model": "", "effort": "high", "fast": False}


def default_workshop() -> dict:
    return {
        "profiles": [dict(item) for item in DEFAULT_PROFILES],
        "queue": [],
        "queue_running": False,
        "max_parallel": 3,
        "catalog": {},
        "slots": {},
        "drafts": [],
        "orch": {},
        "tg_offset": 0,
        "registry": {},
    }


def _parse_workshop(text: str) -> dict:
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        die(f"{WORKSHOP_JSON} is corrupt ({exc}); refusing to overwrite it with defaults")
    if not isinstance(data, dict):
        die(f"{WORKSHOP_JSON} is corrupt (expected a JSON object); refusing to overwrite it with defaults")
    data.setdefault("profiles", [dict(item) for item in DEFAULT_PROFILES])
    data.setdefault("queue", [])
    data.setdefault("queue_running", False)
    data.setdefault("max_parallel", 3)
    data.setdefault("catalog", {})
    data.setdefault("slots", {})
    data.setdefault("drafts", [])
    data.setdefault("orch", {})
    data.setdefault("tg_offset", 0)
    data.setdefault("registry", {})
    return data


def _read_workshop_raw() -> dict:
    if not WORKSHOP_JSON.is_file():
        return default_workshop()
    return _parse_workshop(WORKSHOP_JSON.read_text())


def _write_workshop(data: dict) -> None:
    WORKSHOP_JSON.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=".workshop-", suffix=".tmp", dir=str(WORKSHOP_JSON.parent))
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(data, indent=2) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp_name, 0o600)
        os.replace(tmp_name, WORKSHOP_JSON)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp_name)
        raise


@contextlib.contextmanager
def _workshop_file_lock():
    WORKSHOP_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(WORKSHOP_LOCK, "a+") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def load_workshop() -> dict:
    if not WORKSHOP_JSON.is_file():
        return update_workshop(lambda data: data)
    return _parse_workshop(WORKSHOP_JSON.read_text())


def save_workshop(data: dict) -> None:
    _write_workshop(data)


def update_workshop(mutate):
    """Atomic, interprocess-safe read-modify-write of workshop.json.

    Holds a lock file (separate from workshop.json itself) for the
    duration of the read + mutate + write. Never call this around network
    requests, agent launches, or tmux waits -- gather everything the
    mutation needs first, then call this with a fast, local mutate().

    `mutate(data)` changes `data` in place. Whatever it returns (including
    None) is returned as-is -- `mutate` must `return data` itself if the
    caller wants the full post-mutate dict back.
    """
    with _workshop_file_lock():
        data = _read_workshop_raw()
        result = mutate(data)
        _write_workshop(data)
        return result


def set_queue_status(repo: str, number: int, to: str, expect=None, **extra) -> dict | None:
    """Atomically move one queue row to a new status.

    Re-reads the row fresh under the lock, so a status already set by
    another process or an earlier step in the same tick is never clobbered
    by a stale in-memory snapshot. `expect` is a status or set of statuses
    the row must currently have; if it doesn't match (already claimed,
    already removed, row gone), this is a no-op and returns None.
    """
    expected = {expect} if isinstance(expect, str) else (set(expect) if expect else None)

    def mutate(data: dict) -> dict | None:
        for row in data["queue"]:
            if row.get("repo") == repo and row.get("issue") == number:
                if expected is not None and row.get("status") not in expected:
                    return None
                row["status"] = to
                row.update(extra)
                return row
        return None

    return update_workshop(mutate)


def profile_by_id(profile_id: str) -> dict:
    for item in load_workshop().get("profiles") or []:
        if item.get("id") == profile_id:
            return item
    die(f"unknown profile: {profile_id}")


def slots_for(name: str) -> dict:
    data = load_workshop()
    current = data.get("slots", {}).get(name) or {}
    out = {}
    for role in SLOT_ROLES:
        slot = dict(default_slot())
        slot.update(current.get(role) or {})
        if role in {"design", "qa"} and not current.get(role):
            slot = dict(out.get("build") or slot)
        out[role] = slot
    return out


def save_slots(name: str, slots: dict) -> dict:
    def mutate(data: dict) -> None:
        data.setdefault("slots", {})[name] = slots

    update_workshop(mutate)
    return slots


def slot_for_issue(name: str, issue: dict) -> tuple[str, dict]:
    names = label_names(issue)
    slots = slots_for(name)
    if "qa" in names and "design" not in names:
        return "qa", slots["qa"]
    if "design" in names:
        return "design", slots["design"]
    return "build", slots["build"]


def _help_text(binary: str) -> str:
    chunks = []
    for args in ([binary, "--help"],):
        proc = run(args, check=False, timeout=8)
        chunks.append(proc.stdout or "")
        chunks.append(proc.stderr or "")
    return "\n".join(chunks)


_MODEL_TOKEN = re.compile(r"^[A-Za-z][A-Za-z0-9._+-]{1,80}$")
_MODEL_SKIP = {
    "available", "default", "model", "models", "name", "id", "you", "the",
    "usage", "options", "commands", "arguments", "help", "logged", "with",
}
_MODEL_ALIASES = {"sonnet", "opus", "haiku", "fable", "composer"}
_MODEL_LIST = {
    "claude": [],
    "codex": [["codex", "debug", "models"]],
    "grok": [["grok", "models"]],
    "cursor": [["agent", "models"]],
}


def _looks_like_model(token: str) -> bool:
    if not _MODEL_TOKEN.match(token) or token.lower() in _MODEL_SKIP:
        return False
    if any(ch in token for ch in "/\\:"):
        return False
    low = token.lower()
    if low.startswith(("gpt-", "grok-", "claude-", "codex-")):
        return True
    return bool(any(ch.isdigit() for ch in token) or low in _MODEL_ALIASES)


def _models_from_json(text: str) -> tuple[list[str], list[str], bool]:
    start = text.find("{")
    if start < 0:
        start = text.find("[")
    if start < 0:
        return [], [], False
    try:
        payload = json.loads(text[start:])
    except json.JSONDecodeError:
        return [], [], False
    rows = payload.get("models") if isinstance(payload, dict) else payload
    if not isinstance(rows, list):
        return [], [], False
    models: list[str] = []
    efforts: list[str] = []
    fast = False
    for row in rows:
        if not isinstance(row, dict):
            continue
        if row.get("visibility") == "hide":
            continue
        slug = str(row.get("slug") or row.get("id") or row.get("model") or "")
        if _looks_like_model(slug) and slug not in models:
            models.append(slug)
        for item in row.get("supported_reasoning_levels") or []:
            effort = item.get("effort") if isinstance(item, dict) else ""
            if effort and effort not in efforts:
                efforts.append(str(effort))
        if row.get("additional_speed_tiers") or row.get("service_tiers"):
            fast = True
    return models[:40], efforts, fast


def _parse_models(text: str) -> list[str]:
    found = []
    for raw in text.splitlines():
        stripped = raw.strip()
        token = ""
        if stripped.startswith(("*", "•", "+")) or (stripped.startswith("- ") and not stripped.startswith("--")):
            line = stripped.lstrip("*•+").strip()
            if line.startswith("- "):
                line = line[2:].strip()
            token = (line.split() or [""])[0].strip("`,\"'()[]")
        elif stripped and " " not in stripped and not stripped.startswith("-"):
            token = stripped.strip("`,\"'()[]")
        if token and _looks_like_model(token) and token not in found:
            found.append(token)
    for token in re.findall(r"'([A-Za-z][A-Za-z0-9._+-]{1,60})'", text):
        if _looks_like_model(token) and token not in found:
            found.append(token)
    return found[:40]


def _parse_efforts(text: str) -> list[str]:
    order = ["low", "med", "medium", "high", "xhigh", "max"]
    for match in re.finditer(r"\(([^)]{0,80})\)", text.lower()):
        parts = [part.strip() for part in match.group(1).split(",")]
        hit = [name for name in order if name in parts]
        if len(hit) >= 2:
            if "medium" in hit and "med" in hit:
                hit = [name for name in hit if name != "med"]
            return hit
    return []


def probe_kind(kind: str) -> dict:
    binary = KIND_BIN[kind]
    row = {"kind": kind, "installed": have(binary), "models": [], "efforts": [], "fast": False, "stale": False}
    if not row["installed"]:
        return row
    help_text = _help_text(binary)
    help_l = help_text.lower()
    if "--effort" in help_l or "reasoning effort" in help_l:
        row["efforts"] = _parse_efforts(help_text) or ["low", "high"]
    if "service_tier" in help_l or re.search(r"--fast\b", help_l):
        row["fast"] = True
    models = _parse_models(help_text) if kind == "claude" else []
    for args in _MODEL_LIST.get(kind) or []:
        proc = run(args, cwd=Path.home(), check=False, timeout=20)
        raw = (proc.stdout or "") + "\n" + (proc.stderr or "")
        json_models, json_efforts, json_fast = _models_from_json(raw)
        if json_models:
            models = json_models
            if json_efforts:
                row["efforts"] = json_efforts
            if json_fast:
                row["fast"] = True
            break
        listed = _parse_models(raw)
        if listed:
            models = listed
            break
    row["models"] = models
    return row


def merge_catalog_row(prev: dict, row: dict) -> dict:
    old = prev or {}
    if row.get("installed") and not row.get("models") and old.get("models"):
        out = dict(old)
        out["stale"] = True
        out["installed"] = True
        return out
    return row


def probe_catalog() -> dict:
    prev = (load_workshop().get("catalog") or {}).get("kinds") or {}
    catalog = {}
    for kind in KIND_BIN:
        try:
            row = merge_catalog_row(prev.get(kind) or {}, probe_kind(kind))
        except Exception:
            row = dict(prev.get(kind) or {"kind": kind, "installed": False, "models": [], "efforts": [], "fast": False})
            row["stale"] = True
        catalog[kind] = row
    result = {"probed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "kinds": catalog}

    def mutate(data: dict) -> None:
        data["catalog"] = result

    update_workshop(mutate)
    return result


def load_catalog() -> dict:
    data = load_workshop()
    cached = data.get("catalog") or {}
    if cached.get("kinds"):
        return cached
    return probe_catalog()


def last_log_lines(n: int = 3, prefix: str = "") -> str:
    if not RUN_LOG.is_file():
        return "тишина"
    lines = [line.rstrip() for line in RUN_LOG.read_text().splitlines() if line.strip()]
    if prefix:
        tagged = [line for line in lines if line.startswith(prefix)]
        if tagged:
            lines = tagged
    if not lines:
        return "тишина"
    clipped = []
    for line in lines[-n:]:
        clipped.append(line[:200])
    return "\n".join(clipped)


def pulse_label(kind: str, model: str = "") -> str:
    return model or f"auto · {kind}"


def pulse_loop(repo: str, number: int, kind: str, started: float, stop: threading.Event, model: str = "") -> None:
    label = pulse_label(kind, model)
    prefix = issue_ref(repo, number)
    while not stop.wait(PULSE_SEC):
        mins = int((time.time() - started) / 60)
        notify_safe(f"{repo}#{number} · {mins} мин · {label}\n{last_log_lines(3, prefix=prefix)}")


def ensure_seed_labels(repo: str) -> None:
    for name in SEED_LABELS:
        ensure_label(repo, name)


def set_pin(reg: dict, name: str, pinned: bool) -> dict:
    project = project_by_name(reg, name)
    if not project.get("repo"):
        die(f"unknown project: {name}")
    project["workshop"] = pinned
    save_registry(reg)
    return project


def hide_project(reg: dict, name: str) -> dict:
    return set_pin(reg, name, False)


def archive_project(reg: dict, name: str) -> dict:
    project = project_by_name(reg, name)
    if not project.get("repo"):
        die(f"unknown project: {name}")
    proc = run(["gh", "repo", "archive", project["repo"], "--yes"], check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or "archive failed").strip())
    project["workshop"] = False
    project["status"] = "paused"
    save_registry(reg)
    return project


def org_repos(reg: dict) -> list[dict]:
    org = org_name(reg)
    pinned = {p.get("repo") for p in pinned_projects(reg)}
    found = {}
    for extra in ([], ["--archived"]):
        proc = run(
            ["gh", "repo", "list", org, "--limit", "200", "--json", "name,nameWithOwner,isArchived", *extra],
            check=False,
        )
        if proc.returncode != 0:
            die((proc.stderr or proc.stdout or "repo list failed").strip())
        for item in json.loads(proc.stdout or "[]"):
            repo = item.get("nameWithOwner") or f"{org}/{item.get('name')}"
            found[repo] = {
                "name": item.get("name") or repo.split("/")[-1],
                "repo": repo,
                "archived": bool(item.get("isArchived")),
                "pinned": repo in pinned,
            }
    rows = list(found.values())
    rows.sort(key=lambda row: (not row["pinned"], row["archived"], row["name"] or ""))
    return rows


def unarchive_project(reg: dict, repo: str) -> dict:
    org = org_name(reg)
    if "/" not in repo:
        repo = f"{org}/{repo}"
    if not repo.startswith(org + "/"):
        die(f"only {org} repos")
    view = run(["gh", "repo", "view", repo, "--json", "isArchived,nameWithOwner"], check=False)
    if view.returncode != 0:
        die((view.stderr or view.stdout or f"missing {repo}").strip())
    info = json.loads(view.stdout)
    if info.get("isArchived"):
        proc = run(["gh", "repo", "unarchive", repo, "--yes"], check=False)
        if proc.returncode != 0:
            die((proc.stderr or proc.stdout or "unarchive failed").strip())
    return add_existing(reg, repo)


def _clone_to_workspace(repo: str, name: str) -> Path:
    dest = workspace() / name
    if dest.is_dir() and (dest / ".git").exists():
        run(["git", "pull", "--ff-only"], cwd=dest, check=False)
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    proc = run(["gh", "repo", "clone", repo, str(dest)], check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or f"clone failed: {repo}").strip())
    return dest


def add_existing(reg: dict, repo: str) -> dict:
    org = org_name(reg)
    if "/" not in repo:
        repo = f"{org}/{repo}"
    if not repo.startswith(org + "/"):
        die(f"only {org} repos")
    view = run(["gh", "repo", "view", repo, "--json", "name,nameWithOwner"], check=False)
    if view.returncode != 0:
        die((view.stderr or f"missing {repo}").strip())
    info = json.loads(view.stdout)
    name = info.get("name") or repo.split("/")[-1]
    found = None
    for project in reg.get("projects", []):
        if project.get("repo") == repo or project.get("name") == name:
            found = project
            break
    if found is None:
        found = {"name": name, "repo": repo, "status": "active", "roots": []}
        reg["projects"].append(found)
    found["workshop"] = True
    found["status"] = "active"
    save_registry(reg)
    dest = _clone_to_workspace(repo, name)
    ensure_seed_labels(repo)
    return {"ok": True, "project": found, "cwd": str(dest)}


def create_project(reg: dict, name: str) -> dict:
    org = org_name(reg)
    if not name or "/" in name or name != name.strip():
        die("use a short repo name")
    repo = f"{org}/{name}"
    proc = run(["gh", "repo", "create", repo, "--private", "--description", "corp project"], check=False)
    if proc.returncode != 0 and "already exists" not in (proc.stderr or "").lower():
        die((proc.stderr or proc.stdout or "create failed").strip())
    dest = _clone_to_workspace(repo, name)
    readme = dest / "README.md"
    agents = dest / "AGENTS.md"
    if not readme.exists():
        readme.write_text(f"# {name}\n\nFollow the corp harness. See corp `AGENTS.md` and `HARNESS.md`.\n")
    if not agents.exists():
        agents.write_text(
            "Follow `corp/AGENTS.md` and `corp/HARNESS.md`.\n\n"
            "Take a `ready` GitHub Issue before inventing work. "
            "Never delete repos or rewrite Git history.\n"
        )
    run(["git", "add", "README.md", "AGENTS.md"], cwd=dest, check=False)
    run(["git", "commit", "-m", "corp: thin seed"], cwd=dest, check=False)
    run(["git", "push", "-u", "origin", "HEAD"], cwd=dest, check=False)
    ensure_seed_labels(repo)
    return add_existing(reg, repo)


def project_stage(reg: dict, name: str) -> dict:
    project = project_by_name(reg, name)
    dest = project_dir(project)
    cards = [c for c in board_payload(reg)["cards"] if c["project"] == name]
    open_cards = [c for c in cards if (c.get("state") or "OPEN").upper() != "CLOSED"]
    docs = []
    if dest:
        for rel in reg.get("research_files") or []:
            if (dest / rel).is_file():
                docs.append(rel)
    graph = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
    graph_age = ""
    if graph and graph.is_file():
        graph_age = time.strftime("%Y-%m-%d", time.localtime(graph.stat().st_mtime))
    has_spec = any(path.endswith(("SPEC.md", "PRD.md")) for path in docs)
    p0 = sum(1 for c in open_cards if any(l.get("name") == "P0" for l in c.get("labels") or []))
    ready_n = sum(1 for c in open_cards if c["column"] == "ready")
    doing = sum(1 for c in open_cards if c["column"] == "in-progress")
    if not has_spec:
        stage = "нет спеки"
    elif p0:
        stage = "горит"
    elif doing:
        stage = "в работе"
    elif ready_n:
        stage = "строим"
    else:
        stage = "спокойно"
    return {
        "name": name,
        "repo": project.get("repo"),
        "stage": stage,
        "open": len(open_cards),
        "ready": ready_n,
        "p0": p0,
        "in_progress": doing,
        "docs": docs,
        "graph_age": graph_age,
        "cwd": str(dest) if dest else None,
    }


def new_draft(
    repo: str,
    title: str,
    body: str,
    label: str,
    kind: str = "build",
    why: str = "",
    vs_prd: str = "",
    vs_open: str = "",
) -> dict:
    if label not in {"ready", "blocked"}:
        label = "blocked"
    draft = {
        "id": secrets.token_hex(4),
        "repo": repo,
        "title": title.strip(),
        "body": body.strip(),
        "why": (why or "").strip(),
        "vs_prd": (vs_prd or "").strip(),
        "vs_open": (vs_open or "").strip(),
        "label": label,
        "kind": kind if kind in {"build", "design", "qa"} else "build",
        "created": time.time(),
    }
    update_workshop(lambda data: data["drafts"].append(draft))
    invalidate_board()
    return draft


def draft_issue_body(draft: dict) -> str:
    parts = [draft.get("body") or draft.get("title") or ""]
    if draft.get("why"):
        parts.append(f"## Зачем\n{draft['why']}")
    if draft.get("vs_prd"):
        parts.append(f"## В спеке\n{draft['vs_prd']}")
    if draft.get("vs_open"):
        parts.append(f"## Уже на доске\n{draft['vs_open']}")
    return "\n\n".join(parts).strip()


def prune_drafts() -> None:
    now = time.time()

    def mutate(data: dict) -> None:
        data["drafts"] = [d for d in data["drafts"] if now - float(d.get("created") or 0) < 7 * 86400]

    update_workshop(mutate)


def draft_by_id(draft_id: str) -> dict:
    prune_drafts()
    for item in load_workshop().get("drafts") or []:
        if item.get("id") == draft_id:
            return item
    die(f"draft not found: {draft_id}")


def drop_draft(draft_id: str) -> None:
    def mutate(data: dict) -> None:
        data["drafts"] = [d for d in data["drafts"] if d.get("id") != draft_id]

    update_workshop(mutate)


def approve_draft(draft_id: str) -> dict:
    draft = draft_by_id(draft_id)
    labels = [draft.get("label") or "blocked"]
    if draft.get("kind") in {"design", "qa"}:
        labels.append(draft["kind"])
    args = [
        "gh", "issue", "create", "-R", draft["repo"],
        "--title", draft["title"],
        "--body", draft_issue_body(draft),
        "--label", ",".join(labels),
    ]
    proc = run(args, check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or "create issue failed").strip())
    drop_draft(draft_id)
    url = (proc.stdout or "").strip()
    invalidate_board()
    notify_safe(f"{draft['repo']} · завёл · {draft['title']}\n{url}")
    return {"ok": True, "url": url, "draft": draft}


def skip_draft(draft_id: str) -> dict:
    draft = draft_by_id(draft_id)
    drop_draft(draft_id)
    return {"ok": True, "skipped": draft_id, "title": draft.get("title")}


def orch_session(project: str) -> str:
    return f"corp-orch-{project}"


def orch_spec_rels(dest: Path | None, research_files: list[str] | None = None) -> list[str]:
    if dest is None or not dest.is_dir():
        return []
    names = list(research_files or [])
    for rel in ("docs/PRD.md", "docs/SPEC.md", "docs/SHIP.md", "docs/roadmap.md", "PRD.md", "SPEC.md"):
        if rel not in names:
            names.append(rel)
    return [rel for rel in names if (dest / rel).is_file()]


def orch_open_lines(cards: list, project: str) -> str:
    rows = []
    for card in cards:
        if card.get("project") != project:
            continue
        if (card.get("state") or "OPEN").upper() == "CLOSED":
            continue
        rows.append(f"#{card.get('number')} [{card.get('column')}] {card.get('title') or ''}")
    return "\n".join(rows[:40]) or "(none)"


def orch_workshop_extra(project: str) -> str:
    if project != "corp":
        return ""
    return (
        " This repo is the live workshop. Also propose drafts that expand its "
        "function and push UI/UX/design of workshop/static as far as phone and "
        "desktop will go. Read workshop/preview.html as a reference, not a dump. "
        "Keep Passkey, Tailscale, the pin list, and GitHub as planner. "
        "Use kind=design for visual/UX cards and kind=build for behavior. "
    )


def orch_prompt(dest: Path, out: Path, spec_rels: list[str], open_lines: str, project: str = "") -> str:
    spec = ", ".join(spec_rels) or "NONE"
    prd = next((rel for rel in spec_rels if rel.endswith("PRD.md") or rel.endswith("SPEC.md")), "")
    source = prd or spec
    return (
        f"Read-only review of {dest}. Follow {ROOT}/docs/WORKSHOP.md. "
        f"You are the project orchestrator. Compare three things:\n"
        f"1) The product spec in the repo (prefer PRD, else SPEC): {source}. "
        f"Also read: {spec}.\n"
        f"2) What is already shipped: code, README, graphify-out/GRAPH_REPORT.md, closed work.\n"
        f"3) Open GitHub issues already on the board (do not duplicate these):\n{open_lines}\n"
        f"Propose NEW drafts only for PRD/SPEC work that is not shipped and not already an open issue. "
        f"Each draft is a concrete follow-up against that spec. "
        f"{orch_workshop_extra(project)}"
        f"If there is no PRD/SPEC, output one draft titled 'написать SPEC'. "
        f"No new product ideas. No code. No git writes. "
        f"Do not run git commit, git push, or edit files in {dest}. "
        f"Draft titles and bodies in Russian. Each item needs details for human Approve: "
        f"body (full issue text), why, vs_prd (what in the spec this covers), "
        f"vs_open (why it is not a duplicate of an open card). "
        f"Print a JSON array to stdout. You may also write it to {out} "
        f"(outside the repo) as "
        f'[{{"title":"...","body":"...","why":"...","vs_prd":"...","vs_open":"...","label":"ready|blocked","kind":"build|design|qa"}}].'
    )


def orchestrate(reg: dict, repo: str) -> dict:
    project = project_by_repo(reg, repo)
    dest = project_dir(project)
    if dest is None:
        die(f"project not cloned: {project['name']}")
    slot = slots_for(project["name"])["orchestrator"]
    kind = slot.get("kind") or "claude"
    if not have(KIND_BIN[kind]):
        die(f"{kind} CLI is not installed")
    session = orch_session(project["name"])
    prefix = f"orch {project['name']}"
    if have("tmux") and tmux_has(session):
        die(f"already running: tmux {session}")
    set_orch_state(project["name"], "running", kind=kind, started=time.time())
    drafts = []
    try:
        cards = board_payload(reg)["cards"]
        if "self" in {
            runner_of(card)
            for card in cards
            if card["project"] == project["name"] and card["column"] == "in-progress"
        }:
            die(f"{project['name']} is claimed as self")
        out = config_dir() / f"orch-{project['name']}.json"
        prompt = orch_prompt(
            dest,
            out,
            orch_spec_rels(dest, reg.get("research_files") or []),
            orch_open_lines(cards, project["name"]),
            project["name"],
        )
        cmd = agent_argv(
            kind,
            prompt,
            dest,
            model=slot.get("model") or "",
            effort=slot.get("effort") or "",
            fast=bool(slot.get("fast")),
            readonly=True,
        )
        if have("tmux"):
            pipe = (
                f"{shlex.join(cmd)} 2>&1 | while IFS= read -r line || [ -n \"$line\" ]; do "
                f"printf '%s %s\\n' {shlex.quote(prefix)} \"$line\"; done"
            )
            script = f"cd {shlex.quote(str(dest))} && {pipe} | tee -a {shlex.quote(str(RUN_LOG))}"
            subprocess.run(["tmux", "new-session", "-d", "-s", session, "bash", "-lc", script], check=False)
            while tmux_has(session):
                time.sleep(3)
        else:
            subprocess.run(cmd, cwd=dest, check=False)
        payload = []
        if out.is_file():
            payload = parse_json_array(out.read_text())
        if not payload and RUN_LOG.is_file():
            payload = parse_json_array(RUN_LOG.read_text()[-20000:])
        for item in payload[:12]:
            if not isinstance(item, dict) or not item.get("title"):
                continue
            drafts.append(
                new_draft(
                    repo,
                    item.get("title") or "",
                    item.get("body") or "",
                    item.get("label") or "blocked",
                    item.get("kind") or "build",
                    why=item.get("why") or "",
                    vs_prd=item.get("vs_prd") or "",
                    vs_open=item.get("vs_open") or "",
                )
            )
        if not drafts:
            stage = project_stage(reg, project["name"])
            if stage["stage"] == "нет спеки":
                drafts.append(new_draft(repo, "написать SPEC", "В репо нет SPEC/PRD. Написать минимальную спеку.", "ready", "build"))
        set_orch_state(project["name"], "done", drafts=len(drafts), kind=kind)
    except Exception:
        set_orch_state(project["name"], "failed", drafts=len(drafts), kind=kind)
        raise
    buttons = [[{"text": f"Approve {d['title'][:24]}", "callback_data": f"a:{d['id']}"}, {"text": "Skip", "callback_data": f"s:{d['id']}"}] for d in drafts]
    notify_safe(f"{project['name']} · {len(drafts)} черновиков оркестратора", buttons=buttons or None)
    return {"ok": True, "drafts": drafts, "stage": project_stage(reg, project["name"])}


def maybe_orchestrate(reg: dict, name: str) -> None:
    cards = [c for c in board_payload(reg)["cards"] if c["project"] == name and (c.get("state") or "OPEN").upper() != "CLOSED"]
    if any(c["column"] in {"ready", "in-progress"} for c in cards):
        return
    project = project_by_name(reg, name)
    if project.get("repo"):
        try:
            orchestrate(reg, project["repo"])
        except CorpError as exc:
            append_log(f"orchestrate skip {name}: {exc}\n")


def set_tg_offset(offset: int) -> None:
    def mutate(data: dict) -> None:
        data["tg_offset"] = int(offset)

    update_workshop(mutate)


def parse_json_array(text: str) -> list:
    raw = (text or "").strip()
    if not raw:
        return []
    try:
        payload = json.loads(raw)
        return payload if isinstance(payload, list) else []
    except json.JSONDecodeError:
        pass
    start = raw.rfind("[")
    end = raw.rfind("]")
    if start < 0 or end <= start:
        return []
    try:
        payload = json.loads(raw[start : end + 1])
    except json.JSONDecodeError:
        return []
    return payload if isinstance(payload, list) else []


def telegram_tick() -> None:
    token, chat = tg_creds()
    if not token or not chat:
        return
    import urllib.request

    offset = int(load_workshop().get("tg_offset") or 0)
    url = f"https://api.telegram.org/bot{token}/getUpdates?timeout=0&offset={offset}"
    try:
        raw = urllib.request.urlopen(url, timeout=15).read()
    except Exception:
        return
    payload = json.loads(raw.decode() or "{}")
    new_offset = offset
    for upd in payload.get("result") or []:
        new_offset = int(upd.get("update_id") or 0) + 1
        cb = upd.get("callback_query") or {}
        msg_chat = str(((cb.get("message") or {}).get("chat") or {}).get("id") or "")
        if msg_chat != str(chat):
            continue
        code = (cb.get("data") or "")
        if code.startswith("a:"):
            try:
                approve_draft(code[2:])
            except CorpError as exc:
                notify_safe(str(exc))
        elif code.startswith("s:"):
            try:
                skip_draft(code[2:])
            except CorpError as exc:
                notify_safe(str(exc))
        if cb.get("id"):
            try:
                tg_post("answerCallbackQuery", {"callback_query_id": cb["id"]})
            except CorpError:
                pass
    if new_offset != offset:
        set_tg_offset(new_offset)


def parse_issue_ref(raw: str) -> tuple[str, int]:
    text = (raw or "").strip()
    if "#" not in text:
        die("use --issue owner/repo#n")
    repo, number = text.rsplit("#", 1)
    if not repo or not number.isdigit():
        die("use --issue owner/repo#n")
    return repo, int(number)


def issue_ref(repo: str, number: int) -> str:
    return f"{repo}#{number}"


def get_issue(repo: str, number: int) -> dict:
    proc = run(
        [
            "gh",
            "issue",
            "view",
            str(number),
            "-R",
            repo,
            "--json",
            "number,title,url,labels,state,updatedAt,closedAt",
        ],
        check=False,
    )
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or f"missing {repo}#{number}").strip())
    return json.loads(proc.stdout)


def ensure_label(repo: str, name: str) -> None:
    proc = run(["gh", "label", "create", name, "-R", repo], check=False)
    if proc.returncode != 0 and "already exists" not in (proc.stderr or "").lower():
        # older gh prints different text; ignore if label is usable
        view = run(["gh", "label", "list", "-R", repo, "--json", "name"], check=False)
        names = {item.get("name") for item in json.loads(view.stdout or "[]")}
        if name not in names:
            print(f"label {name} on {repo}: {(proc.stderr or '').strip()}", file=sys.stderr)


def add_labels(repo: str, number: int, labels: list[str]) -> None:
    if not labels:
        return
    for name in labels:
        ensure_label(repo, name)
    run(["gh", "issue", "edit", str(number), "-R", repo, "--add-label", ",".join(labels)], check=False)


def remove_labels(repo: str, number: int, labels: list[str]) -> None:
    if not labels:
        return
    run(["gh", "issue", "edit", str(number), "-R", repo, "--remove-label", ",".join(labels)], check=False)


def comment(repo: str, number: int, body: str) -> None:
    run(["gh", "issue", "comment", str(number), "-R", repo, "--body", body], check=False)


def assign_me(repo: str, number: int) -> None:
    run(["gh", "issue", "edit", str(number), "-R", repo, "--add-assignee", "@me"], check=False)


def runner_of(issue: dict) -> str:
    names = label_names(issue)
    if "self" in names:
        return "self"
    for kind, label in VIA.items():
        if label in names:
            return kind
    if "queued" in names:
        return "queued"
    return ""


def column_of(issue: dict) -> str:
    state = (issue.get("state") or "OPEN").upper()
    if state == "CLOSED":
        return "done"
    names = label_names(issue)
    if "in-progress" in names:
        return "in-progress"
    if "ready" in names:
        return "ready"
    return "backlog"


_board_memo = {"t": 0.0, "key": "", "data": None}


def invalidate_board() -> None:
    _board_memo["t"] = 0
    _board_memo["data"] = None


def board_payload(reg: dict) -> dict:
    cache_key = ",".join(p["name"] for p in pinned_projects(reg))
    now = time.time()
    if _board_memo["data"] is not None and _board_memo["key"] == cache_key and now - _board_memo["t"] < 20:
        return _board_memo["data"]
    cards = []
    for project in pinned_projects(reg):
        if not issues_enabled(project):
            continue
        open_issues = issues_for(project["repo"], "open", 80)
        closed = issues_for(project["repo"], "closed", 20)
        seen = set()
        for issue in open_issues + closed:
            number = issue.get("number")
            if number in seen:
                continue
            seen.add(number)
            row = {
                **issue,
                "project": project["name"],
                "repo": project["repo"],
                "column": column_of(issue),
                "runner": runner_of(issue),
                "queued": "queued" in label_names(issue),
                "blocked": "blocked" in label_names(issue),
            }
            cards.append(row)
    cards.sort(key=lambda item: (item["column"], rank(item)))
    pins = [{"name": p["name"], "repo": p.get("repo")} for p in pinned_projects(reg)]
    drafts = draft_summaries(reg)
    payload = {"cards": cards, "projects": research_report(reg), "pins": pins, "drafts": drafts}
    _board_memo.update({"t": time.time(), "key": cache_key, "data": payload})
    return payload


def draft_summaries(reg: dict) -> list[dict]:
    prune_drafts()
    pins = {p["repo"]: p["name"] for p in pinned_projects(reg)}
    out = []
    for item in load_workshop().get("drafts") or []:
        repo = item.get("repo") or ""
        out.append({
            "id": item.get("id") or "",
            "repo": repo,
            "title": item.get("title") or "",
            "project": pins.get(repo) or repo.rsplit("/", 1)[-1],
        })
    return out


def next_move(cards: list, drafts: list, project: str | None = None) -> dict | None:
    vis = [c for c in cards if not project or c.get("project") == project]
    if any(c.get("column") == "ready" for c in vis):
        return None
    vis_d = [d for d in drafts if not project or d.get("project") == project]
    if vis_d:
        return {"kind": "drafts", "count": len(vis_d), "project": vis_d[0].get("project") or ""}
    backlog = [c for c in vis if c.get("column") == "backlog" and not c.get("blocked")]
    if backlog:
        card = backlog[0]
        return {
            "kind": "backlog",
            "issue": f"{card.get('repo')}#{card.get('number')}",
            "title": card.get("title") or "",
            "project": card.get("project") or "",
        }
    return {"kind": "orch", "project": project or ""}


def write_block_reason(cards: list, project_name: str, except_issue: int | None = None) -> str:
    for card in cards:
        if card.get("project") != project_name:
            continue
        if (card.get("state") or "OPEN").upper() == "CLOSED":
            continue
        if except_issue is not None and card.get("number") == except_issue:
            continue
        if card.get("runner") == "self":
            return f"{project_name} is claimed as self"
        if card.get("column") == "in-progress" and card.get("runner") not in {"", "self", "queued"}:
            return f"VPS is writing {project_name}"
    return ""


def pin_write_block(reg: dict, project_name: str, except_issue: int | None = None) -> str:
    return write_block_reason(board_payload(reg)["cards"], project_name, except_issue)


def vps_owns_project(reg: dict, project_name: str, except_issue: int | None = None) -> bool:
    return pin_write_block(reg, project_name, except_issue).startswith("VPS")


def tmux_session(project: str) -> str:
    return f"corp-run-{project}"


def tmux_has(session: str) -> bool:
    if not have("tmux"):
        return False
    return run(["tmux", "has-session", "-t", session], check=False).returncode == 0


def tmux_alive(project: str) -> bool:
    return tmux_has(tmux_session(project))


def orch_alive(project: str) -> bool:
    return tmux_has(orch_session(project))


def capture_pane(session: str, lines: int = 80) -> str:
    if not tmux_has(session):
        return ""
    proc = subprocess.run(
        ["tmux", "capture-pane", "-pt", session, "-S", f"-{int(lines)}"],
        text=True,
        capture_output=True,
    )
    return proc.stdout or ""


def set_orch_state(name: str, status: str, **extra) -> dict:
    def mutate(data: dict) -> dict:
        row = dict((data.get("orch") or {}).get(name) or {})
        row.update(extra)
        row["status"] = status
        row["updated"] = time.time()
        data.setdefault("orch", {})[name] = row
        return row

    return update_workshop(mutate)


def orch_status(name: str) -> dict:
    row = dict((load_workshop().get("orch") or {}).get(name) or {})
    alive = orch_alive(name)
    row["running"] = alive or row.get("status") == "running"
    if alive:
        row["status"] = "running"
        row["pane"] = capture_pane(orch_session(name), 60)
    else:
        row["pane"] = ""
    row["log"] = last_log_lines(12, prefix=f"orch {name}")
    if row["log"] == "тишина" and RUN_LOG.is_file() and row["running"]:
        row["log"] = last_log_lines(8)
    return row


def claim(repo: str, number: int, kind: str, note: str) -> None:
    via_all = list(VIA.values())
    remove_labels(repo, number, ["ready", "queued", "self", *via_all])
    add_labels(repo, number, ["in-progress", "self"] if kind == "self" else ["in-progress", VIA[kind]])
    assign_me(repo, number)
    comment(repo, number, note)
    invalidate_board()


def take_issue(reg: dict, repo: str, number: int) -> dict:
    project = project_by_repo(reg, repo)
    issue = get_issue(repo, number)
    if (issue.get("state") or "").upper() == "CLOSED":
        die(f"{repo}#{number} is closed")
    blocked = pin_write_block(reg, project["name"], except_issue=number)
    if blocked:
        die(blocked)
    claim(repo, number, "self", "corp-claim: self")
    invalidate_board()
    return {"ok": True, "repo": repo, "issue": number, "runner": "self"}


def refresh_graph(dest: Path, repo: str, number: int) -> str:
    if not dest.is_dir():
        return "no checkout"
    run(["git", "pull", "--ff-only"], cwd=dest, check=False)
    if have("graphify"):
        proc = run(["graphify", "update", "."], cwd=dest, check=False)
        if proc.returncode != 0:
            run(["graphify", "."], cwd=dest, check=False)
    status = run(["git", "status", "--porcelain", "--", "graphify-out"], cwd=dest, check=False)
    if not (status.stdout or "").strip():
        return "graph unchanged"
    run(["git", "add", "--", "graphify-out"], cwd=dest, check=False)
    run(["git", "reset", "-q", "--", "graphify-out/cache"], cwd=dest, check=False)
    commit = run(
        ["git", "commit", "-m", f"graphify: refresh after {repo}#{number}"],
        cwd=dest,
        check=False,
    )
    if commit.returncode != 0:
        return "graph commit skipped"
    push = run(["git", "push"], cwd=dest, check=False)
    return "graph pushed" if push.returncode == 0 else "graph committed, push failed"


def close_issue(reg: dict, repo: str, number: int) -> dict:
    project = project_by_repo(reg, repo)
    dest = project_dir(project)
    proc = run(["gh", "issue", "close", str(number), "-R", repo], check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout).strip())
    graph = refresh_graph(dest, repo, number) if dest else "no checkout"
    invalidate_board()
    maybe_orchestrate(reg, project["name"])
    return {"ok": True, "repo": repo, "issue": number, "graph": graph}


def move_issue(reg: dict, repo: str, number: int, column: str) -> dict:
    if column not in {"backlog", "ready", "in-progress", "done"}:
        die("column must be backlog|ready|in-progress|done")
    if column == "done":
        return close_issue(reg, repo, number)
    issue = get_issue(repo, number)
    if (issue.get("state") or "").upper() == "CLOSED":
        run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
    via_all = list(VIA.values())
    if column == "backlog":
        remove_labels(repo, number, ["ready", "in-progress", "self", "queued", *via_all])
    elif column == "ready":
        remove_labels(repo, number, ["in-progress", "self", "queued", *via_all])
        add_labels(repo, number, ["ready"])
    else:
        add_labels(repo, number, ["in-progress"])
        remove_labels(repo, number, ["ready"])
    invalidate_board()
    return {"ok": True, "repo": repo, "issue": number, "column": column}


def pick_agent() -> str:
    load_env()
    preferred = os.environ.get("CORP_AGENT", "").strip()
    if preferred:
        kind = preferred if preferred in KIND_BIN else next((k for k, b in KIND_BIN.items() if b == preferred), "")
        binary = KIND_BIN.get(kind, preferred)
        if not have(binary):
            die(f"CORP_AGENT={preferred} is not installed")
        return kind or preferred
    for kind, binary in KIND_BIN.items():
        if have(binary):
            return kind
    die("no agent CLI found. Install claude, codex, grok, or cursor agent")


def agent_prompt(repo: str, number: int, title: str, url: str, dest: Path, project: str = "") -> str:
    workshop = ""
    if project == "corp" or dest.resolve() == ROOT.resolve():
        workshop = (
            " This is the live workshop. Within this issue, expand useful function "
            "and push workshop/static UI/UX on phone and desktop as far as it will go. "
            "workshop/preview.html is a reference, not a wholesale port. "
            "Keep Passkey, Tailscale, pins, and GitHub as planner. No new product repo."
        )
    return (
        f"Follow {ROOT}/AGENTS.md and {ROOT}/HARNESS.md "
        f"(on the VPS that is /opt/corp/AGENTS.md and /opt/corp/HARNESS.md). "
        f"Do only this GitHub Issue and nothing else: {repo}#{number} {title} {url}. "
        f"Work in {dest}. Control plane is {ROOT}. "
        f"{workshop} "
        f"If graphify-out/GRAPH_REPORT.md exists, read it, then run "
        f'`graphify query` for this issue before broad file reads. '
        f"Commit and push in this product repo. After the issue is closed, "
        f"graphify update will run — do not rebuild the whole graph yourself unless missing. "
        f"Never rewrite git history."
    )


def agent_argv(kind: str, prompt: str, dest: Path, model: str = "", effort: str = "", fast: bool = False, readonly: bool = False) -> list[str]:
    workspace_root = workspace()
    if readonly:
        if kind == "claude":
            cmd = [
                "claude",
                "-p",
                prompt,
                "--allowedTools",
                "Read,Glob,Grep,WebFetch",
                "--add-dir",
                str(dest),
                "--add-dir",
                str(workspace_root),
                "--add-dir",
                str(ROOT),
            ]
            if model:
                cmd += ["--model", model]
            if effort:
                cmd += ["--effort", "low" if fast and not effort else effort]
            elif fast:
                cmd += ["--effort", "low"]
            return cmd
        if kind == "codex":
            cmd = ["codex", "exec", "--sandbox", "read-only", "--ask-for-approval", "never"]
            if model:
                cmd += ["--model", model]
            if effort:
                cmd += ["-c", f"model_reasoning_effort={effort}"]
            if fast:
                cmd += ["-c", "service_tier=fast"]
            cmd.append(prompt)
            return cmd
        die(f"{kind} has no read-only sandbox for orchestrator")
    if kind == "claude":
        cmd = [
            "claude",
            "-p",
            prompt,
            "--dangerously-skip-permissions",
            "--add-dir",
            str(dest),
            "--add-dir",
            str(workspace_root),
            "--add-dir",
            str(ROOT),
        ]
        if model:
            cmd += ["--model", model]
        if effort:
            cmd += ["--effort", "low" if fast and not effort else effort]
        elif fast:
            cmd += ["--effort", "low"]
        return cmd
    if kind == "codex":
        cmd = ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox"]
        if model:
            cmd += ["--model", model]
        if effort:
            cmd += ["-c", f"model_reasoning_effort={effort}"]
        if fast:
            cmd += ["-c", "service_tier=fast"]
        cmd.append(prompt)
        return cmd
    if kind == "grok":
        cmd = ["grok", "-p", prompt, "--permission-mode", "auto"]
        if model:
            cmd += ["--model", model]
        if effort:
            cmd += ["--effort", "low" if fast else effort]
        elif fast:
            cmd += ["--effort", "low"]
        return cmd
    if kind == "cursor":
        cmd = ["agent", "-p", prompt, "--force", "--trust", "--workspace", str(dest)]
        if model:
            cmd += ["--model", model]
        return cmd
    die(f"unknown agent {kind}")


def append_log(text: str) -> None:
    config_dir()
    with RUN_LOG.open("a") as handle:
        handle.write(text)
        if not text.endswith("\n"):
            handle.write("\n")


def run_dir() -> Path:
    path = config_dir() / "runs"
    path.mkdir(parents=True, exist_ok=True)
    return path


def new_run_id() -> str:
    return f"{time.strftime('%Y%m%dT%H%M%S')}-{secrets.token_hex(3)}"


def run_log_path(run_id: str) -> Path:
    return run_dir() / f"{run_id}.log"


def run_exit_path(run_id: str) -> Path:
    return run_dir() / f"{run_id}.exit"


def load_runs() -> list[dict]:
    if not RUNS_JSON.is_file():
        return []
    try:
        return json.loads(RUNS_JSON.read_text())
    except (json.JSONDecodeError, OSError):
        return []


def save_runs(records: list[dict]) -> None:
    config_dir()
    RUNS_JSON.write_text(json.dumps(records[-RUNS_KEEP:], indent=2) + "\n")


def record_run(run_id: str, **fields) -> dict:
    records = load_runs()
    row = next((r for r in records if r.get("id") == run_id), None)
    if row is None:
        row = {"id": run_id}
        records.append(row)
    row.update(fields)
    save_runs(records)
    return row


def wait_tmux(project: str, run_id: str = "") -> int:
    session = tmux_session(project)
    while run(["tmux", "has-session", "-t", session], check=False).returncode == 0:
        time.sleep(3)
    if not run_id:
        return 0
    exit_path = run_exit_path(run_id)
    if not exit_path.is_file():
        return -1
    try:
        return int(exit_path.read_text().strip())
    except ValueError:
        return -1


def launch_agent(kind: str, cmd: list[str], dest: Path, project: str, prefix: str = "", run_id: str = "") -> int:
    tag = prefix or project
    append_log(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} {tag} via {kind} ===\n")
    if have("tmux"):
        session = tmux_session(project)
        if tmux_alive(project):
            die(f"already running: tmux {session}")
        pipe = f"{shlex.join(cmd)} 2>&1"
        if prefix:
            pipe += (
                f" | while IFS= read -r line || [ -n \"$line\" ]; do "
                f"printf '%s %s\\n' {shlex.quote(prefix)} \"$line\"; done"
            )
        tee_targets = [str(RUN_LOG)]
        exit_path = None
        if run_id:
            tee_targets.append(str(run_log_path(run_id)))
            exit_path = run_exit_path(run_id)
        tee_cmd = " ".join(shlex.quote(t) for t in tee_targets)
        # PIPESTATUS[0] is the agent's own exit code, unaffected by the
        # prefix/tee stages tacked onto the end of the pipeline.
        script = (
            f"cd {shlex.quote(str(dest))} && {pipe} | tee -a {tee_cmd}; "
            f"code=${{PIPESTATUS[0]}}; "
            + (f"echo \"$code\" > {shlex.quote(str(exit_path))}; " if exit_path else "")
            + f"echo {shlex.quote(prefix) if prefix else ''} EXIT:$code | tee -a {shlex.quote(str(RUN_LOG))}; "
            f"exit \"$code\""
        )
        proc = subprocess.run(["tmux", "new-session", "-d", "-s", session, "bash", "-lc", script])
        if proc.returncode != 0:
            return proc.returncode
        return wait_tmux(project, run_id)
    proc = subprocess.run(cmd, cwd=dest)
    return proc.returncode


def run_issue(
    reg: dict,
    repo: str,
    number: int,
    kind: str,
    model: str = "",
    effort: str = "",
    fast: bool = False,
) -> dict:
    load_env()
    project = project_by_repo(reg, repo)
    dest = project_dir(project)
    if dest is None or not dest.is_dir():
        die(f"project not cloned: {project['name']}. Run ./bin/corp bootstrap")
    issue = get_issue(repo, number)
    names = label_names(issue)
    if "self" in names:
        die(f"{repo}#{number} is claimed as self")
    blocked = pin_write_block(reg, project["name"], except_issue=number)
    if blocked:
        die(blocked)
    if tmux_alive(project["name"]):
        die(f"VPS already running {project['name']}")
    role, slot = slot_for_issue(project["name"], issue)
    kind = kind or slot.get("kind") or kind
    model = model or slot.get("model") or ""
    effort = effort or slot.get("effort") or ""
    fast = fast or bool(slot.get("fast"))
    if kind not in KIND_BIN:
        die(f"unknown agent {kind}")
    if not have(KIND_BIN[kind]):
        die(f"{kind} CLI is not installed ({KIND_BIN[kind]})")
    names = label_names(issue)
    if role == "design":
        if project["name"] == "corp":
            extra = (
                " This is a workshop design issue: change workshop/static for phone and desktop. "
                "workshop/preview.html is a reference, not a dump. Do not close the issue."
            )
        else:
            extra = " This is a design issue: change only preview/docs, not production code. Do not close the issue."
    elif role == "qa":
        extra = " This is QA. If it passes, close the issue. If it fails, leave it open and say qa-fail."
    elif "qa" in names:
        extra = " Label qa is set: implement but do not close. QA runs next."
    else:
        extra = ""
    claim(repo, number, kind, f"corp-claim: vps {kind}")
    prompt = agent_prompt(repo, number, issue.get("title") or "", issue.get("url") or "", dest, project["name"]) + extra
    notify_safe(f"{repo}#{number} · {kind} · старт · {issue.get('title')}\n{issue.get('url')}")
    cmd = agent_argv(kind, prompt, dest, model=model, effort=effort, fast=fast)
    print(f"running: {cmd[0]} {repo}#{number}", file=sys.stderr)
    run_id = new_run_id()
    record_run(
        run_id, repo=repo, issue=number, project=project["name"], kind=kind,
        status="running", started=time.time(), finished=None, code=None,
    )
    stop = threading.Event()
    threading.Thread(target=pulse_loop, args=(repo, number, kind, time.time(), stop, model), daemon=True).start()
    try:
        code = launch_agent(kind, cmd, dest, project["name"], prefix=issue_ref(repo, number), run_id=run_id)
    finally:
        stop.set()
    record_run(run_id, status="done" if code == 0 else "failed", finished=time.time(), code=code)
    latest = get_issue(repo, number)
    closed = (latest.get("state") or "").upper() == "CLOSED"
    graph = ""
    if role == "design":
        if closed:
            run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
            closed = False
        remove_labels(repo, number, ["in-progress", *VIA.values()])
        add_labels(repo, number, ["ready"])
        notify_safe(f"{repo}#{number} · {kind} · design · {latest.get('title')}\n{latest.get('url')}")
        return {"ok": code == 0, "code": code, "repo": repo, "issue": number, "kind": kind, "graph": "", "closed": False, "run_id": run_id}
    if role == "build" and "qa" in names:
        if closed:
            run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
            closed = False
        qa_slot = slots_for(project["name"])["qa"]
        stop.set()
        return run_issue(
            reg, repo, number, qa_slot.get("kind") or "claude",
            model=qa_slot.get("model") or "", effort=qa_slot.get("effort") or "",
            fast=bool(qa_slot.get("fast")),
        )
    if role == "qa" and not (closed and code == 0):
        if closed:
            run(["gh", "issue", "reopen", str(number), "-R", repo], check=False)
            closed = False
        remove_labels(repo, number, ["in-progress", *VIA.values()])
        add_labels(repo, number, ["ready", "qa-fail"])
        notify_safe(f"{repo}#{number} · {kind} · qa-fail · {latest.get('title')}\n{latest.get('url')}")
        return {"ok": False, "code": code, "repo": repo, "issue": number, "kind": kind, "graph": "", "closed": False, "run_id": run_id}
    # Success requires both a confirmed zero exit code and the expected
    # GitHub state (issue closed) — a nonzero exit never reports as success
    # even if the issue happened to be closed already.
    if code == 0 and closed:
        graph = refresh_graph(dest, repo, number)
        notify_safe(f"{repo}#{number} · {kind} · закрыл · {latest.get('title')}\n{latest.get('url')}\n{graph}")
        maybe_orchestrate(reg, project["name"])
    elif code != 0:
        notify_safe(f"{repo}#{number} · {kind} · упал · exit {code}\n{latest.get('url')}")
    return {
        "ok": code == 0,
        "code": code,
        "repo": repo,
        "issue": number,
        "kind": kind,
        "graph": graph,
        "closed": closed,
        "run_id": run_id,
    }


def run_next(reg: dict, args: argparse.Namespace) -> None:
    if args.issue:
        repo, number = parse_issue_ref(args.issue)
        kind = args.agent or ""
        model, effort, fast = args.model or "", args.effort or "", bool(args.fast)
        if args.profile:
            profile = profile_by_id(args.profile)
            kind = kind or profile.get("kind") or ""
            model = model or profile.get("model") or ""
            effort = effort or profile.get("effort") or ""
            fast = fast or bool(profile.get("fast"))
        if not kind:
            kind = pick_agent()
        if kind not in KIND_BIN:
            die(f"unknown agent {kind}")
        result = run_issue(reg, repo, number, kind, model=model, effort=effort, fast=fast)
        print(json.dumps(result, indent=2) if args.json else f"{result['repo']}#{result['issue']} {result['kind']} exit {result['code']}")
        raise SystemExit(0 if result["ok"] else result["code"] or 1)

    payload = cycle_payload(reg)
    print(render(payload), end="")
    if payload["mode"] != "execute":
        try:
            notify("corp: no ready Issue. Research loop. Do not start greenfield work.")
        except (SystemExit, CorpError):
            pass
        return
    nxt = payload["next"]
    result = run_issue(reg, nxt["repo"], nxt["issue"], pick_agent())
    raise SystemExit(0 if result["ok"] else result["code"] or 1)


def queue_add(reg: dict, repo: str, number: int, profile_id: str) -> dict:
    issue = get_issue(repo, number)
    if "self" in label_names(issue) or column_of(issue) == "in-progress" and runner_of(issue) not in {"", "queued"}:
        die(f"{repo}#{number} is already claimed")
    project = project_by_repo(reg, repo)
    blocked = pin_write_block(reg, project["name"], except_issue=number)
    if blocked:
        die(blocked)
    profile_by_id(profile_id)
    key = issue_ref(repo, number)

    def mutate(data: dict) -> list:
        for item in data["queue"]:
            if issue_ref(item["repo"], item["issue"]) == key and item.get("status") in {"waiting", "running"}:
                die(f"{key} is already queued")
        data["queue"].append(
            {
                "repo": repo,
                "issue": number,
                "project": project["name"],
                "title": issue.get("title") or "",
                "url": issue.get("url") or "",
                "profile": profile_id,
                "status": "waiting",
            }
        )
        return data["queue"]

    # The dup check + append happens atomically above, under the lock, on a
    # freshly re-read queue -- two concurrent callers can no longer both pass
    # the dup check and each append a row, clobbering one another on save.
    queue = update_workshop(mutate)
    add_labels(repo, number, ["ready", "queued"])
    comment(repo, number, "corp-claim: queue")
    return {"ok": True, "queue": queue}


def queue_rm(repo: str, number: int) -> dict:
    def mutate(data: dict) -> list:
        kept = []
        removed = False
        for item in data["queue"]:
            if item["repo"] == repo and item["issue"] == number and item.get("status") != "running":
                removed = True
                continue
            kept.append(item)
        if not removed:
            die(f"not in queue: {repo}#{number}")
        data["queue"] = kept
        return kept

    kept = update_workshop(mutate)
    remove_labels(repo, number, ["queued"])
    return {"ok": True, "queue": kept}


def queue_set_running(running: bool) -> dict:
    def mutate(data: dict) -> dict:
        data["queue_running"] = running
        return data

    data = update_workshop(mutate)
    return {"ok": True, "queue_running": running, "queue": data["queue"]}


def queue_status() -> dict:
    return load_workshop()


def reconcile_running(active_projects: set[str] | None = None) -> list[dict]:
    """Mark queue rows stuck on `running` with no live watcher as `interrupted`.

    Call at workshop startup and before every queue tick. A `running` row is
    trustworthy only if either its project has a live in-process watcher
    (`active_projects`, tracked by the workshop process) or its tmux session
    is still alive. Otherwise the process that launched it died mid-run and
    the real outcome can't be confirmed, so the row is closed out
    deterministically as `interrupted` rather than left stuck forever or
    reported as done/failed by guesswork. Never relaunches the issue.
    """
    active = active_projects or set()
    changed = []
    with _workshop_file_lock():
        data = _read_workshop_raw()
        for item in data["queue"]:
            if item.get("status") != "running":
                continue
            project = item.get("project") or ""
            if project in active or tmux_alive(project):
                continue
            item["status"] = "interrupted"
            item["finished"] = time.time()
            changed.append(item)
        if changed:
            _write_workshop(data)
    return changed


def setup_token_ok(token: str, path: Path | None = None) -> bool:
    given = (token or "").strip()
    store = path or TOKEN_PATH
    expected = store.read_text().strip() if store.is_file() else ""
    if not expected or not given or len(given) != len(expected):
        return False
    return secrets.compare_digest(given, expected)


def workshop_token() -> str:
    config_dir()
    token = secrets.token_urlsafe(24)
    TOKEN_PATH.write_text(token + "\n")
    os.chmod(TOKEN_PATH, 0o600)
    print(token)
    print("First register or recover: https://<tailscale-host>/?token=" + token, file=sys.stderr)
    return token


def cmd_queue(reg: dict, args: argparse.Namespace) -> None:
    action = args.message or "status"
    if action == "status":
        print(json.dumps(queue_status(), indent=2))
        return
    if action == "start":
        print(json.dumps(queue_set_running(True), indent=2))
        return
    if action == "pause":
        print(json.dumps(queue_set_running(False), indent=2))
        return
    if action in {"add", "rm"}:
        if not args.issue:
            die(f"usage: corp queue {action} --issue owner/repo#n")
        repo, number = parse_issue_ref(args.issue)
        if action == "add":
            if not args.profile:
                die("usage: corp queue add --issue owner/repo#n --profile id")
            print(json.dumps(queue_add(reg, repo, number, args.profile), indent=2))
            return
        print(json.dumps(queue_rm(repo, number), indent=2))
        return
    die("usage: corp queue add|rm|start|pause|status")


def main() -> None:
    parser = argparse.ArgumentParser(prog="corp", description="Corporation harness")
    parser.add_argument(
        "command",
        nargs="?",
        default="cycle",
        choices=[
            "bootstrap",
            "cycle",
            "pull",
            "status",
            "doctor",
            "notify",
            "run",
            "take",
            "close",
            "board",
            "move",
            "queue",
            "workshop-token",
            "catalog",
            "pin",
            "hide",
            "archive",
            "add-project",
            "create-project",
            "orchestrate",
            "draft",
            "stage",
        ],
    )
    parser.add_argument("--project", help="project name")
    parser.add_argument("--repo", help="owner/repo")
    parser.add_argument("--draft", help="draft id")
    parser.add_argument("--action", choices=["approve", "skip"])
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--write", action="store_true", help="write memory/next.local.md")
    parser.add_argument("--all", action="store_true", help="bootstrap paused projects too")
    parser.add_argument("--issue", help="owner/repo#n")
    parser.add_argument("--agent", choices=list(KIND_BIN))
    parser.add_argument("--profile", help="workshop profile id")
    parser.add_argument("--column", choices=["backlog", "ready", "in-progress", "done"])
    parser.add_argument("--model")
    parser.add_argument("--effort")
    parser.add_argument("--fast", action="store_true")
    parser.add_argument("message", nargs="?", help="text for notify, or queue action")
    args = parser.parse_args()
    load_env()
    reg = load_registry()

    if args.command == "bootstrap":
        bootstrap(reg, include_paused=args.all)
        return
    if args.command == "pull":
        pull_projects(reg)
        return
    if args.command == "status":
        status(reg)
        return
    if args.command == "doctor":
        if args.json:
            print(json.dumps(doctor_payload(), indent=2))
        else:
            doctor()
        return
    if args.command == "notify":
        if not args.message:
            die("usage: corp notify 'text'")
        notify(args.message)
        return
    if args.command == "run":
        run_next(reg, args)
        return
    if args.command == "take":
        if not args.issue:
            die("usage: corp take --issue owner/repo#n")
        repo, number = parse_issue_ref(args.issue)
        result = take_issue(reg, repo, number)
        print(json.dumps(result, indent=2) if args.json else f"took {repo}#{number} as self")
        return
    if args.command == "close":
        if not args.issue:
            die("usage: corp close --issue owner/repo#n")
        repo, number = parse_issue_ref(args.issue)
        result = close_issue(reg, repo, number)
        print(json.dumps(result, indent=2) if args.json else f"closed {repo}#{number} {result['graph']}")
        return
    if args.command == "board":
        print(json.dumps(board_payload(reg), indent=2))
        return
    if args.command == "move":
        if not args.issue or not args.column:
            die("usage: corp move --issue owner/repo#n --column backlog|ready|in-progress|done")
        repo, number = parse_issue_ref(args.issue)
        result = move_issue(reg, repo, number, args.column)
        print(json.dumps(result, indent=2) if args.json else f"{repo}#{number} -> {args.column}")
        return
    if args.command == "queue":
        cmd_queue(reg, args)
        return
    if args.command == "workshop-token":
        workshop_token()
        return
    if args.command == "catalog":
        print(json.dumps(probe_catalog(), indent=2))
        return
    if args.command == "pin":
        if not args.project:
            die("usage: corp pin --project name")
        print(json.dumps(set_pin(reg, args.project, True), indent=2))
        return
    if args.command == "hide":
        if not args.project:
            die("usage: corp hide --project name")
        print(json.dumps(hide_project(reg, args.project), indent=2))
        return
    if args.command == "archive":
        if not args.project:
            die("usage: corp archive --project name")
        print(json.dumps(archive_project(reg, args.project), indent=2))
        return
    if args.command == "add-project":
        if not args.repo and not args.project:
            die("usage: corp add-project --repo org/name")
        print(json.dumps(add_existing(reg, args.repo or args.project), indent=2))
        return
    if args.command == "create-project":
        if not args.project:
            die("usage: corp create-project --project name")
        print(json.dumps(create_project(reg, args.project), indent=2))
        return
    if args.command == "orchestrate":
        repo = args.repo
        if not repo and args.project:
            repo = project_by_name(reg, args.project).get("repo")
        if not repo:
            die("usage: corp orchestrate --repo owner/name")
        print(json.dumps(orchestrate(reg, repo), indent=2))
        return
    if args.command == "draft":
        if not args.draft or not args.action:
            die("usage: corp draft --draft id --action approve|skip")
        fn = approve_draft if args.action == "approve" else skip_draft
        print(json.dumps(fn(args.draft), indent=2))
        return
    if args.command == "stage":
        if not args.project:
            die("usage: corp stage --project name")
        print(json.dumps(project_stage(reg, args.project), indent=2))
        return

    payload = cycle_payload(reg)
    text = json.dumps(payload, indent=2) if args.json else render(payload)
    print(text, end="" if text.endswith("\n") else "\n")
    if args.write:
        path = write_next(text if not args.json else render(payload))
        print(f"wrote {path}", file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except CorpError as exc:
        print(exc, file=sys.stderr)
        raise SystemExit(exc.code)
