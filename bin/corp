class CorpError(Exception):
    def __init__(self, msg: str, code: int = 1) -> None:
        super().__init__(msg)
        self.code = code


def die(msg: str, code: int = 1) -> None:
    raise CorpError(msg, code)


def ensure_path() -> None:
    extras = [str(Path.home() / ".local" / "bin"), "/usr/local/bin"]
    parts = [p for p in os.environ.get("PATH", "").split(":") if p]
    os.environ["PATH"] = ":".join([p for p in extras if p not in parts] + parts)


def load_env() -> None:
    ensure_path()
    for path in ENV_PATHS:
        if path is None or not path.is_file():
            continue
        for raw in path.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))
        return


def _registry_overlay() -> dict:
    if not WORKSHOP_JSON.is_file():
        return {}
    try:
        return json.loads(WORKSHOP_JSON.read_text()).get("registry") or {}
    except (OSError, json.JSONDecodeError):
        return {}


def overlay_diverges(extra: dict | None = None, git_reg: dict | None = None) -> bool:
    """True only when overlay adds a project or changes a pin vs git registry."""
    data = extra if extra is not None else _registry_overlay()
    pins = data.get("pins") or {}
    extra_projects = data.get("projects") or []
    if not pins and not extra_projects:
        return False
    if git_reg is None:
        try:
            git_reg = json.loads(REGISTRY_PATH.read_text())
        except (OSError, json.JSONDecodeError):
            return True
    git_by = {p.get("name"): p for p in git_reg.get("projects") or [] if p.get("name")}
    for name, pinned in pins.items():
        row = git_by.get(name)
        if row is None:
            return True
        if bool(row.get("workshop")) != bool(pinned):
            return True
    for row in extra_projects:
        name = row.get("name")
        if not name:
            continue
        git_row = git_by.get(name)
        if git_row is None:
            return True
        if row.get("repo") and git_row.get("repo") and row.get("repo") != git_row.get("repo"):
            return True
        if name not in pins and bool(row.get("workshop")) != bool(git_row.get("workshop")):
            return True
    return False


def overlay_active(extra: dict | None = None) -> bool:
    return overlay_diverges(extra)


def git_registry_candidates() -> list[Path]:
    seen: list[Path] = []
    for path in (REGISTRY_PATH, writers_corp_path() / "registry.json", live_corp_path() / "registry.json"):
        try:
            key = path.resolve()
        except OSError:
            key = path
        if key in seen:
            continue
        seen.append(key)
    return seen


def registry_status() -> dict:
    extra = _registry_overlay()
    candidates = git_registry_candidates()
    git_writable = False
    for path in candidates:
        try:
            if path.is_file():
                git_writable = os.access(path, os.W_OK)
            elif path.parent.is_dir():
                git_writable = os.access(path.parent, os.W_OK)
        except OSError:
            git_writable = False
        if git_writable:
            break
    diverges = overlay_diverges(extra)
    root_writable = os.access(REGISTRY_PATH, os.W_OK)
    hint = ""
    if not root_writable:
        hint = "need write to git registry / deploy path"
    return {
        "canonical": "git",
        "overlay": "emergency",
        "uncommitted_registry": diverges,
        "registry_writable": root_writable,
        "registry_git_writable": git_writable,
        "registry_path": str(REGISTRY_PATH),
        "overlay_path": str(WORKSHOP_JSON),
        "registry_write_hint": hint if (not root_writable or diverges) else "",
    }


def merge_registry(raw: dict, extra: dict) -> dict:
    """git registry.json is canonical. Overlay is emergency-only.

    Overlay may add local-only projects and apply explicit pin overrides.
    It must not delete git projects or silently drop git pins.
    """
    extra = extra or {}
    pins = extra.get("pins") or {}
    by_name: dict[str, dict] = {}
    ordered: list[dict] = []
    seen: set[str] = set()

    def take(row: dict, *, overlay_only: bool) -> None:
        name = row.get("name")
        if not name or name in seen:
            return
        item = dict(row)
        if name in pins:
            item["workshop"] = bool(pins[name])
        elif not overlay_only:
            item["workshop"] = bool(row.get("workshop"))
        by_name[name] = item
        ordered.append(item)
        seen.add(name)

    for project in raw.get("projects") or []:
        take(project, overlay_only=False)
    for project in extra.get("projects") or []:
        name = project.get("name")
        if name in seen:
            continue
        take(project, overlay_only=True)
    for name, pinned in pins.items():
        if not name or name in seen:
            continue
        take({"name": name, "status": "active", "workshop": bool(pinned)}, overlay_only=True)
    out = dict(raw)
    out["projects"] = ordered
    return out


def load_registry() -> dict:
    raw = json.loads(REGISTRY_PATH.read_text())
    extra = _registry_overlay()
    if not overlay_active(extra):
        return raw
    return merge_registry(raw, extra)


def _clear_registry_overlay() -> None:
    if not WORKSHOP_JSON.is_file():
        return
    try:
        data = json.loads(WORKSHOP_JSON.read_text())
    except (OSError, json.JSONDecodeError):
        return
    if not data.get("registry"):
        return
    data["registry"] = {}
    save_workshop(data)


def workspace() -> Path:
    env = os.environ.get("CORP_WORKSPACE")
    if env:
        return Path(env).expanduser()
    parent = ROOT.parent
    if parent.name in {"Github", "Developer", "repos", "src", "code"}:
        return parent
    return ROOT / "projects"


def expand(raw: str) -> Path:
    return Path(os.path.expanduser(raw))


def project_dir(project: dict) -> Path | None:
    for raw in project.get("roots") or []:
        path = expand(raw)
        if path.is_dir() and (path / ".git").exists():
            return path
    candidate = workspace() / project["name"]
    if candidate.is_dir() and (candidate / ".git").exists():
        return candidate
    return None


def strip_ansi(text: str) -> str:
    return _ANSI_RE.sub("", text or "")


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, timeout: float | None = None) -> subprocess.CompletedProcess:
    env = None
    if cmd and cmd[0] == "gh":
        env = os.environ.copy()
        env["GH_COLOR"] = "never"
        env["NO_COLOR"] = "1"
        env.pop("FORCE_COLOR", None)
        env.pop("CLICOLOR_FORCE", None)
    try:
        return subprocess.run(cmd, cwd=cwd, check=check, text=True, capture_output=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else (exc.stdout or b"").decode()
        err = exc.stderr if isinstance(exc.stderr, str) else (exc.stderr or b"timeout").decode()
        return subprocess.CompletedProcess(cmd, 124, out or "", err or "timeout")


def have(cmd: str) -> bool:
    ensure_path()
    return shutil.which(cmd) is not None


def gh_ready() -> bool:
    if not have("gh"):
        return False
    return run(["gh", "auth", "status"], check=False).returncode == 0


def redact_secrets(text: str) -> str:
    out = text or ""
    for pat in _REDACT_PATTERNS:
        out = pat.sub("[redacted]", out)
    return out


def live_corp_path() -> Path:
    return Path(os.environ.get("CORP_LIVE") or "/opt/corp").expanduser()


def writers_corp_path() -> Path:
    custom = (os.environ.get("CORP_WRITERS") or "").strip()
    if custom:
        return Path(custom).expanduser()
    ws = (os.environ.get("CORP_WORKSPACE") or "").strip()
    if ws:
        return Path(ws).expanduser() / "corp"
    live = live_corp_path()
    try:
        if ROOT.resolve() != live.resolve():
            return ROOT
    except OSError:
        return ROOT
    return Path("/home/corp/projects/corp")


def two_trees_report() -> dict:
    live_path = live_corp_path()
    writers_path = writers_corp_path()
    live = git_tree_report(live_path)
    writers = git_tree_report(writers_path)
    live_head = live.get("head") or ""
    writers_head = writers.get("head") or ""
    return {
        "live_path": str(live_path),
        "writers_path": str(writers_path),
        "live": live,
        "writers": writers,
        "live_sha": live_head,
        "writers_sha": writers_head,
        "trees_match": bool(live_head and writers_head and live_head == writers_head),
    }


def _short_sha(sha: str) -> str:
    return (sha or "")[:7]


def _tree_git_label(tree: dict) -> str:
    if not tree.get("exists"):
        return "missing"
    bits = []
    if tree.get("dirty"):
        bits.append("dirty")
    if tree.get("behind"):
        bits.append("behind")
    return ", ".join(bits) if bits else "clean"


def git_tree_report(path: Path) -> dict:
    empty = {"exists": False, "dirty": True, "behind": True, "head": "", "origin_main": ""}
    if not path.is_dir():
        return empty
    inside = run(["git", "-C", str(path), "rev-parse", "--is-inside-work-tree"], check=False, timeout=8)
    if inside.returncode != 0 or (inside.stdout or "").strip() != "true":
        return empty
    head = (run(["git", "-C", str(path), "rev-parse", "HEAD"], check=False, timeout=8).stdout or "").strip()
    origin = (
        run(["git", "-C", str(path), "rev-parse", "origin/main"], check=False, timeout=8).stdout or ""
    ).strip()
    porcelain = (
        run(["git", "-C", str(path), "status", "--porcelain"], check=False, timeout=8).stdout or ""
    ).strip()
    behind_proc = run(
        ["git", "-C", str(path), "rev-list", "--count", "HEAD..origin/main"],
        check=False,
        timeout=8,
    )
    if behind_proc.returncode != 0:
        behind = True
    else:
        try:
            behind = int((behind_proc.stdout or "1").strip() or "1") > 0
        except ValueError:
            behind = True
    return {
        "exists": True,
        "dirty": bool(porcelain),
        "behind": behind,
        "head": head,
        "origin_main": origin,
    }


def classify_writer_tree(head: str, upstream: str, merge_base: str, dirty: bool) -> str:
    if not head or not upstream or not merge_base:
        return "no-upstream"
    if head == upstream:
        return "ok"
    if merge_base == head:
        return "dirty-stale" if dirty else "stale"
    return "diverged"


def writer_tree_status(dest: Path) -> dict:
    def g(*args: str) -> str:
        proc = run(["git", "-C", str(dest), *args], check=False, timeout=30)
        return (proc.stdout or "").strip()

    fetch = run(["git", "-C", str(dest), "fetch", "origin", "--quiet"], check=False, timeout=60)
    head = g("rev-parse", "HEAD")
    upstream = g("rev-parse", "origin/main") if fetch.returncode == 0 else ""
    base = g("merge-base", "HEAD", "origin/main") if upstream else ""
    porcelain = g("status", "--porcelain")
    status = classify_writer_tree(head, upstream, base, bool(porcelain))
    if fetch.returncode != 0:
        status = "unknown"
    return {"status": status, "head": head, "upstream": upstream, "fetch_ok": fetch.returncode == 0}


def sync_writer_tree(dest: Path, name: str = "") -> str:
    label = f"{name}: " if name else ""
    info = writer_tree_status(dest)
    status = info["status"]
    if status == "ok":
        return "ok"
    if status == "stale":
        proc = run(["git", "-C", str(dest), "pull", "--ff-only", "--quiet"], check=False, timeout=120)
        if proc.returncode != 0:
            need_human(f"{label}writers отстал от origin/main, ff-pull не прошёл ({dest}) — нужен человек")
            die(f"{label}git pull --ff-only failed in {dest}; разберись вручную")
        return "fast-forwarded"
    if status == "dirty-stale":
        need_human(f"{label}writers отстал от origin/main и есть незакоммиченные правки ({dest}) — нужен человек")
        die(f"{label}writers stale with uncommitted changes in {dest}; закоммить или разбери вручную")
    if status == "diverged":
        need_human(f"{label}writers разошёлся с origin/main ({dest}) — запись запрещена, нужен человек")
        die(f"{label}writers diverged from origin/main in {dest}; force-push запрещён, нужен ручной разбор")
    need_human(f"{label}не удалось проверить свежесть writers ({dest}) — нужен человек")
    die(f"{label}cannot verify writers tree freshness in {dest}; проверь сеть и git")


def workshop_unit_active() -> bool:
    if not have("systemctl"):
        return False
    proc = run(["systemctl", "is-active", WORKSHOP_UNIT], check=False, timeout=5)
    return (proc.stdout or "").strip() == "active"


def workshop_unit_props() -> dict:
    empty = {"user": "", "main_pid": 0, "working_directory": "", "active": False}
    if not have("systemctl"):
        return empty
    proc = run(
        [
            "systemctl",
            "show",
            WORKSHOP_UNIT,
            "-p",
            "User",
            "-p",
            "MainPID",
            "-p",
            "WorkingDirectory",
            "-p",
            "ActiveState",
        ],
        check=False,
        timeout=5,
    )
    props: dict[str, str] = {}
    for line in (proc.stdout or "").splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            props[key] = value
    try:
        pid = int(props.get("MainPID") or 0)
    except ValueError:
        pid = 0
    return {
        "user": (props.get("User") or "").strip(),
        "main_pid": pid,
        "working_directory": (props.get("WorkingDirectory") or "").strip(),
        "active": (props.get("ActiveState") or "").strip() == "active",
    }


def workshop_service_home(unit: dict | None = None) -> Path:
    custom = (os.environ.get("CORP_HOME") or "").strip()
    if custom:
        return Path(custom).expanduser()
    info = unit if unit is not None else workshop_unit_props()
    user = (info.get("user") or "").strip()
    if user and user != "root":
        return Path(f"/home/{user}")
    return Path("/home/corp")


def workshop_service_db(unit: dict | None = None) -> Path:
    return workshop_service_home(unit) / ".config" / "corp" / "workshop.db"


def workshop_db_mode(path: Path | None = None) -> str:
    target = path or workshop_service_db()
    try:
        if not target.is_file():
            return "missing"
        return oct(target.stat().st_mode & 0o777)
    except OSError:
        return "missing"


def workshop_db_mode_ok(path: Path | None = None) -> bool:
    return workshop_db_mode(path) == "0o600"


def proc_cwd(pid: int) -> str:
    if not pid:
        return ""
    try:
        return str(Path(f"/proc/{pid}/cwd").resolve())
    except OSError:
        return ""


def proc_start_time(pid: int) -> float:
    if not pid:
        return 0.0
    try:
        return float(Path(f"/proc/{pid}").stat().st_ctime)
    except OSError:
        return 0.0


def git_head_commit_time(path: Path) -> float:
    proc = run(["git", "-C", str(path), "log", "-1", "--format=%ct"], check=False, timeout=8)
    try:
        return float((proc.stdout or "0").strip() or 0)
    except ValueError:
        return 0.0


def uvicorn_matches_live(
    live_path: Path | None = None,
    live_head: str = "",
    live_commit_time: float = 0.0,
    pid: int = 0,
    cwd: str = "",
    start_time: float = 0.0,
    working_directory: str = "",
) -> dict:
    live = live_path or live_corp_path()
    try:
        live_res = str(live.resolve())
    except OSError:
        live_res = str(live)
    here = cwd or working_directory or ""
    under_live = bool(here and (here == live_res or here.startswith(live_res + os.sep)))
    stale = bool(pid and live_commit_time and start_time and start_time < live_commit_time)
    ok = bool(pid and under_live and not stale)
    return {
        "ok": ok,
        "pid": pid,
        "cwd": here,
        "head": live_head,
        "stale": stale or not under_live or not pid,
        "under_live": under_live,
    }


def uvicorn_process_report(unit: dict | None = None) -> dict:
    live = live_corp_path()
    tree = git_tree_report(live)
    info = unit if unit is not None else workshop_unit_props()
    pid = int(info.get("main_pid") or 0)
    cwd = proc_cwd(pid) or (info.get("working_directory") or "")
    start = proc_start_time(pid)
    head_time = git_head_commit_time(live) if tree.get("exists") else 0.0
    match = uvicorn_matches_live(
        live_path=live,
        live_head=tree.get("head") or "",
        live_commit_time=head_time,
        pid=pid,
        cwd=cwd,
        start_time=start,
        working_directory=info.get("working_directory") or "",
    )
    match["origin_main"] = tree.get("origin_main") or ""
    return match


def auth_policy_present(root: Path | None = None) -> bool:
    return ((root or live_or_root()) / "workshop" / "auth_policy.py").is_file()


def live_or_root() -> Path:
    live = live_corp_path()
    return live if live.is_dir() else ROOT


def uvicorn_target_sha() -> str:
    live = git_tree_report(live_corp_path())
    if live["origin_main"]:
        return live["origin_main"]
    return git_tree_report(ROOT)["origin_main"]


def funnel_enabled_from_text(text: str) -> bool:
    """Funnel ON only from an explicit signal — never a Serve HTTPS URL."""
    raw = text or ""
    low = raw.lower()
    if not low.strip():
        return False
    if "no funnel" in low or "funnel is not" in low or "funnel off" in low:
        return False
    if "tailnet only" in low:
        return False
    if "funnel is enabled" in low or "allowfunnel" in low:
        return True
    if re.search(r"\bfunnel\b.*\bon\b", low) or "funnel on" in low:
        return True
    if "funnel" in low and re.search(r"https://\S+", low) and "tailnet only" not in low:
        return True
    return False


def allow_funnel_on(data: dict) -> bool:
    allow = data.get("AllowFunnel")
    if isinstance(allow, dict):
        return any(bool(value) for value in allow.values())
    return bool(allow)


def tailscale_status() -> dict:
    missing = {"serve": False, "funnel": True, "ok": False}
    if not have("tailscale"):
        return missing
    proc = run(["tailscale", "serve", "status", "--json"], check=False, timeout=8)
    try:
        data = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    serve_on = bool(data.get("Web") or data.get("TCP"))
    funnel_on = allow_funnel_on(data)
    if not serve_on and (proc.stdout or "").strip() and proc.returncode == 0:
        text = proc.stdout or ""
        serve_on = "http" in text.lower() or "https" in text.lower()
    if not funnel_on:
        fun = run(["tailscale", "funnel", "status"], check=False, timeout=8)
        text = (fun.stdout or "") + "\n" + (fun.stderr or "")
        funnel_on = funnel_enabled_from_text(text)
    return {"serve": serve_on, "funnel": funnel_on, "ok": serve_on and not funnel_on}


def isolation_status() -> dict:
    iso = probe_isolation()
    return {
        "mode": iso.get("mode") or "transitional",
        "ok": bool(iso.get("isolated")),
        "reason": iso.get("reason") or "; ".join(iso.get("blockers") or []),
    }


def sanitize_workshop(data: dict) -> dict:
    for item in data.get("queue") or []:
        err = item.get("last_error")
        if err:
            item["last_error"] = redact_secrets(str(err))
    return data


def active_projects(reg: dict, include_paused: bool = False) -> list[dict]:
    out = []
    for project in reg.get("projects", []):
        if project.get("status") == "active" or include_paused:
            out.append(project)
    return out


def is_pinned(project: dict) -> bool:
    return bool(project.get("workshop"))


def pinned_projects(reg: dict) -> list[dict]:
    return [project for project in reg.get("projects", []) if is_pinned(project)]


def _write_registry_overlay(reg: dict) -> None:
    git_names: set[str] = set()
    try:
        git_raw = json.loads(REGISTRY_PATH.read_text())
        git_names = {p.get("name") for p in git_raw.get("projects") or [] if p.get("name")}
    except (OSError, json.JSONDecodeError):
        git_names = set()
    data = load_workshop()
    data["registry"] = {
        "pins": {p.get("name"): bool(p.get("workshop")) for p in reg.get("projects") or [] if p.get("name")},
        "projects": [dict(p) for p in reg.get("projects") or [] if p.get("name") and p.get("name") not in git_names],
    }
    save_workshop(data)


def save_registry(reg: dict) -> None:
    invalidate_board()
    text = json.dumps(reg, indent=2) + "\n"
    wrote_root = False
    wrote_git = False
    for path in git_registry_candidates():
        try:
            if not path.parent.is_dir():
                continue
            path.write_text(text)
            wrote_git = True
            try:
                if path.resolve() == REGISTRY_PATH.resolve():
                    wrote_root = True
            except OSError:
                if path == REGISTRY_PATH:
                    wrote_root = True
        except OSError:
            continue
    if wrote_root:
        _clear_registry_overlay()
        return
    # Live git file stayed unwritable. Keep an emergency overlay so the
    # workshop still sees pins, but do not pretend overlay is canon.
    _write_registry_overlay(reg)
    if not wrote_git:
        print("need write to git registry / deploy path", file=sys.stderr)


def org_name(reg: dict) -> str:
    return str(reg.get("org") or "andrewkazavchinskyy-cloud")


def bootstrap(reg: dict, include_paused: bool = False) -> None:
    if not have("git"):
        die("missing git")
    if not gh_ready():
        die("gh is missing or not logged in. Run: gh auth login")

    ws = workspace()
    ws.mkdir(parents=True, exist_ok=True)
    print(f"workspace: {ws}")

    if not have("graphify"):
        if have("uv"):
            print("installing graphify via uv")
            proc = run(["uv", "tool", "install", "graphifyy"], check=False)
            if proc.returncode != 0:
                print((proc.stderr or proc.stdout).strip())
        else:
            print("graphify not installed. Later: uv tool install graphifyy && graphify install")

    for project in active_projects(reg, include_paused=include_paused):
        dest = project_dir(project)
        if dest is None:
            dest = ws / project["name"]
            if dest.exists():
                print(f"skip clone {project['name']}: {dest} exists without .git")
                continue
            print(f"clone {project['repo']} -> {dest}")
            proc = run(["gh", "repo", "clone", project["repo"], str(dest)], check=False)
            if proc.returncode != 0:
                print((proc.stderr or proc.stdout).strip())
                continue
        else:
            print(f"pull {project['name']} ({dest})")
            proc = run(["git", "pull", "--ff-only"], cwd=dest, check=False)
            if proc.returncode != 0:
                print((proc.stderr or "git pull failed").strip())

        graph = dest / "graphify-out" / "GRAPH_REPORT.md"
        if not graph.exists():
            print(f"  no graphify-out yet. Later: cd {dest} && graphify .")

    print("bootstrap done. Next: ./bin/corp cycle")


def pull_projects(reg: dict) -> None:
    for project in active_projects(reg):
        dest = project_dir(project)
        if dest is None:
            print(f"missing {project['name']}")
            continue
        proc = run(["git", "pull", "--ff-only"], cwd=dest, check=False)
        status = "ok" if proc.returncode == 0 else (proc.stderr or "fail").strip()
        print(f"{project['name']}: {status}")


def issues_enabled(project: dict) -> bool:
    return project.get("issues", True)


def github_transient(err: str) -> bool:
    text = (err or "").lower()
    needles = (
        "http 502",
        "http 503",
        "http 504",
        "http 429",
        "no server is currently available",
        "something went wrong while executing your query",
        "timed out",
        "timeout",
        "secondary rate limit",
        "abuse detection",
    )
    return any(n in text for n in needles)


def github_issues_disabled(err: str) -> bool:
    text = (err or "").lower()
    return "disabled issues" in text or "issues are disabled" in text


def _parse_issue_list(repo: str, raw: str) -> list[dict]:
    try:
        data = json.loads(strip_ansi(raw or "").strip() or "[]")
    except json.JSONDecodeError as exc:
        die(f"github list parse failed {repo}: {exc}")
    if not isinstance(data, list):
        die(f"github list parse failed {repo}: not a list")
    return data


def _normalize_rest_issue(item: dict) -> dict | None:
    if item.get("pull_request"):
        return None
    labels = []
    for label in item.get("labels") or []:
        if isinstance(label, dict):
            labels.append({"name": label.get("name") or ""})
        elif label:
            labels.append({"name": str(label)})
    return {
        "number": item.get("number"),
        "title": item.get("title") or "",
        "url": item.get("html_url") or item.get("url") or "",
        "labels": labels,
        "updatedAt": item.get("updated_at") or item.get("updatedAt") or "",
        "state": (item.get("state") or "open").upper(),
        "closedAt": item.get("closed_at") or item.get("closedAt"),
    }


def _issues_via_graphql(repo: str, state: str, limit: int) -> tuple[list[dict] | None, str]:
    proc = run(
        [
            "gh",
            "issue",
            "list",
            "-R",
            repo,
            "--state",
            state,
            "--limit",
            str(limit),
            "--json",
            "number,title,url,labels,updatedAt,state,closedAt",
        ],
        check=False,
    )
    if proc.returncode == 0:
        try:
            return _parse_issue_list(repo, proc.stdout), ""
        except CorpError as exc:
            return None, str(exc)
    return None, (proc.stderr or proc.stdout or "").strip()


def _issues_via_rest(repo: str, state: str, limit: int) -> tuple[list[dict] | None, str]:
    proc = run(
        [
            "gh",
            "api",
            "-X",
            "GET",
            f"repos/{repo}/issues?state={state}&per_page={min(int(limit), 100)}",
        ],
        check=False,
    )
    if proc.returncode != 0:
        return None, (proc.stderr or proc.stdout or "").strip()
    rows = []
    for item in _parse_issue_list(repo, proc.stdout):
        if not isinstance(item, dict):
            continue
        row = _normalize_rest_issue(item)
        if row is not None:
            rows.append(row)
    return rows, ""


def issues_for(repo: str, state: str = "open", limit: int = 50) -> list[dict]:
    last_err = ""
    for attempt in range(3):
        rows, err = _issues_via_graphql(repo, state, limit)
        if rows is not None:
            return rows
        last_err = err
        if github_issues_disabled(err):
            return []
        if "parse failed" in (err or "").lower():
            break
        if not github_transient(err):
            die(f"github list failed {repo}: {err}")
        time.sleep(min(0.35 * (attempt + 1), 1.0))
    rows, rest_err = _issues_via_rest(repo, state, limit)
    if rows is not None:
        return rows
    if github_issues_disabled(rest_err):
        return []
    die(f"github list failed {repo}: {last_err or rest_err}")


def label_names(issue: dict) -> set[str]:
    return {item.get("name", "") for item in issue.get("labels") or []}


def rank(issue: dict) -> tuple:
    names = label_names(issue)
    pri = 9
    for i, name in enumerate(PRIORITY):
        if name in names:
            pri = i
            break
    return (pri, issue.get("updatedAt") or "")


def project_by_name(reg: dict, name: str) -> dict:
    for project in reg.get("projects", []):
        if project["name"] == name:
            return project
    return {"name": name, "roots": []}


def project_by_repo(reg: dict, repo: str) -> dict:
    for project in reg.get("projects", []):
        if project.get("repo") == repo:
            return project
    die(f"repo not in registry: {repo}")


def collect_issues(
    reg: dict,
    skip_blocked: bool = True,
    states: tuple[str, ...] = ("open",),
) -> list[dict]:
    blocked_label = reg.get("labels", {}).get("blocked", "blocked")
    found = []
    seen: set[tuple[str, int | None]] = set()
    for project in pinned_projects(reg):
        if not issues_enabled(project):
            continue
        for state in states:
            for issue in issues_for(project["repo"], state):
                key = (project["repo"], issue.get("number"))
                if key in seen:
                    continue
                seen.add(key)
                closed = (issue.get("state") or "OPEN").upper() == "CLOSED"
                if skip_blocked and not closed and blocked_label in label_names(issue):
                    continue
                found.append({**issue, "project": project["name"], "repo": project["repo"]})
    found.sort(key=rank)
    return found


def is_free_ready(issue: dict, reg: dict) -> bool:
    names = label_names(issue)
    ready = reg.get("labels", {}).get("ready", "ready")
    if ready not in names:
        return False
    if "in-progress" in names or "self" in names or "queued" in names:
        return False
    if "in-qa" in names and "qa-fail" not in names:
        return False
    return True


def split_ready(reg: dict, issues: list[dict]) -> tuple[list[dict], list[dict]]:
    ready = [issue for issue in issues if is_free_ready(issue, reg)]
    other = [issue for issue in issues if issue not in ready]
    return ready, other


_SPEC_SKIP_HEADINGS = {
    "non-goals",
    "не цели",
    "handoff",
    "who this is for",
    "compare shipped vs this spec",
}
_SPEC_STOP = {
    "this",
    "that",
    "with",
    "from",
    "have",
    "been",
    "will",
    "only",
    "must",
    "does",
    "into",
    "over",
    "after",
    "before",
    "project",
    "github",
    "issue",
    "issues",
}


def spec_bullets(text: str, limit: int = 24) -> list[str]:
    bullets: list[str] = []
    heading = ""
    for line in (text or "").splitlines():
        if line.startswith("#"):
            heading = line.lstrip("#").strip().lower()
            continue
        if heading in _SPEC_SKIP_HEADINGS:
            continue
        match = re.match(r"^\s*(?:[-*]|\d+\.)\s+(.+)", line)
        if not match:
            continue
        item = match.group(1).strip()
        item = re.sub(r"\*\*(.+?)\*\*", r"\1", item)
        item = re.sub(r"`([^`]+)`", r"\1", item)
        if len(item) < 12:
            continue
        bullets.append(item)
        if len(bullets) >= limit:
            break
    return bullets


def _norm_words(text: str) -> set[str]:
    raw = re.sub(r"[^a-z0-9а-яё]+", " ", (text or "").lower())
    return {word for word in raw.split() if len(word) >= 4 and word not in _SPEC_STOP}


def bullet_covered(bullet: str, issues: list[dict]) -> bool:
    needle = re.sub(r"[^a-z0-9а-яё]+", " ", (bullet or "").lower()).strip()
    words = _norm_words(bullet)
    for issue in issues or []:
        title = (issue.get("title") or "").strip()
        if not title:
            continue
        hay = re.sub(r"[^a-z0-9а-яё]+", " ", title.lower()).strip()
        if needle and (needle in hay or hay in needle):
            return True
        other = _norm_words(title)
        shared = words & other
        if len(shared) >= 2:
            return True
        # A single distinctive term (registry, unpinned, orchestrator…) is
        # enough evidence that a closed/tracked card speaks about this bullet.
        if any(len(word) >= 6 for word in shared):
            return True
    return False


_CODE_SKIP_DIRS = {".git", "graphify-out", "node_modules", ".cursor", ".github", "vendor", "__pycache__"}
_CODE_EXT = {".py", ".md", ".js", ".ts", ".tsx", ".jsx", ".json", ".sh", ".html", ".css", ".yml", ".yaml", ".toml"}


def _code_corpus(dest: Path) -> str:
    chunks: list[str] = []
    total = 0
    for path in sorted(Path(dest).rglob("*")):
        if not path.is_file() or path.suffix.lower() not in _CODE_EXT:
            continue
        # The SPEC/PRD must not prove their own bullets shipped.
        if path.name.lower() in {"spec.md", "prd.md"}:
            continue
        if any(part in _CODE_SKIP_DIRS for part in path.parts):
            continue
        try:
            if path.stat().st_size > 262144:
                continue
            chunk = path.read_text(errors="ignore").lower()
        except OSError:
            continue
        chunks.append(chunk)
        total += len(chunk)
        if total > 4_000_000:
            break
    return "\n".join(chunks)


def bullet_in_code(bullet: str, dest: Path | None) -> bool:
    if dest is None or not Path(dest).is_dir():
        return False
    tokens = [word for word in _norm_words(bullet) if len(word) >= 5]
    if not tokens:
        return False
    corpus = _code_corpus(dest)
    weak_hits = 0
    for token in tokens:
        found = corpus.count(token)
        if found >= 3:
            return True
        if found:
            weak_hits += 1
            if weak_hits >= 2:
                return True
    return False


def spec_gaps(spec_text: str, issues: list[dict], limit: int = 5, dest: Path | None = None) -> list[str]:
    out = []
    for bullet in spec_bullets(spec_text):
        if bullet_covered(bullet, issues):
            continue
        if dest is not None and bullet_in_code(bullet, dest):
            continue
        out.append(bullet)
        if len(out) >= limit:
            break
    return out


def git_worktree_hint(dest: Path | None) -> dict:
    if dest is None or not (dest / ".git").exists():
        return {"dirty": False, "unpushed": False}
    dirty = bool((run(["git", "status", "--porcelain"], cwd=dest, check=False).stdout or "").strip())
    ahead = run(["git", "rev-list", "--count", "@{u}..HEAD"], cwd=dest, check=False)
    unpushed = ahead.returncode == 0 and (ahead.stdout or "").strip() not in {"", "0"}
    return {"dirty": dirty, "unpushed": unpushed}


def graph_age_of(dest: Path | None) -> str:
    report = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
    if report and report.is_file():
        return time.strftime("%Y-%m-%d", time.localtime(report.stat().st_mtime))
    return ""


def graph_freshness(dest: Path | None) -> dict:
    empty = {"age": "", "commit": "", "head": "", "stale": True, "present": False}
    if dest is None:
        return empty
    report = dest / "graphify-out" / "GRAPH_REPORT.md"
    tree = git_tree_report(dest) if (dest / ".git").exists() else {"head": ""}
    head = tree.get("head") or ""
    if not report.is_file():
        return {**empty, "head": _short_sha(head)}
    try:
        parsed = parse_graph_report(report.read_text())
    except OSError:
        parsed = parse_graph_report("")
    fresh = parsed.get("fresh") or ""
    stale = True
    if fresh and head:
        stale = not (head.startswith(fresh) or fresh.startswith(head[: min(7, len(head))]))
    elif fresh or head:
        stale = True
    else:
        stale = True
    return {
        "age": graph_age_of(dest),
        "commit": fresh,
        "head": _short_sha(head),
        "stale": stale,
        "present": True,
    }


def _issue_ready(issue: dict) -> bool:
    if (issue.get("column") or "") == "ready":
        return True
    labels = issue.get("labels")
    if not labels:
        return False
    return "ready" in label_names(issue)


def pin_research(project: dict, dest: Path | None, research_files: list[str], issues: list[dict] | None = None) -> dict:
    issues = issues or []
    docs = []
    spec_rel = ""
    prd_rel = ""
    for rel in research_files or []:
        if dest is not None and (dest / rel).is_file():
            docs.append(rel)
            name = Path(rel).name.lower()
            if name == "spec.md" and not spec_rel:
                spec_rel = rel
            if name == "prd.md" and not prd_rel:
                prd_rel = rel
    text = ""
    if dest and spec_rel:
        text = (dest / spec_rel).read_text()
    elif dest and prd_rel:
        text = (dest / prd_rel).read_text()
    unshipped = spec_gaps(text, issues, dest=dest) if text else []
    open_items = [item for item in issues if (item.get("state") or "OPEN").upper() != "CLOSED"]
    open_non_ready = [item for item in open_items if not _issue_ready(item)]
    spec_present = bool(spec_rel)
    prd_present = bool(prd_rel)
    if not spec_present and not prd_present:
        gap = "нет"
    elif unshipped or (text and not spec_bullets(text) and open_non_ready):
        gap = "частично"
    else:
        gap = "есть"
    hint = git_worktree_hint(dest)
    graph = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
    freshness = graph_freshness(dest)
    caution = ""
    if hint["dirty"] or hint["unpushed"] or freshness.get("stale"):
        caution = "не плоди Issues"
    row = {
        "name": project.get("name"),
        "repo": project.get("repo"),
        "cwd": str(dest) if dest else None,
        "docs": docs,
        "graphify": bool(graph and graph.is_file()),
        "graph_age": freshness.get("age") or graph_age_of(dest),
        "graph_commit": freshness.get("commit") or "",
        "graph_head": freshness.get("head") or "",
        "graph_stale": bool(freshness.get("stale")),
        "graphify_note": (
            f"graph {freshness.get('age') or 'no'}"
            + (f" stale vs HEAD {freshness.get('head')}" if freshness.get("stale") else "")
        ),
        "caution": caution,
        "spec_present": spec_present,
        "prd_present": prd_present,
        "gap": gap,
        "unshipped": unshipped,
        "open_non_ready": [
            f"{item.get('repo') or ''}#{item.get('number') or ''} {item.get('title') or ''}".strip()
            for item in open_non_ready[:5]
        ],
        "dirty": hint["dirty"],
        "unpushed": hint["unpushed"],
    }
    if (project.get("name") or "") == "corp":
        trees = two_trees_report()
        row.update(
            {
                "live_path": trees["live_path"],
                "writers_path": trees["writers_path"],
                "live_sha": trees["live_sha"],
                "writers_sha": trees["writers_sha"],
                "live_git": _tree_git_label(trees["live"]),
                "writers_git": _tree_git_label(trees["writers"]),
                "trees_match": trees["trees_match"],
            }
        )
    return row


def research_report(reg: dict, issues: list[dict] | None = None) -> list[dict]:
    files = reg.get("research_files") or []
    if issues is None:
        issues = collect_issues(reg, skip_blocked=False, states=("open", "closed"))
    rows = []
    for project in pinned_projects(reg) or active_projects(reg):
        dest = project_dir(project)
        mine = [
            item
            for item in (issues or [])
            if item.get("project") == project.get("name") or item.get("repo") == project.get("repo")
        ]
        rows.append(pin_research(project, dest, files, mine))
    return rows


def parse_graph_report(text: str) -> dict:
    out = {
        "nodes": 0,
        "edges": 0,
        "communities": 0,
        "hubs": [],
        "gods": [],
        "groups": [],
        "bridges": [],
        "fresh": "",
    }
    stats = re.search(r"(\d+)\s+nodes\s+·\s+(\d+)\s+edges\s+·\s+(\d+)\s+communities", text)
    if stats:
        out["nodes"] = int(stats.group(1))
        out["edges"] = int(stats.group(2))
        out["communities"] = int(stats.group(3))
    commit = re.search(r"Built from commit:\s+`([^`]+)`", text)
    if commit:
        out["fresh"] = commit.group(1)
    hubs = re.search(r"## Community Hubs.*?\n(?:- .+\n)+", text)
    if hubs:
        out["hubs"] = [line[2:].strip() for line in hubs.group(0).splitlines() if line.startswith("- ")][:12]
    for line in text.splitlines():
        god = re.search(r"^\d+\.\s+`([^`]+)`\s+-\s+(\d+)\s+edges", line)
        if god:
            out["gods"].append({"name": god.group(1), "edges": int(god.group(2))})
    for block in re.finditer(
        r'### Community \d+ - "([^"]+)"\s*\nCohesion:\s*([0-9.]+)\s*\nNodes \((\d+)\):\s*(.*)',
        text,
    ):
        raw = re.sub(r"\s*\(\+\d+ more\)\s*$", "", (block.group(4) or "").strip())
        names = [part.strip() for part in raw.split(",") if part.strip()][:16]
        out["groups"].append(
            {
                "name": block.group(1),
                "cohesion": float(block.group(2)),
                "size": int(block.group(3)),
                "nodes": names,
            }
        )
    out["bridges"] = [
        {"a": a, "rel": rel, "b": b}
        for a, rel, b in re.findall(r"- `([^`]+)` --(\w+)--> `([^`]+)`", text)
    ][:6]
    out["gods"] = out["gods"][:10]
    return out


def graphs_index(reg: dict) -> list[dict]:
    rows = []
    for project in active_projects(reg):
        dest = project_dir(project)
        report = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
        parsed = parse_graph_report(report.read_text()) if report and report.is_file() else parse_graph_report("")
        age = ""
        if report and report.is_file():
            age = time.strftime("%Y-%m-%d", time.localtime(report.stat().st_mtime))
        rows.append(
            {
                "name": project["name"],
                "repo": project.get("repo"),
                "pinned": is_pinned(project),
                "cwd": str(dest) if dest else None,
                "has_graph": bool(report and report.is_file()),
                "age": age,
                **parsed,
            }
        )
    rows.sort(key=lambda row: (not row["pinned"], not row["has_graph"], row["name"] or ""))
    return rows


def graph_detail(reg: dict, name: str) -> dict:
    project = project_by_name(reg, name)
    dest = project_dir(project)
    report = dest / "graphify-out" / "GRAPH_REPORT.md" if dest else None
    if report is None or not report.is_file():
        return {
            "name": project["name"],
            "repo": project.get("repo"),
            "pinned": is_pinned(project),
            "cwd": str(dest) if dest else None,
            "has_graph": False,
            "age": "",
            **parse_graph_report(""),
        }
    parsed = parse_graph_report(report.read_text())
    parsed.update(
        {
            "name": project["name"],
            "repo": project.get("repo"),
            "pinned": is_pinned(project),
            "cwd": str(dest) if dest else None,
            "has_graph": True,
            "age": time.strftime("%Y-%m-%d", time.localtime(report.stat().st_mtime)),
        }
    )
    return parsed


def cycle_payload(reg: dict) -> dict:
    if not gh_ready():
        return {
            "mode": "auth",
            "next": None,
            "doctor": doctor_payload(),
            "instruction": "run gh auth login",
        }

    issues = collect_issues(reg, skip_blocked=False, states=("open", "closed"))
    open_issues = [item for item in issues if (item.get("state") or "OPEN").upper() != "CLOSED"]
    blocked_label = reg.get("labels", {}).get("blocked", "blocked")
    open_unblocked = [item for item in open_issues if blocked_label not in label_names(item)]
    ready, other = split_ready(reg, open_unblocked)
    trees = two_trees_report()
    if ready:
        nxt = ready[0]
        dest = project_dir(project_by_name(reg, nxt["project"]))
        return {
            "mode": "execute",
            "next": {
                "repo": nxt["repo"],
                "issue": nxt["number"],
                "title": nxt["title"],
                "url": nxt["url"],
                "project": nxt["project"],
                "cwd": str(dest) if dest else None,
            },
            "ready": ready,
            "trees": trees,
        }

    research = research_report(reg, issues)
    graphify_needed = any(row.get("graph_stale") for row in research)
    return {
        "mode": "research",
        "next": None,
        "open_unblocked": other[:20],
        "research": research,
        "trees": trees,
        "graphify_refresh": {
            "needed": graphify_needed,
            "note": "graphify did not refresh" if graphify_needed else "graphify fresh vs HEAD",
        },
        "instruction": (
            "No ready Issues. Follow HARNESS.md research loop. "
            "Compare SPEC/PRD to the board. Write workshop drafts for gaps. "
            "Do not file GitHub ready Issues. Do not mint a fake backlog. "
            "Do not auto-Approve drafts."
        ),
    }


def render(payload: dict) -> str:
    if payload.get("mode") == "auth":
        lines = ["=== CORP CYCLE ===", "mode: auth", ""]
        lines += doctor_lines(payload.get("doctor") or doctor_payload())
        lines += ["", payload.get("instruction") or "run gh auth login"]
        return "\n".join(lines) + "\n"
    lines = ["=== CORP CYCLE ===", f"mode: {payload['mode']}"]
    nxt = payload.get("next")
    if nxt:
        lines += [
            "",
            "NEXT",
            f"repo: {nxt['repo']}",
            f"issue: #{nxt['issue']}",
            f"title: {nxt['title']}",
            f"url: {nxt['url']}",
            f"cwd: {nxt.get('cwd') or '(clone via ./bin/corp bootstrap)'}",
            "",
            "Take this Issue only after corp take (self) or a VPS launch.",
            "Do not invent other work. Skip NEXT if you already claimed another Issue.",
        ]
        extras = payload.get("ready") or []
        if len(extras) > 1:
            lines += ["", "QUEUE"]
            for item in extras[1:6]:
                lines.append(f"- {item['repo']}#{item['number']} {item['title']}")
        return "\n".join(lines) + "\n"

    lines += ["", "NEXT: research", "", payload.get("instruction", "")]
    trees = payload.get("trees") or {}
    if trees:
        lines += [
            "",
            "TREES",
            f"writers: {trees.get('writers_path') or 'missing'} {_short_sha(trees.get('writers_sha') or '')} {_tree_git_label(trees.get('writers') or {})}",
            f"live: {trees.get('live_path') or 'missing'} {_short_sha(trees.get('live_sha') or '')} {_tree_git_label(trees.get('live') or {})}",
        ]
        if not trees.get("trees_match"):
            lines.append("trees diverge")
    open_items = payload.get("open_unblocked") or []
    if open_items:
        lines += ["", "OPEN (not labeled ready)"]
        for item in open_items[:10]:
            lines.append(f"- {item['repo']}#{item['number']} {item['title']}")
    lines += ["", "PROJECTS"]
    for row in payload.get("research") or []:
        spec = "SPEC yes" if row.get("spec_present") else "SPEC no"
        prd = "PRD yes" if row.get("prd_present") else "PRD no"
        gap = row.get("gap") or "нет"
        graph = f"graph {row.get('graph_age') or 'no'}"
        git_bits = []
        if row.get("dirty"):
            git_bits.append("dirty")
        if row.get("unpushed"):
            git_bits.append("unpushed")
        git = ", ".join(git_bits) if git_bits else "clean"
        cwd = row.get("cwd") or "not cloned"
        graph_note = row.get("graphify_note") or graph
        lines.append(f"- {row.get('name')}: {cwd} | {spec} | {prd} | gap {gap} | {graph_note} | {git}")
        if row.get("live_path") or row.get("writers_path"):
            writers = row.get("writers_path") or cwd
            live = row.get("live_path") or ""
            lines.append(
                f"  writers: {writers} {_short_sha(row.get('writers_sha') or '')} {row.get('writers_git') or git}"
            )
            lines.append(
                f"  live: {live} {_short_sha(row.get('live_sha') or '')} {row.get('live_git') or 'missing'}"
            )
            if not row.get("trees_match"):
                lines.append("  trees diverge")
        if row.get("caution"):
            lines.append(f"  caution: {row['caution']}")
        if row.get("graph_stale"):
            lines.append("  graphify did not refresh")
        for bullet in row.get("unshipped") or []:
            lines.append(f"  unshipped: {bullet[:120]}")
        if not row.get("unshipped"):
            for item in row.get("open_non_ready") or []:
                lines.append(f"  open not ready: {item[:120]}")
    refresh = payload.get("graphify_refresh") or {}
    if refresh.get("needed"):
        lines += ["", f"graphify: {refresh.get('note') or 'graphify did not refresh'}"]
    return "\n".join(lines) + "\n"


def write_next(text: str) -> Path:
    path = ROOT / "memory" / "next.local.md"
    path.write_text(text)
    return path


def status(reg: dict) -> None:
    print(f"workspace: {workspace()}")
    print(f"planner: {reg.get('planner')}")
    for project in reg.get("projects", []):
        dest = project_dir(project)
        mark = dest or "missing"
        print(f"{project['status']:7} {project['name']:28} {mark}")


def doctor_payload(isolation: dict | None = None) -> dict:
    load_env()
    live = live_corp_path()
    tree = git_tree_report(live)
    writers_path = writers_corp_path()

    def best_effort_fetch(path: Path) -> None:
        if path.is_dir():
            run(["git", "-C", str(path), "fetch", "origin", "--quiet"], check=False, timeout=20)

    best_effort_fetch(live)
    best_effort_fetch(writers_path)
    writers = git_tree_report(writers_path)
    trees = two_trees_report()
    ts = tailscale_status()
    iso = isolation if isolation is not None else probe_isolation()
    db_mode = workshop_db_mode()
    uvicorn_sha = uvicorn_target_sha()
    uvicorn = uvicorn_process_report()
    freshness = graph_freshness(ROOT)
    checks = [
        ("git", have("git")),
        ("gh", have("gh")),
        ("gh auth", gh_ready()),
        ("python3", have("python3")),
        ("uv", have("uv")),
        ("graphify", have("graphify")),
        ("claude", have("claude")),
        ("codex", have("codex")),
        ("grok", have("grok")),
        ("cursor", kind_cli_ok("cursor")),
        ("tmux", have("tmux")),
        ("telegram token", bool(os.environ.get("TELEGRAM_BOT_TOKEN"))),
        ("telegram chat", bool(os.environ.get("TELEGRAM_CHAT_ID"))),
        ("telegram bot auth", tg_bot_auth_ok()),
        ("telegram delivery", tg_delivery_ok()),
        ("workshop unit", workshop_unit_active()),
        ("live /opt/corp clean", tree["exists"] and not tree["dirty"]),
        ("live /opt/corp at origin/main", tree["exists"] and bool(tree["origin_main"]) and not tree["behind"]),
        ("writers fresh after fetch", writers.get("exists") and bool(writers.get("origin_main")) and not writers["behind"]),
        ("auth_policy", auth_policy_present()),
        ("workshop.db 0600", workshop_db_mode_ok()),
        ("uvicorn serves live HEAD", bool(uvicorn.get("ok"))),
        ("tailscale serve", ts["serve"]),
        ("tailscale funnel off", not ts["funnel"]),
        ("agent identity isolated", bool(iso.get("isolated"))),
    ]
    return {
        "corp": str(ROOT),
        "workspace": str(workspace()),
        "live": str(live),
        "writers": str(writers_corp_path()),
        "live_exists": tree["exists"],
        "live_sha": tree["head"],
        "writers_sha": writers.get("head") or "",
        "live_dirty": tree["dirty"] if tree["exists"] else True,
        "live_behind": tree["behind"] if tree["exists"] else True,
        "writers_dirty": writers["dirty"] if writers.get("exists") else True,
        "writers_behind": writers["behind"] if writers.get("exists") else True,
        "trees_match": trees["trees_match"],
        "uvicorn_sha": uvicorn_sha,
        "uvicorn": uvicorn,
        "workshop_db_mode": db_mode,
        "workshop_db_path": str(workshop_service_db()),
        "graphify_stale": bool(freshness.get("stale")),
        "graphify_note": (
            "graphify did not refresh"
            if freshness.get("stale")
            else "graphify fresh vs HEAD"
        ),
        "isolation": iso.get("mode") or "transitional",
        "isolation_reason": iso.get("reason") or "; ".join(iso.get("blockers") or []),
        "isolation_blockers": iso.get("blockers") or [],
        "tg_health": tg_health(),
        "checks": [{"name": name, "ok": ok} for name, ok in checks],
    }


def doctor_lines(payload: dict | None = None) -> list[str]:
    payload = payload or doctor_payload()
    iso = payload.get("isolation") or "transitional"
    reason = payload.get("isolation_reason") or ""
    iso_line = f"isolation: {iso}" + (f" ({reason})" if reason and iso != "isolated" else "")
    writers_sha = _short_sha(payload.get("writers_sha") or "")
    live_sha = _short_sha(payload.get("live_sha") or "")
    diverge = "" if payload.get("trees_match") else "trees diverge"
    uvicorn = payload.get("uvicorn") or {}
    lines = [
        f"corp: {payload.get('corp')}",
        f"workspace: {payload.get('workspace')}",
        f"writers: {payload.get('writers') or 'missing'} {writers_sha or '—'}",
        f"live: {payload.get('live') or 'missing'} {live_sha or '—'}",
        f"live HEAD: {payload.get('live_sha') or '—'}",
        f"uvicorn should serve: {payload.get('uvicorn_sha') or '—'}",
        f"uvicorn pid: {uvicorn.get('pid') or '—'} cwd {uvicorn.get('cwd') or '—'}",
        f"workshop.db: {payload.get('workshop_db_mode') or 'missing'} ({payload.get('workshop_db_path') or ''})",
        f"graphify: {payload.get('graphify_note') or ''}",
        iso_line,
    ]
    if diverge:
        lines.append(diverge)
    lines += [f"{'ok' if row['ok'] else 'NO':2}  {row['name']}" for row in payload.get("checks") or []]
    return lines


def doctor() -> None:
    print("\n".join(doctor_lines()))
    payload = doctor_payload()
    blockers = payload.get("isolation_blockers") or []
    if blockers:
        print(f"    isolation blockers: {'; '.join(blockers)}")


def tg_creds() -> tuple[str, str]:
    load_env()
    return os.environ.get("TELEGRAM_BOT_TOKEN") or "", os.environ.get("TELEGRAM_CHAT_ID") or ""


def tg_post(method: str, payload: dict) -> dict:
    import urllib.parse
    import urllib.request

    token, _ = tg_creds()
    if not token:
        die("telegram not configured. Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in ~/.config/corp/env")
    url = f"https://api.telegram.org/bot{token}/{method}"
    body = urllib.parse.urlencode(payload).encode()
    try:
        raw = urllib.request.urlopen(url, data=body, timeout=20).read()
    except Exception as exc:
        die(f"telegram {method} failed: {exc}")
    return json.loads(raw.decode() or "{}")


def notify(
    text: str,
    buttons: list | None = None,
    keyboard: list | None = None,
    force_reply: bool = False,
    parse_mode: str = "",
) -> dict:
    _, chat = tg_creds()
    if not chat:
        die("telegram not configured. Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in ~/.config/corp/env")
    payload = {"chat_id": chat, "text": redact_secrets(text), "disable_web_page_preview": "true"}
    if parse_mode:
        payload["parse_mode"] = parse_mode
    if force_reply:
        payload["reply_markup"] = json.dumps({"force_reply": True, "selective": True})
    elif buttons:
        payload["reply_markup"] = json.dumps({"inline_keyboard": buttons})
    elif keyboard:
        payload["reply_markup"] = json.dumps({
            "keyboard": keyboard,
            "resize_keyboard": True,
            "is_persistent": True,
        })
    result = tg_post("sendMessage", payload)
    print("notified")
    return result if isinstance(result, dict) else {}


def notify_safe(
    text: str,
    buttons: list | None = None,
    keyboard: list | None = None,
    force_reply: bool = False,
    parse_mode: str = "",
) -> dict:
    try:
        return notify(text, buttons=buttons, keyboard=keyboard, force_reply=force_reply, parse_mode=parse_mode) or {}
    except (SystemExit, CorpError) as exc:
        detail = redact_secrets(str(exc.args[0] if exc.args else exc))
        token_set, chat_set = tg_creds()
        if token_set and chat_set:
            record_event("tg_fail", "bot", tg_clip(detail, 160))
        print("telegram skipped", file=sys.stderr)
        return {}


def tg_health(window: float = 3600.0, path: Path | None = None) -> dict:
    fails = [row for row in load_events(80, path=path) if row.get("kind") == "tg_fail"]
    now = time.time()
    recent = [row for row in fails if now - float(row.get("t") or 0) <= window]
    last_age = now - float(fails[0].get("t") or 0) if fails else None
    return {"fails_1h": len(recent), "last_fail_age": last_age}


def tg_bot_auth_ok() -> bool:
    token, _ = tg_creds()
    if not token:
        return True
    try:
        payload = tg_post("getMe", {})
    except (CorpError, SystemExit):
        return False
    return bool(payload.get("ok"))


def tg_delivery_ok(window: float = 3600.0, path: Path | None = None) -> bool:
    return tg_health(window=window, path=path)["fails_1h"] == 0


def tg_send(
    text: str,
    buttons: list | None = None,
    keyboard: list | None = None,
    force_reply: bool = False,
) -> dict:
    return notify_safe(
        text, buttons=buttons, keyboard=keyboard, force_reply=force_reply, parse_mode="HTML"
    )


def need_human(text: str, buttons: list | None = None) -> None:
    first = redact_secrets((text or "").strip().split("\n", 1)[0])
    action_ref = ""
    ref = "Нужно тебя"
    found = re.search(r"([\w.-]+/[\w.-]+#\d+)", text or "")
    if found:
        action_ref = found.group(1)
        try:
            repo, number = parse_issue_ref(action_ref)
            ref = tg_short_ref(repo, number)
        except CorpError:
            ref = action_ref
    tg_notify_event("need_human", ref, tg_clip(first, 60), buttons=buttons, action_ref=action_ref)


def config_dir() -> Path:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    return CONFIG_DIR


def default_slot() -> dict:
    return {"kind": "claude", "model": "", "effort": "high", "fast": False}


def default_workshop() -> dict:
    return {
        "profiles": [dict(item) for item in DEFAULT_PROFILES],
        "queue": [],
        "queue_running": False,
        "max_parallel": 3,
        "catalog": {},
        "slots": {},
        "drafts": [],
        "orch": {},
        "tg_offset": 0,
        "tg_reply": {},
        "tg_status": {},
        "tg_board": {},
        "tg_cycle": {},
        "tg_more": {},
        "registry": {},
        "auto_queue_on_approve": True,
        "queue_retries": QUEUE_MAX_ATTEMPTS,
        "council": {},
        "board_snap": {},
        "board_ov": {},
        "board_sync": [],
    }


def load_workshop() -> dict:
    path = WORKSHOP_JSON
    if not path.is_file():
        data = default_workshop()
        save_workshop(data)
        return data
    data = json.loads(path.read_text())
    data.setdefault("profiles", [dict(item) for item in DEFAULT_PROFILES])
    data.setdefault("queue", [])
    data.setdefault("queue_running", False)
    data.setdefault("max_parallel", 3)
    data.setdefault("catalog", {})
    data.setdefault("slots", {})
    data.setdefault("drafts", [])
    data.setdefault("orch", {})
    data.setdefault("tg_offset", 0)
    data.setdefault("tg_reply", {})
    data.setdefault("tg_status", {})
    data.setdefault("tg_board", {})
    data.setdefault("tg_cycle", {})
    data.setdefault("tg_more", {})
    data.setdefault("registry", {})
    data.setdefault("auto_queue_on_approve", True)
    data.setdefault("queue_retries", QUEUE_MAX_ATTEMPTS)
    data.setdefault("council", {})
    data.setdefault("board_snap", {})
    data.setdefault("board_ov", {})
    data.setdefault("board_sync", [])
    return sanitize_workshop(data)


@contextmanager
def workshop_lock():
    config_dir()
    handle = open(CONFIG_DIR / "workshop.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(handle, fcntl.LOCK_UN)
        handle.close()


def save_workshop(data: dict) -> None:
    config_dir()
    sanitize_workshop(data)
    tmp = WORKSHOP_JSON.with_name(".workshop.json.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    tmp.replace(WORKSHOP_JSON)


def profile_by_id(profile_id: str) -> dict:
    for item in load_workshop().get("profiles") or []:
        if item.get("id") == profile_id:
            return item
    die(f"unknown profile: {profile_id}")


def slots_for(name: str) -> dict:
    data = load_workshop()
    current = data.get("slots", {}).get(name) or {}
    out = {}
    for role in SLOT_ROLES:
        slot = dict(default_slot())
        slot.update(current.get(role) or {})
        if role in {"design", "qa"} and not current.get(role):
            slot = dict(out.get("build") or slot)
        out[role] = slot
    return out


def save_slots(name: str, slots: dict) -> dict:
    data = load_workshop()
    data.setdefault("slots", {})[name] = slots
    save_workshop(data)
    return slots


def slot_for_issue(name: str, issue: dict) -> tuple[str, dict]:
    names = label_names(issue)
    slots = slots_for(name)
    if "in-qa" in names and "qa-fail" not in names:
        return "qa", slots["qa"]
    if "design" in names:
        return "design", slots["design"]
    return "build", slots["build"]


def _help_text(binary: str) -> str:
    chunks = []
    for args in ([binary, "--help"],):
        proc = run(args, check=False, timeout=8)
        chunks.append(proc.stdout or "")
        chunks.append(proc.stderr or "")
    return "\n".join(chunks)


def _resolved_binary(binary: str) -> str:
    ensure_path()
    path = shutil.which(binary)
    if not path:
        return ""
    try:
        return str(Path(path).resolve())
    except OSError:
        return path


def _same_resolved(left: str, right: str) -> bool:
    a, b = _resolved_binary(left), _resolved_binary(right)
    return bool(a and b and a == b)


def _cli_identity(help_text: str = "", version_text: str = "", resolved: str = "") -> str:
    path = (resolved or "").replace("\\", "/").lower()
    if "/.grok/" in path or "grok-linux" in path or "/grok/bin/" in path:
        return "grok"
    head = "\n".join((help_text or "").splitlines()[:16]).lower()
    ver = (version_text or "").strip().lower()
    help_l = (help_text or "").lower()
    if ver.startswith("grok ") or "grok build tui" in head or "usage: grok " in head or "logged in with grok.com" in help_l:
        return "grok"
    blob = f"{head}\n{ver}"
    if "cursor agent" in blob or "cursor.com" in blob or "anysphere" in blob:
        return "cursor"
    return ""


def _probe_cli_identity(binary: str) -> str:
    if not have(binary):
        return ""
    if binary != "grok" and _same_resolved(binary, "grok"):
        return "grok"
    resolved = _resolved_binary(binary)
    help_text = _help_text(binary)
    ver = run([binary, "--version"], check=False, timeout=8)
    version_text = (ver.stdout or "") + "\n" + (ver.stderr or "")
    return _cli_identity(help_text, version_text, resolved)


def _cursor_mismatch_note(identity: str) -> str:
    if identity == "grok":
        return "agent — это Grok, не Cursor Agent"
    return "нет Cursor Agent"


def kind_cli_ok(kind: str) -> bool:
    binary = KIND_BIN.get(kind, "")
    if not binary or not have(binary):
        return False
    if kind != "cursor":
        return True
    if _same_resolved(binary, "grok"):
        return False
    return _probe_cli_identity(binary) == "cursor"


_MODEL_TOKEN = re.compile(r"^[A-Za-z][A-Za-z0-9._+-]{1,80}$")
_MODEL_SKIP = {
    "available", "default", "model", "models", "name", "id", "you", "the",
    "usage", "options", "commands", "arguments", "help", "logged", "with",
}
_MODEL_ALIASES = {"sonnet", "opus", "haiku", "fable", "composer"}
_MODEL_LIST = {
    "claude": [],
    "codex": [["codex", "debug", "models"]],
    "grok": [["grok", "models"]],
    "cursor": [["agent", "models"]],
}


def _looks_like_model(token: str) -> bool:
    if not _MODEL_TOKEN.match(token) or token.lower() in _MODEL_SKIP:
        return False
    if any(ch in token for ch in "/\\:"):
        return False
    low = token.lower()
    if low.startswith(("gpt-", "grok-", "claude-", "codex-")):
        return True
    return bool(any(ch.isdigit() for ch in token) or low in _MODEL_ALIASES)


def _models_from_json(text: str) -> tuple[list[str], list[str], bool]:
    start = text.find("{")
    if start < 0:
        start = text.find("[")
    if start < 0:
        return [], [], False
    try:
        payload = json.loads(text[start:])
    except json.JSONDecodeError:
        return [], [], False
    rows = payload.get("models") if isinstance(payload, dict) else payload
    if not isinstance(rows, list):
        return [], [], False
    models: list[str] = []
    efforts: list[str] = []
    fast = False
    for row in rows:
        if not isinstance(row, dict):
            continue
        if row.get("visibility") == "hide":
            continue
        slug = str(row.get("slug") or row.get("id") or row.get("model") or "")
        if _looks_like_model(slug) and slug not in models:
            models.append(slug)
        for item in row.get("supported_reasoning_levels") or []:
            effort = item.get("effort") if isinstance(item, dict) else ""
            if effort and effort not in efforts:
                efforts.append(str(effort))
        if row.get("additional_speed_tiers") or row.get("service_tiers"):
            fast = True
    return models[:40], efforts, fast


def _parse_models(text: str) -> list[str]:
    found = []
    for raw in text.splitlines():
        stripped = raw.strip()
        token = ""
        if stripped.startswith(("*", "•", "+")) or (stripped.startswith("- ") and not stripped.startswith("--")):
            line = stripped.lstrip("*•+").strip()
            if line.startswith("- "):
                line = line[2:].strip()
            token = (line.split() or [""])[0].strip("`,\"'()[]")
        elif stripped and " " not in stripped and not stripped.startswith("-"):
            token = stripped.strip("`,\"'()[]")
        if token and _looks_like_model(token) and token not in found:
            found.append(token)
    for token in re.findall(r"'([A-Za-z][A-Za-z0-9._+-]{1,60})'", text):
        if _looks_like_model(token) and token not in found:
            found.append(token)
    return found[:40]


def _parse_efforts(text: str) -> list[str]:
    order = ["low", "med", "medium", "high", "xhigh", "max"]
    for match in re.finditer(r"\(([^)]{0,80})\)", text.lower()):
        parts = [part.strip() for part in match.group(1).split(",")]
        hit = [name for name in order if name in parts]
        if len(hit) >= 2:
            if "medium" in hit and "med" in hit:
                hit = [name for name in hit if name != "med"]
            return hit
    return []


def probe_kind(kind: str) -> dict:
    binary = KIND_BIN[kind]
    row = {
        "kind": kind,
        "installed": have(binary),
        "models": [],
        "efforts": [],
        "fast": False,
        "stale": False,
        "identity": "",
        "note": "",
    }
    if not row["installed"]:
        if kind == "cursor":
            row["note"] = _cursor_mismatch_note("")
        return row
    help_text = _help_text(binary)
    ver = run([binary, "--version"], check=False, timeout=8)
    version_text = (ver.stdout or "") + "\n" + (ver.stderr or "")
    resolved = _resolved_binary(binary)
    identity = _cli_identity(help_text, version_text, resolved)
    if kind == "cursor" and identity != "cursor":
        if identity != "grok" and _same_resolved(binary, "grok"):
            identity = "grok"
        row["installed"] = False
        row["identity"] = identity or "unknown"
        row["note"] = _cursor_mismatch_note(identity)
        return row
    row["identity"] = identity or kind
    help_l = help_text.lower()
    if "--effort" in help_l or "reasoning effort" in help_l:
        row["efforts"] = _parse_efforts(help_text) or ["low", "high"]
    if "service_tier" in help_l or re.search(r"--fast\b", help_l):
        row["fast"] = True
    models = _parse_models(help_text) if kind == "claude" else []
    for args in _MODEL_LIST.get(kind) or []:
        proc = run(args, cwd=Path.home(), check=False, timeout=20)
        raw = (proc.stdout or "") + "\n" + (proc.stderr or "")
        json_models, json_efforts, json_fast = _models_from_json(raw)
        if json_models:
            models = json_models
            if json_efforts:
                row["efforts"] = json_efforts
            if json_fast:
                row["fast"] = True
            break
        listed = _parse_models(raw)
        if listed:
            models = listed
            break
    row["models"] = models
    return row


def merge_catalog_row(prev: dict, row: dict) -> dict:
    old = prev or {}
    if not row.get("installed"):
        return row
    if old.get("identity") and row.get("identity") and old.get("identity") != row.get("identity"):
        return row
    if row.get("kind") == "cursor" and not row.get("models"):
        old_models = [str(m) for m in old.get("models") or []]
        if any(name.lower().startswith("grok-") for name in old_models):
            return row
    if row.get("installed") and not row.get("models") and old.get("models"):
        out = dict(old)
        out["stale"] = True
        out["installed"] = True
        if row.get("identity"):
            out["identity"] = row["identity"]
        return out
    return row


def probe_catalog() -> dict:
    prev = (load_workshop().get("catalog") or {}).get("kinds") or {}
    catalog = {}
    for kind in KIND_BIN:
        try:
            row = merge_catalog_row(prev.get(kind) or {}, probe_kind(kind))
        except Exception:
            row = dict(prev.get(kind) or {"kind": kind, "installed": False, "models": [], "efforts": [], "fast": False})
            row["stale"] = True
        catalog[kind] = row
    data = load_workshop()
    data["catalog"] = {"probed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "kinds": catalog}
    save_workshop(data)
    return data["catalog"]


def sanitize_catalog(cached: dict, cursor_ok: bool | None = None) -> dict:
    kinds = cached.get("kinds")
    if not kinds:
        return cached
    cursor = kinds.get("cursor") or {}
    if not cursor.get("installed"):
        return cached
    if cursor_ok is None:
        cursor_ok = kind_cli_ok("cursor")
    if cursor_ok:
        return cached
    cleaned = dict(cached)
    cleaned_kinds = dict(kinds)
    identity = cursor.get("identity") or "grok"
    cleaned_kinds["cursor"] = {
        "kind": "cursor",
        "installed": False,
        "models": [],
        "efforts": [],
        "fast": False,
        "stale": False,
        "identity": identity,
        "note": _cursor_mismatch_note(identity),
    }
    cleaned["kinds"] = cleaned_kinds
    return cleaned


def load_catalog() -> dict:
    data = load_workshop()
    cached = data.get("catalog") or {}
    if cached.get("kinds"):
        cleaned = sanitize_catalog(cached)
        if cleaned != cached:
            data["catalog"] = cleaned
            save_workshop(data)
        return cleaned
    return probe_catalog()


def log_line_matches_issue(line: str, prefix: str) -> bool:
    text = (prefix or "").strip()
    if not text:
        return False
    start = 0
    while True:
        idx = line.find(text, start)
        if idx < 0:
            return False
        end = idx + len(text)
        if end >= len(line) or not line[end].isdigit():
            return True
        start = idx + 1


def last_log_lines(n: int = 3, prefix: str = "") -> str:
    if not RUN_LOG.is_file():
        return "тишина"
    lines = [line.rstrip() for line in RUN_LOG.read_text().splitlines() if line.strip()]
    if prefix:
        lines = [line for line in lines if log_line_matches_issue(line, prefix)]
    if not lines:
        return "тишина"
    clipped = []
    for line in lines[-n:]:
        clipped.append(redact_secrets(line[:200]))
    return "\n".join(clipped)


def pulse_label(kind: str, model: str = "") -> str:
    return model or f"auto · {kind}"


def pulse_loop(repo: str, number: int, kind: str, started: float, stop: threading.Event, model: str = "") -> None:
    ref = issue_ref(repo, number)
    while not stop.wait(300):
        minutes = int((time.time() - started) / 60)
        append_log(f"{time.time():.0f} {ref} heartbeat · {pulse_label(kind, model)} · {minutes} min\n")


def ensure_seed_labels(repo: str) -> None:
    for name in SEED_LABELS:
        ensure_label(repo, name)


def set_pin(reg: dict, name: str, pinned: bool) -> dict:
    project = project_by_name(reg, name)
    if not project.get("repo"):
        die(f"unknown project: {name}")
    project["workshop"] = pinned
    save_registry(reg)
    return project


def hide_project(reg: dict, name: str) -> dict:
    return set_pin(reg, name, False)


def archive_project(reg: dict, name: str) -> dict:
    project = project_by_name(reg, name)
    if not project.get("repo"):
        die(f"unknown project: {name}")
    proc = run(["gh", "repo", "archive", project["repo"], "--yes"], check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or "archive failed").strip())
    project["workshop"] = False
    project["status"] = "paused"
    save_registry(reg)
    return project


def org_repos(reg: dict) -> list[dict]:
    org = org_name(reg)
    pinned = {p.get("repo") for p in pinned_projects(reg)}
    found = {}
    for extra in ([], ["--archived"]):
        proc = run(
            ["gh", "repo", "list", org, "--limit", "200", "--json", "name,nameWithOwner,isArchived", *extra],
            check=False,
        )
        if proc.returncode != 0:
            die((proc.stderr or proc.stdout or "repo list failed").strip())
        for item in json.loads(proc.stdout or "[]"):
            repo = item.get("nameWithOwner") or f"{org}/{item.get('name')}"
            found[repo] = {
                "name": item.get("name") or repo.split("/")[-1],
                "repo": repo,
                "archived": bool(item.get("isArchived")),
                "pinned": repo in pinned,
            }
    rows = list(found.values())
    rows.sort(key=lambda row: (not row["pinned"], row["archived"], row["name"] or ""))
    return rows


def unarchive_project(reg: dict, repo: str) -> dict:
    org = org_name(reg)
    if "/" not in repo:
        repo = f"{org}/{repo}"
    if not repo.startswith(org + "/"):
        die(f"only {org} repos")
    view = run(["gh", "repo", "view", repo, "--json", "isArchived,nameWithOwner"], check=False)
    if view.returncode != 0:
        die((view.stderr or view.stdout or f"missing {repo}").strip())
    info = json.loads(view.stdout)
    if info.get("isArchived"):
        proc = run(["gh", "repo", "unarchive", repo, "--yes"], check=False)
        if proc.returncode != 0:
            die((proc.stderr or proc.stdout or "unarchive failed").strip())
    return add_existing(reg, repo)


def _clone_to_workspace(repo: str, name: str) -> Path:
    dest = workspace() / name
    if dest.is_dir() and (dest / ".git").exists():
        run(["git", "pull", "--ff-only"], cwd=dest, check=False)
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    proc = run(["gh", "repo", "clone", repo, str(dest)], check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or f"clone failed: {repo}").strip())
    return dest


def add_existing(reg: dict, repo: str) -> dict:
    org = org_name(reg)
    if "/" not in repo:
        repo = f"{org}/{repo}"
    if not repo.startswith(org + "/"):
        die(f"only {org} repos")
    view = run(["gh", "repo", "view", repo, "--json", "name,nameWithOwner"], check=False)
    if view.returncode != 0:
        die((view.stderr or f"missing {repo}").strip())
    info = json.loads(view.stdout)
    name = info.get("name") or repo.split("/")[-1]
    found = None
    for project in reg.get("projects", []):
        if project.get("repo") == repo or project.get("name") == name:
            found = project
            break
    if found is None:
        found = {"name": name, "repo": repo, "status": "active", "roots": []}
        reg["projects"].append(found)
    found["workshop"] = True
    found["status"] = "active"
    save_registry(reg)
    dest = _clone_to_workspace(repo, name)
    ensure_seed_labels(repo)
    return {"ok": True, "project": found, "cwd": str(dest)}


CORP_CLONE = "https://github.com/andrewkazavchinskyy-cloud/corp"


def project_seed_files(name: str, workspace_path: str | None = None) -> dict[str, str]:
    ws = workspace_path or str(workspace())
    return {
        "README.md": (
            f"# {name}\n\n"
            "Follow the corp harness. Clone it by URL, not a machine path:\n\n"
            f"    gh repo clone andrewkazavchinskyy-cloud/corp\n"
            f"    # {CORP_CLONE}\n\n"
            f"Workspace for checkouts on this machine: `{ws}` "
            "(or `$CORP_WORKSPACE`).\n"
        ),
        "AGENTS.md": (
            f"# {name}\n\n"
            "This is a corp project. Find the harness by clone URL, "
            "not an iCloud or other machine path:\n\n"
            "    gh repo clone andrewkazavchinskyy-cloud/corp\n"
            f"    # {CORP_CLONE}\n\n"
            "Then `cd corp && ./bin/corp bootstrap && ./bin/corp cycle`.\n"
            "Read `AGENTS.md` and `HARNESS.md` in that clone.\n\n"
            f"Workspace for product checkouts: `{ws}` (or `$CORP_WORKSPACE`).\n\n"
            "Take a `ready` GitHub Issue before inventing work.\n"
            "Never delete repos or rewrite Git history.\n"
        ),
        "docs/SPEC.md": (
            f"# {name}\n\n"
            "## Goal\n\n"
            "The smallest useful product this repo should become. Replace this stub.\n\n"
            "## Non-goals\n\n"
            "- Not a company, billing surface, or multi-tenant app.\n"
            "- Not a fake backlog. File Issues only for concrete gaps in this spec.\n\n"
            "## First slice\n\n"
            "After clone, pin the project in Workshop, replace this SPEC stub, and\n"
            "write workshop drafts. Do not file ready Issues as the first action.\n"
        ),
        "memory/sessions/.gitkeep": "",
    }


def write_project_seed(dest: Path, name: str, workspace_path: str | None = None) -> list[str]:
    written = []
    for rel, text in project_seed_files(name, workspace_path).items():
        path = dest / rel
        if path.exists():
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text if text.endswith("\n") or text == "" else text + "\n")
        written.append(rel)
    return written


def create_project(reg: dict, name: str) -> dict:
    org = org_name(reg)
    if not name or "/" in name or name != name.strip():
        die("use a short repo name")
    repo = f"{org}/{name}"
    proc = run(["gh", "repo", "create", repo, "--private", "--description", "corp project"], check=False)
    if proc.returncode != 0 and "already exists" not in (proc.stderr or "").lower():
        die((proc.stderr or proc.stdout or "create failed").strip())
    dest = _clone_to_workspace(repo, name)
    write_project_seed(dest, name)
    run(
        ["git", "add", "README.md", "AGENTS.md", "docs/SPEC.md", "memory/sessions"],
        cwd=dest,
        check=False,
    )
    run(["git", "commit", "-m", "corp: thin seed"], cwd=dest, check=False)
    run(["git", "push", "-u", "origin", "HEAD"], cwd=dest, check=False)
    ensure_seed_labels(repo)
    result = add_existing(reg, repo)
    result["next"] = (
        "Next: open Workshop, keep the pin, replace the SPEC stub, "
        "write workshop drafts. Do not file ready Issues as the first action."
    )
    return result


def project_stage(reg: dict, name: str) -> dict:
    project = project_by_name(reg, name)
    dest = project_dir(project)
    cards = [c for c in board_payload(reg)["cards"] if c["project"] == name]
    open_cards = [c for c in cards if (c.get("state") or "OPEN").upper() != "CLOSED"]
    snap = pin_research(project, dest, reg.get("research_files") or [], cards)
    has_spec = snap["spec_present"] or snap["prd_present"]
    p0 = sum(1 for c in open_cards if any(l.get("name") == "P0" for l in c.get("labels") or []))
    ready_n = sum(1 for c in open_cards if c["column"] == "ready")
    doing = sum(1 for c in open_cards if c["column"] == "in-progress")
    qa_n = sum(1 for c in open_cards if c["column"] == "qa")
    if not has_spec:
        stage = "нет спеки"
    elif p0:
        stage = "горит"
    elif qa_n:
        stage = "на QA"
    elif doing:
        stage = "в работе"
    elif ready_n:
        stage = "строим"
    else:
        stage = "спокойно"
    return {
        "name": name,
        "repo": project.get("repo"),
        "stage": stage,
        "open": len(open_cards),
        "ready": ready_n,
        "p0": p0,
        "in_progress": doing,
        "qa": qa_n,
        "docs": snap["docs"],
        "graph_age": snap["graph_age"],
        "cwd": str(dest) if dest else None,
        "spec_present": snap["spec_present"],
        "prd_present": snap["prd_present"],
        "gap": snap["gap"],
        "unshipped": snap["unshipped"],
        "open_non_ready": snap["open_non_ready"],
        "dirty": snap["dirty"],
        "unpushed": snap["unpushed"],
    }


def new_draft(
    repo: str,
    title: str,
    body: str,
    label: str,
    kind: str = "build",
    why: str = "",
    vs_prd: str = "",
    vs_open: str = "",
) -> dict:
    if label not in {"ready", "blocked"}:
        label = "blocked"
    draft = {
        "id": secrets.token_hex(4),
        "repo": repo,
        "title": title.strip(),
        "body": body.strip(),
        "why": (why or "").strip(),
        "vs_prd": (vs_prd or "").strip(),
        "vs_open": (vs_open or "").strip(),
        "label": label,
        "kind": kind if kind in {"build", "design", "qa"} else "build",
        "created": time.time(),
    }
    data = load_workshop()
    data["drafts"].append(draft)
    save_workshop(data)
    invalidate_board()
    return draft


def draft_issue_body(draft: dict) -> str:
    parts = [draft.get("body") or draft.get("title") or ""]
    if draft.get("why"):
        parts.append(f"## Зачем\n{draft['why']}")
    if draft.get("vs_prd"):
        parts.append(f"## В спеке\n{draft['vs_prd']}")
    if draft.get("vs_open"):
        parts.append(f"## Уже на доске\n{draft['vs_open']}")
    return "\n\n".join(parts).strip()


def prune_drafts() -> None:
    data = load_workshop()
    now = time.time()
    data["drafts"] = [d for d in data["drafts"] if now - float(d.get("created") or 0) < 7 * 86400]
    save_workshop(data)


def draft_by_id(draft_id: str) -> dict:
    prune_drafts()
    for item in load_workshop().get("drafts") or []:
        if item.get("id") == draft_id:
            return item
    die(f"draft not found: {draft_id}")


def drop_draft(draft_id: str) -> None:
    data = load_workshop()
    data["drafts"] = [d for d in data["drafts"] if d.get("id") != draft_id]
    save_workshop(data)


def approve_draft(draft_id: str) -> dict:
    draft = draft_by_id(draft_id)
    if not pin_owns_repo(draft.get("repo") or ""):
        die(f"{draft.get('repo') or 'draft'} is not pinned")
    labels = [draft.get("label") or "blocked"]
    if draft.get("kind") in {"design", "qa"}:
        labels.append(draft["kind"])
    for name in labels:
        ensure_label(draft["repo"], name)
    args = [
        "gh", "issue", "create", "-R", draft["repo"],
        "--title", draft["title"],
        "--body", draft_issue_body(draft),
        "--label", ",".join(labels),
    ]
    proc = run(args, check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or "create issue failed").strip())
    drop_draft(draft_id)
    url = (proc.stdout or "").strip()
    invalidate_board()
    queued = False
    number = None
    if "/issues/" in url:
        try:
            number = int(url.rstrip("/").split("/")[-1])
        except ValueError:
            number = None
    data = load_workshop()
    if number and data.get("auto_queue_on_approve", True):
        try:
            profile = ((data.get("profiles") or DEFAULT_PROFILES)[0] or {}).get("id") or "claude"
            queue_add(load_registry(), draft["repo"], number, profile)
            queued = True
        except CorpError as exc:
            tg_notify_event("filed", tg_short_ref(draft["repo"], number), "есть, не в очереди", tg_clip(str(exc), 40), url=url)
    tg_notify_event(
        "filed",
        tg_short_ref(draft["repo"], number) if number else tg_short_ref(draft["repo"]),
        "завёл",
        "в очередь" if queued else "",
        url=url,
    )
    return {"ok": True, "url": url, "draft": draft, "queued": queued, "issue": number}


def approve_drafts(ids: list[str]) -> dict:
    approved = []
    errors = []
    for did in ids:
        if not did:
            continue
        try:
            approved.append(approve_draft(did))
        except CorpError as exc:
            errors.append({"id": did, "error": str(exc)})
    return {"ok": not errors, "approved": approved, "errors": errors}


def skip_draft(draft_id: str) -> dict:
    draft = draft_by_id(draft_id)
    drop_draft(draft_id)
    return {"ok": True, "skipped": draft_id, "title": draft.get("title")}


def orch_session(project: str) -> str:
    return f"corp-orch-{project}"


def orch_spec_rels(dest: Path | None, research_files: list[str] | None = None) -> list[str]:
    if dest is None or not dest.is_dir():
        return []
    names = list(research_files or [])
    for rel in (
        "docs/PRD.md",
        "docs/SPEC.md",
        "docs/SHIP.md",
        "docs/DESIGN.md",
        "docs/roadmap.md",
        "PRD.md",
        "SPEC.md",
    ):
        if rel not in names:
            names.append(rel)
    return [rel for rel in names if (dest / rel).is_file()]


def orch_open_lines(cards: list, project: str) -> str:
    rows = []
    for card in cards:
        if card.get("project") != project:
            continue
        if (card.get("state") or "OPEN").upper() == "CLOSED":
            continue
        rows.append(f"#{card.get('number')} [{card.get('column')}] {card.get('title') or ''}")
    return "\n".join(rows[:40]) or "(none)"


def orch_workshop_extra(project: str) -> str:
    if project != "corp":
        return ""
    return (
        " This repo is the live workshop. Also propose drafts that expand its "
        "function and push UI/UX/design of workshop/static as far as phone and "
        "desktop will go. Read workshop/preview.html as a reference, not a dump. "
        "Keep Passkey, Tailscale, the pin list, and GitHub as planner. "
        "Use kind=design for visual/UX cards and kind=build for behavior. "
    )


def orch_gap_payload(unshipped: list[str], open_lines: str) -> list[dict]:
    rows = []
    for bullet in unshipped or []:
        title = re.sub(r"\s+", " ", bullet or "").strip()[:72]
        if not title:
            continue
        rows.append(
            {
                "title": title,
                "body": f"Сделать пункт спеки: {bullet}",
                "why": "Пункт спеки не найден ни в коде/доках, ни в закрытых карточках.",
                "vs_prd": bullet,
                "vs_open": "нет открытой карточки на этот пункт" if open_lines in {"", "(none)"} else f"не покрыто открытыми: {open_lines[:200]}",
                "label": "ready",
                "kind": "build",
            }
        )
    return rows[:12]


def orch_prompt(dest: Path, out: Path, spec_rels: list[str], open_lines: str, project: str = "", gaps: list[str] | None = None) -> str:
    spec = ", ".join(spec_rels) or "NONE"
    prd = next((rel for rel in spec_rels if rel.endswith("PRD.md") or rel.endswith("SPEC.md")), "")
    source = prd or spec
    gap_lines = "\n".join(f"- {item}" for item in (gaps or [])[:12]) or "(none)"
    return (
        f"Read-only review of {dest}. Follow {ROOT}/docs/WORKSHOP.md. "
        f"You are the project orchestrator. Compare three things:\n"
        f"1) The product spec in the repo (prefer PRD, else SPEC): {source}. "
        f"Also read: {spec}.\n"
        f"2) What is already shipped: code, README, graphify-out/GRAPH_REPORT.md, closed work.\n"
        f"3) Open GitHub issues already on the board (do not duplicate these):\n{open_lines}\n"
        f"4) Spec gaps already computed from the repo (code/docs and closed cards already checked). Each must become a draft ONLY if it is genuinely unshipped; if you find shipped proof, skip it:\n{gap_lines}\n"
        f"Propose NEW workshop drafts for those gaps and any other PRD/SPEC work that is not shipped and not already an open issue. "
        f"An empty JSON array is only allowed when the gap list is (none). "
        f"Do not file GitHub ready Issues. Do not auto-Approve. "
        f"Each draft is a concrete follow-up against that spec. "
        f"{orch_workshop_extra(project)}"
        f"If there is no PRD/SPEC, output one draft titled 'написать SPEC'. "
        f"No new product ideas. No code. No git writes. "
        f"Do not run git commit, git push, or edit files in {dest}. "
        f"Draft titles and bodies in Russian. Each item needs details for human Approve: "
        f"body (full issue text), why, vs_prd (what in the spec this covers), "
        f"vs_open (why it is not a duplicate of an open card). "
        f"Print a JSON array to stdout. You may also write it to {out} "
        f"(outside the repo) as "
        f'[{{"title":"...","body":"...","why":"...","vs_prd":"...","vs_open":"...","label":"ready|blocked","kind":"build|design|qa"}}].'
    )


def orchestrate(reg: dict, repo: str) -> dict:
    if not pin_owns_repo(repo, reg):
        die(f"{repo} is not pinned")
    project = project_by_repo(reg, repo)
    dest = project_dir(project)
    if dest is None:
        die(f"project not cloned: {project['name']}")
    slot = slots_for(project["name"])["orchestrator"]
    kind = slot.get("kind") or "claude"
    if not kind_cli_ok(kind):
        die(f"{kind} CLI is not installed")
    session = orch_session(project["name"])
    prefix = f"orch {project['name']}"
    if have("tmux") and tmux_has(session):
        die(f"already running: tmux {session}")
    set_orch_state(project["name"], "running", kind=kind, started=time.time())
    drafts = []
    try:
        cards = board_payload(reg)["cards"]
        if "self" in {
            runner_of(card)
            for card in cards
            if card["project"] == project["name"] and card["column"] == "in-progress"
        }:
            die(f"{project['name']} is claimed as self")
        out = config_dir() / f"orch-{project['name']}.json"
        snap = pin_research(project, dest, reg.get("research_files") or [], cards)
        open_lines = orch_open_lines(cards, project["name"])
        gaps = list(snap.get("unshipped") or [])
        prompt = orch_prompt(
            dest,
            out,
            orch_spec_rels(dest, reg.get("research_files") or []),
            open_lines,
            project["name"],
            gaps=gaps,
        )
        cmd = agent_argv(
            kind,
            prompt,
            dest,
            model=slot.get("model") or "",
            effort=slot.get("effort") or "",
            fast=bool(slot.get("fast")),
            readonly=True,
            last_message=out,
        )
        capture = config_dir() / f"orch-{project['name']}.out"
        if have("tmux"):
            script = (
                f"cd {shlex.quote(str(dest))} && set +e; "
                f"{shlex.join(cmd)} >{shlex.quote(str(capture))} 2>&1; rc=$?; "
                f"awk -v p={shlex.quote(prefix + ' ')} '{{print p $0}}' {shlex.quote(str(capture))} "
                f"| tee -a {shlex.quote(str(RUN_LOG))}; "
                f"echo {shlex.quote(prefix)} EXIT:$rc | tee -a {shlex.quote(str(RUN_LOG))}"
            )
            subprocess.run(["tmux", "new-session", "-d", "-s", session, "bash", "-lc", script], check=False)
            while tmux_has(session):
                time.sleep(3)
        else:
            proc = subprocess.run(cmd, cwd=dest, check=False, capture_output=True, text=True)
            capture.write_text((proc.stdout or "") + (proc.stderr or ""))
            for line in capture.read_text().splitlines():
                append_log(f"{prefix} {line}\n")
            append_log(f"{prefix} EXIT:{proc.returncode}\n")
        payload = []
        if out.is_file():
            payload = parse_json_array(out.read_text())
        if not payload and capture.is_file():
            payload = parse_json_array(capture.read_text())
        if not payload and RUN_LOG.is_file():
            payload = parse_json_array(strip_log_prefix(RUN_LOG.read_text()[-20000:], prefix))
        if not payload:
            if not snap.get("spec_present") and not snap.get("prd_present"):
                payload = [
                    {
                        "title": "написать SPEC",
                        "body": "В репо нет SPEC/PRD. Написать минимальную спеку.",
                        "label": "ready",
                        "kind": "build",
                    }
                ]
            else:
                payload = orch_gap_payload(gaps, open_lines)
        have = {
            (item.get("title") or "").strip().lower()
            for item in load_workshop().get("drafts") or []
            if item.get("repo") == repo
        }
        for item in payload[:12]:
            if not isinstance(item, dict) or not item.get("title"):
                continue
            title = (item.get("title") or "").strip()
            if title.lower() in have:
                continue
            have.add(title.lower())
            drafts.append(
                new_draft(
                    repo,
                    title,
                    item.get("body") or "",
                    item.get("label") or "blocked",
                    item.get("kind") or "build",
                    why=item.get("why") or "",
                    vs_prd=item.get("vs_prd") or "",
                    vs_open=item.get("vs_open") or "",
                )
            )
        log = last_log_lines(20, prefix=prefix)
        blob = capture.read_text()[-8000:] if capture.is_file() else ""
        exits = [line for line in log.splitlines() if "EXIT:" in line]
        crashed = (
            "unexpected argument" in log
            or "unexpected argument" in blob
            or bool(exits and not exits[-1].rstrip().endswith("EXIT:0"))
        )
        if crashed and not drafts:
            set_orch_state(
                project["name"],
                "failed",
                drafts=0,
                kind=kind,
                error=tg_clip(log.replace("\n", " "), 160),
            )
        else:
            set_orch_state(project["name"], "done", drafts=len(drafts), kind=kind, error="")
    except Exception as exc:
        set_orch_state(project["name"], "failed", drafts=len(drafts), kind=kind, error=tg_clip(str(exc), 160))
        raise
    tg_notify_event(
        "drafts",
        project["name"],
        tg_ru_count(len(drafts), "черновик", "черновика", "черновиков"),
        "Черновики" if drafts else "",
        buttons=tg_draft_buttons(drafts) or None,
    )
    return {"ok": True, "drafts": drafts, "stage": project_stage(reg, project["name"])}


def maybe_orchestrate(reg: dict, name: str) -> None:
    cards = [c for c in board_payload(reg)["cards"] if c["project"] == name and (c.get("state") or "OPEN").upper() != "CLOSED"]
    if any(c["column"] in {"ready", "in-progress"} for c in cards):
        return
    project = project_by_name(reg, name)
    if project.get("repo"):
        try:
            orchestrate(reg, project["repo"])
        except CorpError as exc:
            append_log(f"orchestrate skip {name}: {exc}\n")


def set_tg_offset(offset: int) -> None:
    with workshop_lock():
        data = load_workshop()
        data["tg_offset"] = int(offset)
        save_workshop(data)


def strip_log_prefix(text: str, prefix: str) -> str:
    lead = (prefix or "").rstrip() + " "
    if lead == " ":
        return text or ""
    return "\n".join(
        line[len(lead) :] if line.startswith(lead) else line
        for line in (text or "").splitlines()
    )


def parse_json_array(text: str) -> list:
    raw = (text or "").strip()
    if not raw:
        return []
    try:
        payload = json.loads(raw)
        return payload if isinstance(payload, list) else []
    except json.JSONDecodeError:
        pass
    start = raw.rfind("[")
    end = raw.rfind("]")
    if start < 0 or end <= start:
        return []
    try:
        payload = json.loads(raw[start : end + 1])
    except json.JSONDecodeError:
        return []
    return payload if isinstance(payload, list) else []


def tg_reset_dedup() -> None:
    _tg_sent.clear()
    _tg_pulse.clear()


def tg_clip(text: str, n: int = 48) -> str:
    clean = " ".join(redact_secrets(text or "").split())
    return clean if len(clean) <= n else clean[: n - 1] + "…"


def tg_ru_count(n: int, one: str, few: str, many: str) -> str:
    n = abs(int(n))
    if n % 10 == 1 and n % 100 != 11:
        word = one
    elif n % 10 in {2, 3, 4} and n % 100 not in {12, 13, 14}:
        word = few
    else:
        word = many
    return f"{n} {word}"


def tg_short_ref(repo: str, number: int | str | None = None) -> str:
    name = (repo or "").rsplit("/", 1)[-1] or repo or "?"
    if number in (None, ""):
        return name
    return f"{name}#{number}"


def tg_card(ref: str, happened: str, nxt: str = "") -> str:
    return " · ".join(part for part in (ref, happened, nxt) if part)


def tg_should_send(key: str, now: float | None = None, ttl: int = TG_DEDUP_TTL) -> bool:
    stamp = time.time() if now is None else now
    keep = [(k, t) for k, t in _tg_sent if stamp - t < ttl]
    _tg_sent[:] = keep
    if any(k == key for k, _t in _tg_sent):
        return False
    _tg_sent.append((key, stamp))
    return True


def record_event(kind: str, ref: str = "", text: str = "", path: Path | None = None, now: float | None = None) -> None:
    kind = (kind or "").strip()[:40]
    if not kind:
        return
    blob = f"{ref} {text}".lower()
    if any(word in blob for word in ("token", "cookie", "secret", "passkey", "authorization")):
        text = "[redacted]"
        ref = (ref or "")[:80]
    row = {
        "t": time.time() if now is None else now,
        "kind": kind,
        "ref": str(ref or "")[:80],
        "text": str(text or "")[:200],
    }
    dest = path or EVENTS_PATH
    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        lines = dest.read_text().splitlines() if dest.is_file() else []
        lines.append(json.dumps(row, ensure_ascii=False))
        dest.write_text("\n".join(lines[-EVENTS_KEEP:]) + "\n")
        os.chmod(dest, 0o600)
    except OSError:
        pass


def load_events(limit: int = 40, path: Path | None = None) -> list[dict]:
    dest = path or EVENTS_PATH
    if not dest.is_file():
        return []
    out = []
    for line in dest.read_text().splitlines()[-max(1, int(limit)):]:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict) and row.get("kind"):
            row["text"] = redact_secrets(str(row.get("text") or ""))
            row["ref"] = redact_secrets(str(row.get("ref") or ""))
            out.append(row)
    out.reverse()
    return out


def text_matches(query: str, *parts: object) -> bool:
    q = (query or "").strip().lower()
    if not q:
        return True
    hay = " ".join(str(part or "") for part in parts).lower()
    return q in hay


def session_notes(reg: dict, project_name: str, limit: int = 7) -> list[dict]:
    name = (project_name or "").strip()
    if not name or name == "all":
        return []
    try:
        project = project_by_name(reg, name)
    except CorpError:
        return []
    dest = project_dir(project)
    if dest is None and name == "corp":
        dest = ROOT
    if dest is None:
        return []
    folder = dest / "memory" / "sessions"
    if not folder.is_dir():
        return []
    files = sorted(folder.glob("*.md"), key=lambda path: path.stat().st_mtime, reverse=True)[: max(0, int(limit))]
    notes = []
    for path in files:
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        if len(text) > 8000:
            text = text[:8000] + "\n…"
        notes.append({"name": path.name, "text": redact_secrets(text), "mtime": path.stat().st_mtime})
    return notes


def is_sandbox_card(issue: dict) -> bool:
    names = label_names(issue)
    title = (issue.get("title") or "").lower()
    return "sandbox" in names or "sandbox" in title or "песочница" in title


def tg_status_process_key(data: dict | None = None) -> str:
    data = data or load_workshop()
    running = [item for item in (data.get("queue") or []) if item.get("status") == "running"]
    if running:
        refs = sorted(issue_ref(item.get("repo") or "", item.get("issue")) for item in running[:3])
        return ",".join(refs)
    return "idle"


def tg_save_status(process_key: str, message_id: int) -> None:
    with workshop_lock():
        data = load_workshop()
        data["tg_status"] = {"process_key": process_key, "message_id": int(message_id)}
        save_workshop(data)


def tg_status_body(data: dict | None = None) -> str:
    data = data or load_workshop()
    return tg_pulse_card(
        queue_on=bool(data.get("queue_running")),
        writer=tg_writer_line(load_registry(), data),
        council=tg_council_line(data),
        last_error=tg_last_queue_error(data),
        drafts=len(data.get("drafts") or []),
        server_ok=tg_server_ok(),
        tg_fails=tg_health()["fails_1h"],
        iso_mode="transitional",
    )


def tg_edit_message(message_id: int, text: str, buttons: list | None = None, parse_mode: str = "") -> bool:
    _, chat = tg_creds()
    if not chat:
        return False
    payload = {
        "chat_id": chat,
        "message_id": int(message_id),
        "text": redact_secrets(text),
        "disable_web_page_preview": "true",
    }
    if parse_mode:
        payload["parse_mode"] = parse_mode
    if buttons:
        payload["reply_markup"] = json.dumps({"inline_keyboard": buttons})
    try:
        result = tg_post("editMessageText", payload)
    except (SystemExit, CorpError):
        return False
    if result.get("ok"):
        return True
    return "not modified" in (result.get("description") or "").lower()


def tg_edit_status(message_id: int, text: str, buttons: list | None = None) -> bool:
    return tg_edit_message(message_id, text, buttons)


def tg_upsert_status(process_key: str = "", *, keep_card: bool = False) -> None:
    data = load_workshop()
    key = process_key or tg_status_process_key(data)
    text = tg_status_body(data)
    buttons = tg_now_buttons(data)
    state = data.get("tg_status") or {}
    mid = state.get("message_id")
    same = str(state.get("process_key") or "") == str(key)
    if mid and (same or keep_card):
        if tg_edit_message(int(mid), text, buttons, parse_mode="HTML"):
            if not same:
                tg_save_status(key, int(mid))
            return
    result = tg_send(text, buttons=buttons)
    new_id = ((result or {}).get("result") or {}).get("message_id")
    if new_id:
        tg_save_status(key, int(new_id))


def tg_need_human_text(ref: str = "", why: str = "") -> str:
    lines = []
    if ref:
        lines.append(ref)
    if why and why != ref:
        lines.append(tg_clip(why, 80))
    return tg_screen("Нужно тебя", lines or ["Что-то остановилось."], "выбери действие.")


def tg_need_human_buttons(ref: str = "", url: str = "") -> list:
    row = [{"text": "Пауза", "callback_data": "c:pause"}]
    action = ""
    raw = (ref or "").strip()
    if raw and "#" in raw:
        try:
            repo, number = parse_issue_ref(raw) if "/" in raw else tg_parse_issue_arg(raw)
            action = issue_ref(repo, number)
        except CorpError:
            action = ""
    if action:
        row.append({"text": "Повторить", "callback_data": f"q:{action}"})
    row.append({"text": "Доска", "callback_data": "h:b"})
    shop = url if url and ".ts.net" in url else ""
    if not shop and action:
        try:
            repo, number = parse_issue_ref(action)
            shop = tg_workshop_issue_url(repo, number, action)
        except CorpError:
            shop = ""
    if shop and ".ts.net" in shop:
        row.append({"text": "Мастерская", "url": shop})
    rows = [row[:4]]
    gh = tg_github_issue_url(raw, url)
    if gh:
        rows.append([{"text": "GitHub", "url": gh}])
    return rows


def tg_notify_event(
    kind: str,
    ref: str,
    happened: str,
    nxt: str = "",
    url: str = "",
    buttons: list | None = None,
    action_ref: str = "",
    extra_key: str = "",
) -> None:
    record_event(kind, ref, happened)
    key = ":".join(part for part in (kind, ref, happened, extra_key) if part)
    if not tg_should_send(key):
        return
    process = action_ref or (ref if "#" in str(ref) else "")
    if kind in TG_STATUS_KINDS:
        tg_upsert_status(process)
        return
    if kind in TG_PUNCH_KINDS:
        markup = buttons if buttons is not None else (
            tg_need_human_buttons(action_ref or ref, url) if kind == "need_human" else tg_event_buttons(kind, url=url, ref=action_ref or ref)
        )
        if kind == "need_human":
            text = tg_need_human_text(ref, happened)
        else:
            title = "Упало" if kind == "fail" else "Завис"
            text = tg_screen(title, [str(ref), happened], nxt or "пауза или повтори.")
        tg_send(text, buttons=markup or None)
        tg_upsert_status(process)
        return
    markup = buttons if buttons is not None else tg_event_buttons(kind, url=url, ref=action_ref or ref)
    notify_safe(tg_card(ref, happened, nxt), buttons=markup or None)


def tg_shop_url() -> str:
    base = workshop_public_url()
    if base and ".ts.net" in base:
        return base
    return ""


def workshop_public_url() -> str:
    env = (os.environ.get("CORP_WORKSHOP_URL") or "").strip().rstrip("/")
    if env:
        return env
    if not have("tailscale"):
        return ""
    proc = run(["tailscale", "status", "--json"], check=False, timeout=8)
    try:
        data = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        data = {}
    dns = (((data.get("Self") or {}).get("DNSName") or "") if isinstance(data, dict) else "").strip().rstrip(".")
    if dns:
        return f"https://{dns}"
    return ""


def tg_workshop_issue_url(repo: str = "", number: int | None = None, ref: str = "") -> str:
    base = workshop_public_url()
    if not base:
        return ""
    issue = ref or (f"{repo}#{number}" if repo and number else "")
    if not issue:
        return base
    return f"{base}/?issue={issue}"


def tg_github_issue_url(ref: str = "", url: str = "") -> str:
    raw = (url or "").strip()
    if raw.startswith("https://github.com/") and "/issues/" in raw:
        return raw
    if ref and "#" in str(ref):
        try:
            repo, number = parse_issue_ref(ref)
            return f"https://github.com/{repo}/issues/{number}"
        except CorpError:
            return ""
    return ""


def tg_event_buttons(kind: str, url: str = "", ref: str = "") -> list:
    row = []
    shop = url if url and ".ts.net" in url else ""
    if ref and "#" in str(ref):
        try:
            repo, number = parse_issue_ref(ref)
            shop = shop or tg_workshop_issue_url(repo, number, ref)
        except CorpError:
            shop = shop or tg_workshop_issue_url(ref=ref)
    if shop and ".ts.net" in shop:
        row.append({"text": "Мастерская", "url": shop})
    retry_kinds = {"fail", "incomplete", "hung", "waiting_error"}
    if kind in retry_kinds and ref:
        row.append({"text": "Повторить", "callback_data": f"q:{ref}"})
    if kind in {"start", "hung"}:
        row.append({"text": "Пауза", "callback_data": "c:pause"})
    if kind in {"to_qa", "ready_qa"} and ref:
        row.append({"text": "QA прошёл", "callback_data": f"qap:{ref}"})
        row.append({"text": "QA не принял", "callback_data": f"qaf:{ref}"})
    out = [row] if row else []
    if kind in {"fail", "hung"}:
        gh = tg_github_issue_url(ref, url)
        if gh:
            out.append([{"text": "GitHub", "url": gh}])
    return out


def tg_draft_buttons(drafts: list) -> list:
    if not drafts:
        return []
    did = drafts[0].get("id") or ""
    return [[{"text": "Принять", "callback_data": f"a:{did}"}, {"text": "Пропустить", "callback_data": f"s:{did}"}]]


def tg_col_ru(column: str) -> str:
    return {
        "backlog": "Бэклог",
        "ready": "Готово",
        "in-progress": "Ход",
        "qa": "QA",
        "done": "Закрыто",
    }.get(column or "", column or "")


def tg_iso_line(mode: str = "") -> str:
    if (mode or "") == "isolated":
        return "Агенты отдельно — так и должно быть"
    return "Изоляция ещё настраивается. Мастерская работает."


def tg_pulse_card(
    *,
    queue_on: bool,
    writer: str,
    council: str = "",
    last_error: str = "",
    next_action: str = "",
    iso_mode: str = "transitional",
    drafts: int = 0,
    server_ok: bool = True,
    tg_fails: int = -1,
) -> str:
    err = tg_clip(redact_secrets(last_error), 80) if last_error else ""
    nxt = (next_action or "").strip()
    if not nxt:
        if err:
            nxt = "повтори упавшую карточку или открой доску"
        elif council and council != "не идёт":
            nxt = "жди цикл или открой прогресс"
        elif queue_on:
            nxt = "жди карточку или открой доску"
        else:
            nxt = "открой доску или продолжи автоном"
    lines = [
        f"Очередь: {'идёт' if queue_on else 'пауза'}",
        f"Пишет: {writer or 'тихо'}",
        f"Цикл: {council or 'не идёт'}",
    ]
    if err:
        lines.append(f"Ошибка: {err}")
    if not server_ok:
        lines.append("Диск: нет места")
    if int(tg_fails) > 0:
        lines.append(f"Бот: сбои доставки ×{int(tg_fails)} за час")
    if int(drafts) > 0:
        lines.append(f"Черновики: {int(drafts)}")
    return tg_screen("Сейчас", lines, nxt)


def tg_status_text(*, queue_on: bool, writer: str, server_ok: bool, drafts: int) -> str:
    return tg_pulse_card(
        queue_on=queue_on,
        writer=writer,
        server_ok=server_ok,
        drafts=drafts,
        iso_mode="transitional",
    )


def tg_queue_text(queue: list, *, paused: bool) -> str:
    running = [item for item in queue if item.get("status") == "running"]
    waiting = [item for item in queue if item.get("status") == "waiting"]
    failed = [item for item in queue if item.get("status") == "failed"]
    if not running and not waiting and not failed:
        return "Очередь пуста"
    lines = [f"Очередь · {'пауза' if paused else 'вкл'}"]
    if running:
        lines.append("Бежит")
        for item in running[:3]:
            ref = tg_short_ref(item.get("repo") or "", item.get("issue"))
            title = tg_clip(item.get("title") or "", 40)
            lines.append(f"{ref} {title}".strip() if title else ref)
    nxt = waiting[:TG_QUEUE_NEXT]
    if nxt:
        lines.append("Дальше")
        for item in nxt:
            lines.append(tg_short_ref(item.get("repo") or "", item.get("issue")))
    if failed:
        lines.append(f"Упали: {len(failed)}")
    return "\n".join(lines)


def tg_agents_text(rows: list) -> str:
    if not rows:
        return "Агенты\nтихо"
    lines = ["Агенты"]
    for row in rows:
        parts = [row.get("name") or "?", row.get("kind") or ""]
        issue = row.get("issue") or ""
        if issue:
            parts.append(issue if str(issue).startswith("#") else f"#{issue}")
        lines.append(" · ".join(part for part in parts if part))
    return "\n".join(lines)


def tg_server_text(*, load: float, disk_free_gb: float, workshop_up: bool, queue_on: bool) -> str:
    return "\n".join(
        [
            f"нагрузка {load:.2f}",
            f"диск {disk_free_gb:.0f} ГБ",
            f"workshop: {'ок' if workshop_up else 'нет'}",
            f"очередь: {'вкл' if queue_on else 'пауза'}",
        ]
    )


def tg_card_labels(card: dict) -> set[str]:
    out = set()
    for item in card.get("labels") or []:
        if isinstance(item, dict):
            out.add(item.get("name") or "")
        elif item:
            out.add(str(item))
    return out


def tg_html(text: str) -> str:
    import html

    return html.escape(text or "", quote=False)


def tg_screen(title: str, lines: list[str] | None = None, nxt: str = "") -> str:
    parts = [f"<b>{tg_html(title)}</b>"]
    body = [tg_html(str(line)) for line in (lines or []) if str(line).strip()]
    if body:
        parts.append("")
        parts.extend(body[:9])
    if nxt:
        parts.append("")
        parts.append(f"Дальше: {tg_html(nxt)}")
    return "\n".join(parts)


def tg_err(exc: Exception) -> str:
    raw = tg_clip(redact_secrets(str(exc) or ""), 80)
    low = raw.lower()
    if "use --issue" in low or "parse failed" in low:
        return tg_screen("Ошибка", ["Не понял карточку."], "открой доску.")
    return tg_screen("Ошибка", [raw], "открой доску или Ещё.")


def tg_save_slot(slot: str, message_id: int) -> None:
    with workshop_lock():
        data = load_workshop()
        row = dict(data.get(slot) or {})
        row["message_id"] = int(message_id)
        data[slot] = row
        save_workshop(data)


def tg_upsert_html(slot: str, text: str, buttons: list | None = None) -> None:
    mid = (load_workshop().get(slot) or {}).get("message_id")
    if mid and tg_edit_message(int(mid), text, buttons, parse_mode="HTML"):
        return
    result = tg_send(text, buttons=buttons or None)
    new_id = ((result or {}).get("result") or {}).get("message_id")
    if new_id:
        tg_save_slot(slot, int(new_id))


def tg_card_project(card: dict) -> str:
    return (card.get("project") or (card.get("repo") or "").rsplit("/", 1)[-1] or "").strip()


def tg_board_open(cards: list) -> list:
    out = []
    for card in cards or []:
        col = card.get("column") or "backlog"
        closed = (card.get("state") or "OPEN").upper() == "CLOSED" or col == "done"
        if closed:
            continue
        out.append(card)
    return out


def tg_board_filter(cards: list, project: str = "") -> list:
    opened = tg_board_open(cards)
    key = (project or "").strip().lower()
    if not key:
        return opened
    return [card for card in opened if tg_card_project(card).lower() == key]


def tg_board_rank(cards: list) -> list:
    def rank(card: dict) -> tuple:
        col = card.get("column") or "backlog"
        p0 = 0 if "P0" in tg_card_labels(card) else 1
        order = {"qa": 0, "in-progress": 1, "ready": 2, "backlog": 3}.get(col, 9)
        return (order, p0)

    return sorted(cards, key=rank)


def tg_board_pick(cards: list, cap: int = TG_BOARD_MAX) -> list:
    return tg_board_rank(tg_board_open(cards))[: max(0, int(cap))]


def tg_board_page_bounds(n: int, page: int, size: int = TG_BOARD_PAGE) -> tuple[int, int]:
    n = max(0, int(n))
    size = max(1, int(size))
    pages = max(1, (n + size - 1) // size) if n else 1
    try:
        page = int(page or 1)
    except (TypeError, ValueError):
        page = 1
    return min(max(1, page), pages), pages


def tg_board_slice(cards: list, page: int = 1, size: int = TG_BOARD_PAGE) -> tuple[list, int, int]:
    page, pages = tg_board_page_bounds(len(cards or []), page, size)
    start = (page - 1) * size
    return list(cards or [])[start : start + size], page, pages


def tg_board_find(cards: list, ref: str) -> dict | None:
    want = (ref or "").strip().lower()
    if not want:
        return None
    for card in cards or []:
        number = card.get("number")
        if number in (None, ""):
            continue
        repo = card.get("repo") or ""
        short = tg_short_ref(repo or card.get("project") or "", number).lower()
        full = f"{repo}#{number}".lower()
        if want in {short, full, f"#{number}"}:
            return card
    return None


def tg_board_counts(cards: list) -> dict[str, int]:
    counts = {"backlog": 0, "ready": 0, "in-progress": 0, "qa": 0, "done": 0}
    for card in cards or []:
        col = card.get("column") or "backlog"
        if col in counts:
            counts[col] += 1
    return counts


def tg_board_pin_names(pins: list | None, cards: list | None = None) -> list[str]:
    names: list[str] = []
    src = pins
    if src is None:
        seen: set[str] = set()
        src = []
        for card in cards or []:
            name = tg_card_project(card)
            if name and name not in seen:
                seen.add(name)
                src.append({"name": name})
    for item in src:
        name = (item.get("name") if isinstance(item, dict) else str(item or "")).strip()
        if name and name not in names:
            names.append(name)
    return names


def _tg_rows(items: list, n: int) -> list:
    return [items[i : i + n] for i in range(0, len(items), n)] if items else []


def tg_board_text(cards: list, project: str = "", page: int = 1, open_ref: str = "") -> str:
    ranked = tg_board_rank(tg_board_filter(cards, project))
    opened = tg_board_find(cards, open_ref) if open_ref else None
    if opened:
        ref = tg_short_ref(opened.get("repo") or opened.get("project") or "", opened.get("number"))
        col = tg_col_ru(opened.get("column") or "backlog")
        title = tg_clip(opened.get("title") or "", 80)
        nxt = "QA прошёл или QA не принял." if (opened.get("column") or "") == "qa" else "возьми себе или поставь в очередь."
        body = [col]
        if title:
            body.append(title)
        return tg_screen(f"Доска · {ref}", body, nxt)
    counts = tg_board_counts(ranked)
    label = (project or "").strip()
    head = f"Доска · {label}" if label else "Доска"
    lines = [f"Готово {counts['ready']} · Ход {counts['in-progress']} · QA {counts['qa']}"]
    page_cards, page, pages = tg_board_slice(ranked, page)
    if not page_cards:
        where = f"в {label} пусто" if label else "на доске пусто"
        return tg_screen(head, lines + [f"{where} — смени фильтр или открой цикл"], "смени фильтр или запусти цикл.")
    for card in page_cards:
        ref = tg_short_ref(card.get("repo") or card.get("project") or "", card.get("number"))
        title = tg_clip(card.get("title") or "", 36)
        col = tg_col_ru(card.get("column") or "backlog")
        lines.append(f"{ref} · {col}" + (f" · {title}" if title else ""))
    if pages > 1:
        lines.append(f"{page}/{pages}")
    return tg_screen(head, lines, "открой карточку или смени проект.")


def tg_board_card_buttons(card: dict, shop: str = "") -> list:
    repo = card.get("repo") or ""
    number = card.get("number")
    if not repo or number in (None, ""):
        return [[{"text": "К доске", "callback_data": "b:b"}]]
    key = issue_ref(repo, int(number))
    col = card.get("column") or "backlog"
    labels = tg_card_labels(card)
    open_url = tg_workshop_issue_url(repo, int(number), key) or shop
    rows = []
    if open_url and ".ts.net" in open_url:
        rows.append([{"text": "Мастерская", "url": open_url}])
    if col == "qa":
        rows.append([
            {"text": "QA прошёл", "callback_data": f"qap:{key}"},
            {"text": "QA не принял", "callback_data": f"qaf:{key}"},
        ])
    else:
        claimed = card.get("runner") == "self" or "self" in labels
        take = {"text": "Снять", "callback_data": f"d:{key}"} if claimed else {"text": "Себе", "callback_data": f"t:{key}"}
        rows.append([take, {"text": "Очередь", "callback_data": f"u:{key}"}])
    rows.append([{"text": "К доске", "callback_data": "b:b"}])
    return rows


def tg_board_buttons(
    cards: list,
    project: str = "",
    page: int = 1,
    pins: list | None = None,
    open_ref: str = "",
    shop: str = "",
) -> list:
    opened = tg_board_find(cards, open_ref) if open_ref else None
    if opened:
        return tg_board_card_buttons(opened, shop=shop)
    ranked = tg_board_rank(tg_board_filter(cards, project))
    page_cards, page, pages = tg_board_slice(ranked, page)
    chips = [{"text": "· Все" if not (project or "").strip() else "Все", "callback_data": "b:f:"}]
    for name in tg_board_pin_names(pins, cards):
        chips.append({"text": f"· {name}" if (project or "").strip() == name else name, "callback_data": f"b:f:{name}"})
    rows = _tg_rows(chips, 3)
    opens = []
    for card in page_cards:
        short = tg_short_ref(card.get("repo") or card.get("project") or "", card.get("number"))
        opens.append({"text": short, "callback_data": f"b:o:{short}"})
    rows.extend(_tg_rows(opens, 2))
    if pages > 1:
        nav = []
        if page > 1:
            nav.append({"text": "←", "callback_data": f"b:p:{page - 1}"})
        nav.append({"text": f"{page}/{pages}", "callback_data": f"b:p:{page}"})
        if page < pages:
            nav.append({"text": "→", "callback_data": f"b:p:{page + 1}"})
        rows.append(nav)
    if shop and ".ts.net" in shop:
        rows.append([{"text": "Мастерская", "url": shop}])
    return rows


def tg_save_board(message_id: int, filt: str, page: int, opened: str) -> None:
    with workshop_lock():
        data = load_workshop()
        data["tg_board"] = {
            "message_id": int(message_id),
            "filter": filt,
            "page": int(page),
            "open": opened,
        }
        save_workshop(data)


def tg_upsert_board(
    *,
    project: str | None = None,
    page: int | None = None,
    open_ref: str | None = None,
    reset_open: bool = False,
) -> None:
    data = load_workshop()
    state = data.get("tg_board") or {}
    if project is not None:
        filt = (project or "").strip()
        pg = 1 if page is None else int(page)
    else:
        filt = str(state.get("filter") or "")
        pg = int(state.get("page") or 1) if page is None else int(page)
    if reset_open:
        opened = ""
    elif open_ref is not None:
        opened = (open_ref or "").strip()
    else:
        opened = str(state.get("open") or "")
    cards = board_payload(load_registry()).get("cards") or []
    pins = pinned_projects(load_registry())
    ranked = tg_board_rank(tg_board_filter(cards, filt))
    _, pg, _ = tg_board_slice(ranked, pg)
    text = tg_board_text(cards, project=filt, page=pg, open_ref=opened)
    buttons = tg_board_buttons(
        cards, project=filt, page=pg, pins=pins, open_ref=opened, shop=tg_shop_url()
    )
    mid = state.get("message_id")
    if mid and tg_edit_message(int(mid), text, buttons, parse_mode="HTML"):
        tg_save_board(int(mid), filt, pg, opened)
        return
    result = notify_safe(text, buttons=buttons or None, parse_mode="HTML")
    new_id = ((result or {}).get("result") or {}).get("message_id")
    if new_id:
        tg_save_board(int(new_id), filt, pg, opened)


def tg_drafts_text(drafts: list) -> str:
    if not drafts:
        return "Черновиков нет"
    lines = [f"Черновики: {len(drafts)}"]
    for draft in drafts[:3]:
        project = draft.get("project") or draft.get("label") or (draft.get("repo") or "").rsplit("/", 1)[-1] or "черновик"
        lines.append(f"{project} · {tg_clip(draft.get('title') or '', 40)}")
    if len(drafts) > 3:
        lines.append(f"ещё {len(drafts) - 3}")
    return "\n".join(lines)


def tg_more_text(data: dict | None = None) -> str:
    data = data or load_workshop()
    drafts = data.get("drafts") or []
    queue = data.get("queue") or []
    queued = [item for item in queue if item.get("status") in {"waiting", "running", "failed"}]
    lines = [
        f"Автоном: {'идёт' if data.get('queue_running') else 'пауза'}",
        f"Черновики: {len(drafts)}",
    ]
    if queued:
        item = queued[0]
        lines.append(f"В очереди: {tg_short_ref(item.get('repo') or '', item.get('issue'))}")
    if council_busy(data):
        lines.append("Цикл сейчас идёт.")
    for draft in drafts[:3]:
        project = draft.get("project") or draft.get("label") or (draft.get("repo") or "").rsplit("/", 1)[-1] or "черновик"
        lines.append(f"· {project} · {tg_clip(draft.get('title') or '', 40)}")
    if len(drafts) > 3:
        lines.append(f"ещё {len(drafts) - 3}")
    nxt = "прими или пропусти черновик." if drafts else "выбери действие."
    return tg_screen("Ещё", lines, nxt)


def tg_more_buttons(data: dict | None = None) -> list:
    data = data or load_workshop()
    drafts = data.get("drafts") or []
    queue = data.get("queue") or []
    queued = [item for item in queue if item.get("status") in {"waiting", "running", "failed"}]
    shop = tg_shop_url()
    rows = []
    if data.get("queue_running"):
        rows.append([{"text": "Пауза", "callback_data": "c:pause"}])
    else:
        rows.append([{"text": "Автоном", "callback_data": "?g"}])
    extra = []
    if queued:
        key = issue_ref(queued[0]["repo"], queued[0]["issue"])
        extra.append({"text": "Откатить", "callback_data": f"?k:{key}"})
    if council_busy(data):
        extra.append({"text": "Стоп цикла", "callback_data": "?c"})
    if extra:
        rows.append(extra)
    if shop:
        rows.append([{"text": "Мастерская", "url": shop}])
    rows.append([{"text": "Помощь", "callback_data": "h:p"}])
    if drafts:
        rows.extend(tg_draft_buttons(drafts))
    return rows


def tg_upsert_more() -> None:
    prune_drafts()
    data = load_workshop()
    tg_upsert_html("tg_more", tg_more_text(data), tg_more_buttons(data))


def tg_cycle_buttons(data: dict | None = None) -> list:
    if council_busy(data or load_workshop()):
        return [[{"text": "Стоп цикла", "callback_data": "?c"}]]
    return []


def tg_show_cycle(text: str, buttons: list | None = None, notify=None) -> None:
    if notify is not None:
        notify(text)
        return
    tg_upsert_html("tg_cycle", text, buttons)


def tg_pulse_text(repo: str, number: int, mins: int, log_line: str, prev_log: str) -> str | None:
    cur = redact_secrets(log_line or "")
    prev = redact_secrets(prev_log or "")
    if not prev or cur == prev:
        return None
    return tg_card(tg_short_ref(repo, number), f"{mins} мин", "пишет")


def tg_workshop_up() -> bool:
    import socket

    port = int(os.environ.get("CORP_WORKSHOP_PORT", "8787"))
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.4):
            return True
    except OSError:
        return False


def tg_server_ok() -> bool:
    try:
        return shutil.disk_usage("/").free >= 1024**3
    except OSError:
        return False


def tg_writer_line(reg: dict, data: dict) -> str:
    running = [item for item in (data.get("queue") or []) if item.get("status") == "running"]
    if running:
        return ", ".join(tg_short_ref(item.get("repo") or "", item.get("issue")) for item in running[:3])
    live = tg_live_names(reg)
    return ", ".join(live[:4]) if live else "тихо"


def tg_agent_rows(reg: dict, queue: list | None = None) -> list[dict]:
    rows = []
    for project in pinned_projects(reg):
        name = project["name"]
        issue = ""
        for item in queue or []:
            if item.get("project") == name and item.get("status") == "running":
                num = item.get("issue")
                issue = f"#{num}" if num not in (None, "") else ""
                break
        if tmux_alive(name):
            rows.append({"name": name, "kind": "tmux", "issue": issue})
        if orch_alive(name):
            rows.append({"name": name, "kind": "orch", "issue": ""})
    return rows


def council_session(role: str) -> str:
    return f"corp-council-{role}"


def council_scope(reg: dict, pin: str = "") -> str:
    name = (pin or "").strip()
    if name.lower() in {"", "all", "все"}:
        return "corp"
    for project in pinned_projects(reg):
        if project.get("name") == name:
            return name
    return "corp"


def council_norm_title(title: str) -> str:
    return re.sub(r"\s+", " ", (title or "").strip().lower())


def council_is_dup(title: str, existing_titles: list[str]) -> bool:
    norm = council_norm_title(title)
    if not norm:
        return True
    for other in existing_titles:
        o = council_norm_title(other)
        if not o:
            continue
        if norm == o or norm in o or o in norm:
            return True
    return False


def council_pick_items(items: list, existing_titles: list[str] | None = None, cap: int = COUNCIL_MAX_PER_ROLE) -> list[dict]:
    out: list[dict] = []
    seen = list(existing_titles or [])
    for item in items or []:
        if not isinstance(item, dict):
            continue
        title = (item.get("title") or "").strip()
        if not title or council_is_dup(title, seen):
            continue
        out.append(item)
        seen.append(title)
        if len(out) >= max(0, int(cap)):
            break
    return out


def council_tmux_map() -> dict[str, bool]:
    return {role: tmux_has(council_session(role)) for role in COUNCIL_ROLES}


def council_busy(data: dict | None = None, tmux_on: dict[str, bool] | None = None) -> bool:
    row = (data or {}).get("council") or {}
    if (row.get("status") or "") in COUNCIL_BUSY:
        return True
    live = tmux_on if tmux_on is not None else council_tmux_map()
    return any(live.get(role) for role in COUNCIL_ROLES)


def council_writer_kind() -> str:
    if kind_cli_ok("grok"):
        return "grok"
    if kind_cli_ok("cursor"):
        return "cursor"
    die("нет Grok CLI (grok/agent)")


def council_existing_titles(reg: dict, repo: str, issues: list | None = None, drafts: list | None = None) -> list[str]:
    titles: list[str] = []
    if issues is None:
        try:
            issues = issues_for(repo, "open", 80)
        except (CorpError, SystemExit):
            issues = []
    for item in issues or []:
        if item.get("title"):
            titles.append(item["title"])
    if drafts is None:
        drafts = (load_workshop().get("drafts") or [])
    for draft in drafts:
        if draft.get("title"):
            titles.append(draft["title"])
    return titles


def tg_help_text() -> str:
    return tg_screen(
        "Помощь",
        [
            "Сейчас — очередь, цикл, ошибка.",
            "Доска — открыть, себе, очередь, QA.",
            "Цикл — команда QA, PM и Дизайн.",
            "Ещё — пауза, автоном, откатить, черновики.",
        ],
        "нажми одно внизу.",
    )


def tg_council_phase_ru(status: str) -> str:
    return {
        "analyze": "смотрит мастерскую",
        "queue": "карточки в очереди",
        "review": "проверка перед main",
        "main": "готово",
        "fail": "не принял",
        "idle": "не идёт",
        "aborted": "остановлен",
    }.get(status or "", status or "не идёт")


def tg_council_text(row: dict) -> str:
    project = row.get("project") or "corp"
    filed = row.get("filed") or []
    status = row.get("status") or ""
    roles = ", ".join(COUNCIL_ROLE_RU[role] for role in COUNCIL_ROLES)
    phase = tg_council_phase_ru(status)
    if status == "analyze":
        return tg_screen(
            "Цикл",
            [f"{roles} · {project}", f"Сейчас: {phase}."],
            "подожди карточки. Стоп — только если нужно.",
        )
    queued = sum(1 for item in filed if item.get("phase") in {"queue", "running"})
    review = sum(1 for item in filed if item.get("phase") == "review")
    done = sum(1 for item in filed if item.get("phase") == "main")
    fail = sum(1 for item in filed if item.get("phase") == "fail")
    lines = [
        f"{roles} · {project}",
        f"Сейчас: {phase}.",
        f"Завели {len(filed)} · в работе {queued} · на проверке {review} · в main {done}.",
    ]
    if fail:
        lines.append(f"Не принял: {fail}.")
    return tg_screen("Цикл", lines, "смотри доску или Сейчас.")


def council_role_brief(role: str) -> str:
    if role == "qa":
        return (
            "You are the QA agent. Walk every Workshop design and the live app thoroughly: "
            "bugs, lying UI, a11y, doctor, queue, Telegram. File only concrete defects."
        )
    if role == "pm":
        return (
            "You are the PM agent. Compare live Workshop + corp to docs/SPEC.md, "
            "docs/HANDOFF.md, docs/WORKSHOP.md. File missing operator jobs and spec gaps. "
            "Do not invent a new product."
        )
    return (
        "You are the Design agent. Improve phone + desktop Workshop UI/UX as far as useful "
        "(workshop/static). Not vibe-only. workshop/preview.html is a reference, not a dump."
    )


def council_analyze_prompt(role: str, dest: Path, repo: str, existing: list[str], out: Path) -> str:
    seen = "\n".join(f"- {title}" for title in existing[:60]) or "(none)"
    label = COUNCIL_ROLE_LABEL[role]
    return (
        f"Follow {ROOT}/AGENTS.md and {ROOT}/HARNESS.md. "
        f"Live workshop tree is /opt/corp. Writers edit /home/corp/projects/corp. "
        f"You are analyzing {dest} for {repo}. {council_role_brief(role)} "
        f"GitHub is the planner. File at most {COUNCIL_MAX_PER_ROLE} Issues via `gh api` REST "
        f"(POST repos/{repo}/issues). GraphQL `gh issue create --json` often 503s — do not use it. "
        f"Labels must include ready,{COUNCIL_LABEL},{label}. Russian titles OK. "
        f"Each body needs acceptance criteria. Dedup against open issues and drafts:\n{seen}\n"
        f"No new product. No Funnel. Do not set CORP_AGENT_USER. Isolation stays transitional. "
        f"Never rewrite git history. Do not edit files in {dest}. No git commit/push. "
        f"Also write a JSON array to {out}: "
        f'[{{"title":"...","body":"...","acceptance":"..."}}]. Cap {COUNCIL_MAX_PER_ROLE}.'
    )


def council_review_prompt(repo: str, number: int, dest: Path, diff: str) -> str:
    return (
        f"Follow {ROOT}/AGENTS.md. Automated QA for council-filed {repo}#{number}. "
        f"Review this diff vs origin/main in {dest}. Live tree is /opt/corp; writers are "
        f"/home/corp/projects/corp. No new product. No Funnel. Do not set CORP_AGENT_USER. "
        f"Never rewrite history. Human QA buttons stay for non-council cards.\n\n"
        f"{diff[:12000]}\n\n"
        f"End with exactly one line: VERDICT: PASS or VERDICT: FAIL plus a short note."
    )


def council_qa_verdict(text: str) -> str:
    blob = text or ""
    for line in reversed(blob.splitlines()):
        low = line.strip().upper()
        if "VERDICT: FAIL" in low or "ВЕРДИКТ: FAIL" in low:
            return "fail"
        if "VERDICT: PASS" in low or "ВЕРДИКТ: PASS" in low:
            return "pass"
    upper = blob.upper()
    if re.search(r"\bFAIL\b", upper) and not re.search(r"\bPASS\b", upper):
        return "fail"
    if re.search(r"\bPASS\b", upper) and not re.search(r"\bFAIL\b", upper):
        return "pass"
    return "fail"


def council_should_auto_qa(names: set[str] | list[str]) -> bool:
    return COUNCIL_LABEL in set(names)


def create_issue_rest(repo: str, title: str, body: str, labels: list[str]) -> dict:
    for name in labels:
        ensure_label(repo, name)
    args = ["gh", "api", "-X", "POST", f"repos/{repo}/issues", "-f", f"title={title}", "-f", f"body={body}"]
    for name in labels:
        args += ["-f", f"labels[]={name}"]
    proc = run(args, check=False)
    if proc.returncode != 0:
        die((proc.stderr or proc.stdout or "create issue failed").strip())
    try:
        payload = json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        die("create issue returned non-json")
    number = payload.get("number")
    if not number:
        die("create issue missing number")
    return {
        "ok": True,
        "repo": repo,
        "number": int(number),
        "url": payload.get("html_url") or payload.get("url") or "",
        "title": title,
    }


def council_issue_body(item: dict) -> str:
    parts = [(item.get("body") or item.get("title") or "").strip()]
    accept = (item.get("acceptance") or "").strip()
    if accept:
        parts.append(f"## Приёмка\n{accept}")
    return "\n\n".join(part for part in parts if part)


def council_save(row: dict) -> dict:
    with workshop_lock():
        data = load_workshop()
        data["council"] = row
        save_workshop(data)
    return row


def council_load() -> dict:
    return dict(load_workshop().get("council") or {})


def council_spawn_role(role: str, dest: Path, repo: str, existing: list[str], kind: str) -> None:
    out = config_dir() / f"council-{role}.json"
    prompt = council_analyze_prompt(role, dest, repo, existing, out)
    cmd = agent_argv(kind, prompt, dest)
    session = council_session(role)
    if tmux_has(session):
        die(f"цикл уже идёт: {session}")
    prefix = f"council {role}"
    pipe = (
        f"{shlex.join(cmd)} 2>&1 | while IFS= read -r line || [ -n \"$line\" ]; do "
        f"printf '%s %s\\n' {shlex.quote(prefix)} \"$line\"; done"
    )
    script = tmux_agent_script(dest, pipe, prefix)
    proc = subprocess.run(["tmux", "new-session", "-d", "-s", session, "bash", "-lc", script])
    if proc.returncode != 0:
        die(f"tmux {session} failed")


def council_run_role_sync(role: str, dest: Path, repo: str, existing: list[str], kind: str) -> None:
    out = config_dir() / f"council-{role}.json"
    prompt = council_analyze_prompt(role, dest, repo, existing, out)
    cmd = wrap_isolated(agent_argv(kind, prompt, dest), dest)
    subprocess.run(cmd, cwd=dest, check=False)


def council_launch_analyzers(reg: dict, row: dict, dest: Path | None = None, kind: str | None = None) -> None:
    dest = dest or project_dir(project_by_name(reg, row["project"])) or writers_corp_path()
    kind = kind or council_writer_kind()
    existing = row.get("seen_titles") or council_existing_titles(reg, row["repo"])
    if have("tmux"):
        for role in COUNCIL_ROLES:
            council_spawn_role(role, dest, row["repo"], existing, kind)
        return
    row["sync"] = True
    council_save(row)

    def _run() -> None:
        try:
            for role in COUNCIL_ROLES:
                council_run_role_sync(role, dest, row["repo"], existing, kind)
            latest = council_load()
            latest["sync"] = False
            council_save(latest)
            council_finish_analyze(load_registry(), latest)
        except Exception as exc:
            append_log(f"council: {exc}\n")
            failed = council_load()
            failed["status"] = "failed"
            failed["sync"] = False
            council_save(failed)

    threading.Thread(target=_run, daemon=True).start()


def tmux_kill_session(session: str) -> bool:
    if not have("tmux") or not tmux_has(session):
        return False
    run(["tmux", "kill-session", "-t", session], check=False)
    return True


def council_abort() -> dict:
    killed = []
    for role in COUNCIL_ROLES:
        session = council_session(role)
        if tmux_kill_session(session):
            killed.append(session)
    row = council_load()
    row["status"] = "aborted"
    row["pulse"] = "Цикл остановлен"
    council_save(row)
    record_event("council", row.get("project") or "", "остановлен")
    return {"ok": True, "aborted": True, "killed": killed, "council": row}


def council_start(
    reg: dict,
    project: str = "",
    *,
    now: float | None = None,
    launch=None,
    notify=None,
    kind_ok=None,
    tmux_on: dict[str, bool] | None = None,
) -> dict:
    kind_ok = kind_ok or kind_cli_ok
    if not kind_ok("grok") and not kind_ok("cursor"):
        die("нет Grok CLI (grok/agent)")
    data = load_workshop()
    if council_busy(data, tmux_on if tmux_on is not None else council_tmux_map()):
        die("цикл уже идёт")
    name = council_scope(reg, project)
    project_row = project_by_name(reg, name)
    repo = project_row.get("repo") or ""
    if not is_pinned(project_row) or not repo:
        die("выберите corp или clarity")
    seen = council_existing_titles(reg, repo)
    row = {
        "status": "analyze",
        "project": name,
        "repo": repo,
        "started_at": time.time() if now is None else now,
        "roles": {role: {"status": "running", "filed": []} for role in COUNCIL_ROLES},
        "filed": [],
        "seen_titles": seen,
        "sync": False,
        "pulse": "",
    }
    with workshop_lock():
        data = load_workshop()
        if council_busy(data, tmux_on if tmux_on is not None else council_tmux_map()):
            die("цикл уже идёт")
        data["council"] = row
        save_workshop(data)
    record_event("council", name, "старт")
    tg_show_cycle(tg_council_text(row), tg_cycle_buttons({"council": row}), notify=notify)
    (launch or council_launch_analyzers)(reg, row)
    return {"ok": True, "project": name, "repo": repo, "status": "analyze"}


def council_role_items(role: str) -> list[dict]:
    path = config_dir() / f"council-{role}.json"
    payload: list = []
    if path.is_file():
        payload = parse_json_array(path.read_text())
    if not payload and RUN_LOG.is_file():
        payload = parse_json_array(RUN_LOG.read_text()[-30000:])
    return [item for item in payload if isinstance(item, dict) and item.get("title")]


def council_enqueue_refs(reg: dict, refs: list[tuple[str, int]], enqueue=None, kind: str = "grok") -> tuple[list[str], list[str]]:
    enqueue = enqueue or (
        lambda repo, number: queue_add(reg, repo, number, kind, kind=kind)
    )
    added: list[str] = []
    errors: list[str] = []
    for repo, number in refs:
        try:
            enqueue(repo, number)
            added.append(issue_ref(repo, number))
        except CorpError as exc:
            errors.append(redact_secrets(str(exc)))
    return added, errors


def council_finish_analyze(
    reg: dict,
    row: dict,
    *,
    load_role_items=None,
    file_issue=None,
    enqueue=None,
    start_queue=None,
    notify=None,
) -> dict:
    load_role_items = load_role_items or council_role_items
    file_issue = file_issue or (
        lambda repo, title, body, role: create_issue_rest(
            repo, title, body, ["ready", COUNCIL_LABEL, COUNCIL_ROLE_LABEL[role]]
        )
    )
    filed: list[dict] = []
    seen = list(row.get("seen_titles") or [])
    for role in COUNCIL_ROLES:
        picked = council_pick_items(load_role_items(role), seen, COUNCIL_MAX_PER_ROLE)
        role_filed = []
        for item in picked:
            created = file_issue(row["repo"], item["title"], council_issue_body(item), role)
            number = int(created.get("number") or created.get("issue") or 0)
            if not number:
                continue
            rec = {
                "repo": row["repo"],
                "number": number,
                "role": role,
                "title": item["title"],
                "phase": "queue",
            }
            filed.append(rec)
            role_filed.append(number)
            seen.append(item["title"])
        row.setdefault("roles", {}).setdefault(role, {})["status"] = "done"
        row["roles"][role]["filed"] = role_filed
    row["filed"] = filed
    row["status"] = "queue" if filed else "done"
    row["pulse"] = tg_council_text(row)
    council_save(row)
    refs = [(item["repo"], item["number"]) for item in filed]
    added, errors = council_enqueue_refs(reg, refs, enqueue=enqueue, kind="grok")
    if filed:
        (start_queue or (lambda: queue_set_running(True)))()
    pulse = row["pulse"] + (f"\n{errors[0]}" if errors else "")
    tg_show_cycle(pulse, tg_cycle_buttons({"council": row}), notify=notify)
    record_event("council", row.get("project") or "", f"завели {len(added)}")
    return {"ok": True, "filed": filed, "added": added, "errors": errors, "status": row["status"]}


def council_tick(now: float | None = None) -> None:
    row = council_load()
    if (row.get("status") or "") != "analyze":
        return
    if row.get("sync"):
        return
    stamp = float(row.get("started_at") or 0)
    age = (time.time() if now is None else now) - stamp
    live = council_tmux_map()
    if any(live.values()):
        return
    if age < 8:
        return
    try:
        council_finish_analyze(load_registry(), row)
    except Exception as exc:
        append_log(f"council: {exc}\n")


def council_mark_phase(repo: str, number: int, phase: str) -> None:
    row = council_load()
    for item in row.get("filed") or []:
        if item.get("repo") == repo and int(item.get("number") or 0) == number:
            item["phase"] = phase
    row["pulse"] = tg_council_text(row)
    council_save(row)


def council_ff_merge_main(dest: Path, run_cmd=None) -> dict:
    run_cmd = run_cmd or (lambda cmd: run(cmd, cwd=dest, check=False))
    status = run_cmd(["git", "status", "--porcelain"])
    if (getattr(status, "stdout", "") or "").strip():
        return {"ok": False, "error": "dirty tree", "merged": False}
    run_cmd(["git", "fetch", "origin"])
    branch = (getattr(run_cmd(["git", "rev-parse", "--abbrev-ref", "HEAD"]), "stdout", "") or "").strip()
    if branch in {"", "HEAD"}:
        return {"ok": False, "error": "detached", "merged": False}
    if branch == "main":
        push = run_cmd(["git", "push", "origin", "main"])
        return {"ok": push.returncode == 0, "merged": False, "on_main": True}
    checkout = run_cmd(["git", "checkout", "main"])
    if checkout.returncode != 0:
        return {"ok": False, "error": "checkout main failed", "merged": False}
    merge = run_cmd(["git", "merge", "--ff-only", branch])
    if merge.returncode != 0:
        return {"ok": False, "error": "ff-only merge failed", "merged": False}
    push = run_cmd(["git", "push", "origin", "main"])
    return {"ok": push.returncode == 0, "merged": True, "branch": branch}


def council_deploy_trees(run_cmd=None, live: Path | None = None, writers: Path | None = None, restart: bool = True) -> dict:
    run_cmd = run_cmd or (lambda cmd, cwd=None: run(cmd, cwd=cwd, check=False))
    live = live or live_corp_path()
    writers = writers or writers_corp_path()
    rows = []
    for path in (live, writers):
        if not path.is_dir():
            rows.append({"path": str(path), "ok": False, "error": "missing"})
            continue
        run_cmd(["git", "fetch", "origin"], cwd=path)
        merge = run_cmd(["git", "merge", "--ff-only", "origin/main"], cwd=path)
        rows.append({"path": str(path), "ok": merge.returncode == 0})
    if restart and live.is_dir():
        run_cmd(["systemctl", "restart", "workshop"], cwd=None)
    return {"ok": all(row.get("ok") for row in rows if row.get("error") != "missing"), "trees": rows}


def council_after_writer(
    reg: dict,
    repo: str,
    number: int,
    dest: Path,
    *,
    review=None,
    merge=None,
    deploy=None,
    close=None,
    reject=None,
    notify=None,
) -> dict:
    council_mark_phase(repo, number, "review")
    diff_proc = run(["git", "diff", "origin/main"], cwd=dest, check=False)
    diff = (diff_proc.stdout or "") + "\n" + (diff_proc.stderr or "")
    if review is None:
        kind = council_writer_kind()
        prompt = council_review_prompt(repo, number, dest, diff)
        cmd = agent_argv(kind, prompt, dest)
        code = launch_agent(kind, cmd, dest, project_by_repo(reg, repo)["name"], prefix=f"council-qa {repo}#{number}")
        log_text = last_log_lines(40, prefix=f"council-qa {repo}#{number}")
        verdict = council_qa_verdict(log_text if code == 0 else f"VERDICT: FAIL exit {code}\n{log_text}")
    else:
        verdict = review(diff)
    note = "council QA"
    if verdict != "pass":
        council_mark_phase(repo, number, "fail")
        result = (reject or reject_qa)(reg, repo, number, "council QA не принял. Смотри diff vs origin/main.")
        tg_show_cycle(tg_council_text(council_load()), tg_cycle_buttons(), notify=notify)
        result["council_qa"] = "fail"
        return result
    closed = (close or (lambda: close_issue(reg, repo, number, force=True, note=note)))()
    merged = (merge or (lambda: council_ff_merge_main(dest)))()
    deployed = {"ok": False}
    if merged.get("ok"):
        deployed = (deploy or council_deploy_trees)()
    council_mark_phase(repo, number, "main" if merged.get("ok") else "fail")
    tg_show_cycle(tg_council_text(council_load()), tg_cycle_buttons(), notify=notify)
    closed = dict(closed or {})
    closed.update({"ok": bool(closed.get("ok") and merged.get("ok")), "council_qa": "pass", "merged": merged, "deployed": deployed})
    return closed


def tg_pending_reply() -> dict:
    row = load_workshop().get("tg_reply") or {}
    return dict(row) if isinstance(row, dict) else {}


def tg_set_pending(row: dict | None) -> None:
    with workshop_lock():
        data = load_workshop()
        if row:
            data["tg_reply"] = {
                "kind": row.get("kind") or "",
                "repo": row.get("repo") or "",
                "number": int(row.get("number") or 0),
            }
        else:
            data["tg_reply"] = {}
        save_workshop(data)


