[Unit]
Description=Corporation workshop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=corp
Group=corp
WorkingDirectory=/opt/corp/workshop
Environment=HOME=/home/corp
Environment=CORP_WORKSPACE=/home/corp/projects
ExecStart=/home/corp/.local/share/workshop-venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
