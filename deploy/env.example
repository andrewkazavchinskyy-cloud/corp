# Copy to ~/.config/corp/env on the VPS. Never commit the real file.

CORP_WORKSPACE=/home/corp/projects
# CORP_AGENT=claude

# Telegram bot from @BotFather. Chat id from @userinfobot or getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# corp#41: name of the separate OS identity writing agents run under, once
# provisioned with deploy/provision-agent-identity.sh. Unset = agents still
# run as this same OS user (control-plane secrets stripped from their env
# only -- see docs/AGENT_ISOLATION.md).
# CORP_AGENT_USER=corp-agent

# Cursor CLI (`agent`) adapter credential. Once CORP_AGENT_USER is set,
# move this to <agent home>/.config/corp-agent/env instead -- it belongs to
# the agent identity, not the control plane.
# CURSOR_API_KEY=
